diff --git a/api/server/services/agataCapabilities.js b/api/server/services/agataCapabilities.js
new file mode 100644
index 0000000..c0d4630
--- /dev/null
+++ b/api/server/services/agataCapabilities.js
@@ -0,0 +1,142 @@
+const {
+  createHash,
+  createPrivateKey,
+  sign,
+  randomUUID,
+} = require('crypto');
+const fs = require('fs');
+
+const MAX_TTL_SECONDS = 60;
+const MAX_PENDING_CAPABILITIES = 2048;
+const PRIVATE_KEY_FILE = process.env.AGATA_APPROVAL_PRIVATE_PEM_PATH || '/run/secrets/agata-approval-private.pem';
+const pending = new Map();
+
+// Exact aliases generated by LibreChat's MCP normalizer. Unknown aliases never
+// receive a capability. Read-only tools do not use this table.
+const PROTECTED = Object.freeze({
+  memoria_acrescentar_mcp_canon: { server: 'canon', audience: 'escriba', tool: 'memoria_acrescentar' },
+  diario_anotar_mcp_canon: { server: 'canon', audience: 'escriba', tool: 'diario_anotar' },
+  clicar_mcp_navegador: { server: 'navegador', tool: 'clicar' },
+  preencher_mcp_navegador: { server: 'navegador', tool: 'preencher' },
+  enviar_mensagem_mcp_discord: { server: 'discord', tool: 'enviar_mensagem' },
+});
+
+function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value).sort().map((k) => `${JSON.stringify(k)}:${canonical(value[k])}`).join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+
+function argsDigest(args) {
+  return createHash('sha256').update(canonical(args), 'utf8').digest('hex');
+}
+
+function privateKeyStatIsSecure(st, expectedGid) {
+  return st.isFile() && st.uid === 0 && st.nlink === 1 &&
+    st.gid === expectedGid && (st.mode & 0o777) === 0o440;
+}
+
+function readPrivateKey() {
+  const fd = fs.openSync(PRIVATE_KEY_FILE, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0));
+  try {
+    const st = fs.fstatSync(fd);
+    if (!privateKeyStatIsSecure(st, process.getgid())) {
+      throw new Error('insecure capability private key file');
+    }
+    const key = fs.readFileSync(fd);
+    if (key.length < 64 || key.length > 4096) throw new Error('invalid capability private key length');
+    return createPrivateKey(key);
+  } finally {
+    fs.closeSync(fd);
+  }
+}
+
+function callKey({ callId, userId, conversationId }) {
+  if (typeof callId !== 'string' || !callId || typeof userId !== 'string' || !userId ||
+      typeof conversationId !== 'string' || !conversationId) return null;
+  return `${userId}:${conversationId}:${callId}`;
+}
+
+function issue({ callId, alias, userId, conversationId, args, now = Math.floor(Date.now() / 1000) }) {
+  const target = PROTECTED[alias];
+  const key = callKey({ callId, userId, conversationId });
+  if (!target || !key) {
+    throw new Error('invalid protected tool approval');
+  }
+  for (const [id, entry] of pending) {
+    if (entry.exp <= now) pending.delete(id);
+  }
+  if (pending.size >= MAX_PENDING_CAPABILITIES && !pending.has(callId)) {
+    throw new Error('too many pending protected tool approvals');
+  }
+  const claims = {
+    iss: 'librechat-agata',
+    aud: target.audience || target.server,
+    tool: target.tool,
+    sub: userId,
+    conversation_id: conversationId,
+    args_sha256: argsDigest(args),
+    iat: now,
+    exp: now + MAX_TTL_SECONDS,
+    jti: randomUUID(),
+  };
+  const encoded = Buffer.from(canonical(claims), 'utf8').toString('base64url');
+  const signature = sign(null, Buffer.from(encoded, 'ascii'), readPrivateKey()).toString('base64url');
+  pending.set(key, { alias, target, token: `${encoded}.${signature}`, exp: claims.exp });
+  return claims;
+}
+
+function registerApprovedCalls(payload, resolutions, userId, conversationId, now) {
+  if (payload?.type !== 'tool_approval' || !Array.isArray(payload.action_requests) || !Array.isArray(resolutions)) return;
+  const byId = new Map(resolutions.map((r) => [r.tool_call_id, r]));
+  for (const request of payload.action_requests) {
+    const alias = request.name;
+    if (!PROTECTED[alias]) continue;
+    const key = callKey({ callId: request.tool_call_id, userId, conversationId });
+    if (!key) continue;
+    pending.delete(key);
+    const resolution = byId.get(request.tool_call_id);
+    if (!resolution || !['approve', 'edit'].includes(resolution.decision)) continue;
+    const args = resolution.decision === 'edit' ? resolution.editedArguments : request.arguments;
+    if (typeof args === 'string') {
+      try { issue({ callId: request.tool_call_id, alias, userId, conversationId, args: JSON.parse(args), now }); }
+      catch { pending.delete(key); }
+    } else if (args && typeof args === 'object' && !Array.isArray(args)) {
+      try { issue({ callId: request.tool_call_id, alias, userId, conversationId, args, now }); }
+      catch { pending.delete(key); }
+    }
+  }
+}
+
+function isProtectedMCPTool(serverName, toolName) {
+  return Object.values(PROTECTED).some((entry) => entry.server === serverName && entry.tool === toolName);
+}
+
+function takeCapabilityForCall({ callId, alias, serverName, toolName, args, userId, conversationId }) {
+  const key = callKey({ callId, userId, conversationId });
+  if (!key) return null;
+  const entry = pending.get(key);
+  pending.delete(key);
+  if (!entry || entry.alias !== alias || entry.target.server !== serverName || entry.target.tool !== toolName) return null;
+  if (entry.exp <= Math.floor(Date.now() / 1000)) return null;
+  // Reissue against the exact arguments the executor will receive. A changed
+  // or model-regenerated call cannot inherit the earlier approval.
+  const claims = JSON.parse(Buffer.from(entry.token.split('.')[0], 'base64url').toString('utf8'));
+  if (claims.args_sha256 !== argsDigest(args)) return null;
+  if (claims.sub !== userId || claims.conversation_id !== conversationId) return null;
+  return entry.token;
+}
+
+module.exports = {
+  MAX_TTL_SECONDS,
+  PROTECTED,
+  argsDigest,
+  callKey,
+  canonical,
+  privateKeyStatIsSecure,
+  isProtectedMCPTool,
+  registerApprovedCalls,
+  takeCapabilityForCall,
+};
diff --git a/api/server/services/agataCapabilities.test.js b/api/server/services/agataCapabilities.test.js
new file mode 100644
index 0000000..cce59dc
--- /dev/null
+++ b/api/server/services/agataCapabilities.test.js
@@ -0,0 +1,100 @@
+const assert = require('node:assert/strict');
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'agata-cap-'));
+const keyFile = path.join(dir, 'private.pem');
+const privateKey = crypto.generateKeyPairSync('ed25519');
+fs.writeFileSync(keyFile, privateKey.privateKey.export({ type: 'pkcs8', format: 'pem' }), { mode: 0o440 });
+process.env.AGATA_APPROVAL_PRIVATE_PEM_PATH = keyFile;
+// Model the deployment's root-owned bind-mounted secret while running offline
+// as an unprivileged test user; ownership validation itself is tested below.
+const realFstat = fs.fstatSync;
+fs.fstatSync = (...args) => {
+  const st = realFstat(...args);
+  return new Proxy(st, { get(target, key) { return key === 'uid' ? 0 : Reflect.get(target, key, target); } });
+};
+const caps = require('./agataCapabilities');
+
+test.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+test('argument digest matches the Python executor canonical JSON', () => {
+  assert.equal(
+    caps.argsDigest({ canal_id: '123', texto: 'ok' }),
+    'd31118bd3c5d68c9c21e0de697254d2c93f3677f4e1c58f7b3daef3c30fea813',
+  );
+});
+
+test('private signing key must be a root-owned 0440 single-link regular file', () => {
+  const secure = { isFile: () => true, uid: 0, gid: process.getgid(), nlink: 1, mode: 0o100440 };
+  assert.equal(caps.privateKeyStatIsSecure(secure, process.getgid()), true);
+  assert.equal(caps.privateKeyStatIsSecure({ ...secure, uid: process.getuid() }, process.getgid()), false);
+  assert.equal(caps.privateKeyStatIsSecure({ ...secure, mode: 0o100640 }, process.getgid()), false);
+});
+
+test('only an approved, exact MCP call receives a one-use capability', () => {
+  const payload = {
+    type: 'tool_approval',
+    action_requests: [{ name: 'enviar_mensagem_mcp_discord', tool_call_id: 'c1', arguments: { canal_id: '123', texto: 'ok' } }],
+  };
+  caps.registerApprovedCalls(payload, [{ tool_call_id: 'c1', decision: 'approve' }], 'user-1', 'convo-1');
+  const token = caps.takeCapabilityForCall({
+    callId: 'c1', userId: 'user-1', conversationId: 'convo-1', alias: 'enviar_mensagem_mcp_discord', serverName: 'discord',
+    toolName: 'enviar_mensagem', args: { canal_id: '123', texto: 'ok' },
+  });
+  assert.match(token, /^[^.]+\.[A-Za-z0-9_-]{86}$/);
+  assert.equal(caps.takeCapabilityForCall({
+    callId: 'c1', userId: 'user-1', conversationId: 'convo-1', alias: 'enviar_mensagem_mcp_discord', serverName: 'discord',
+    toolName: 'enviar_mensagem', args: { canal_id: '123', texto: 'ok' },
+  }), null);
+});
+
+test('rejects unapproved calls, argument edits, and unknown aliases', () => {
+  const payload = {
+    type: 'tool_approval',
+    action_requests: [{ name: 'clicar_mcp_navegador', tool_call_id: 'c2', arguments: { descricao: 'Enviar' } }],
+  };
+  caps.registerApprovedCalls(payload, [{ tool_call_id: 'c2', decision: 'reject' }], 'user-1', 'convo-1');
+  assert.equal(caps.takeCapabilityForCall({
+    callId: 'c2', userId: 'user-1', conversationId: 'convo-1', alias: 'clicar_mcp_navegador', serverName: 'navegador', toolName: 'clicar', args: { descricao: 'Enviar' },
+  }), null);
+  caps.registerApprovedCalls(payload, [{ tool_call_id: 'c2', decision: 'approve' }], 'user-1', 'convo-1');
+  assert.equal(caps.takeCapabilityForCall({
+    callId: 'c2', userId: 'user-1', conversationId: 'convo-1', alias: 'clicar_mcp_navegador', serverName: 'navegador', toolName: 'clicar', args: { descricao: 'Excluir' },
+  }), null);
+  caps.registerApprovedCalls({ ...payload, action_requests: [{ ...payload.action_requests[0], name: 'unexpected_tool' }] },
+    [{ tool_call_id: 'c3', decision: 'approve' }], 'user-1', 'convo-1');
+  assert.equal(caps.takeCapabilityForCall({
+    callId: 'c3', userId: 'user-1', conversationId: 'convo-1', alias: 'unexpected_tool', serverName: 'navegador', toolName: 'clicar', args: { descricao: 'Enviar' },
+  }), null);
+});
+
+test('edited arguments are bound to the approved edit', () => {
+  const payload = {
+    type: 'tool_approval',
+    action_requests: [{ name: 'diario_anotar_mcp_canon', tool_call_id: 'c4', arguments: { texto: 'rascunho' } }],
+  };
+  caps.registerApprovedCalls(payload, [{ tool_call_id: 'c4', decision: 'edit', editedArguments: { texto: 'texto revisado' } }], 'user-1', 'convo-1');
+  assert.match(caps.takeCapabilityForCall({
+    callId: 'c4', userId: 'user-1', conversationId: 'convo-1', alias: 'diario_anotar_mcp_canon', serverName: 'canon', toolName: 'diario_anotar', args: { texto: 'texto revisado' },
+  }), /^[^.]+\.[A-Za-z0-9_-]{86}$/);
+});
+
+test('approval identity includes user and conversation when call ids collide', () => {
+  const payload = {
+    type: 'tool_approval',
+    action_requests: [{ name: 'diario_anotar_mcp_canon', tool_call_id: 'same-id', arguments: { texto: 'ok' } }],
+  };
+  caps.registerApprovedCalls(payload, [{ tool_call_id: 'same-id', decision: 'approve' }], 'user-1', 'convo-1');
+  assert.equal(caps.takeCapabilityForCall({
+    callId: 'same-id', userId: 'user-1', conversationId: 'convo-2',
+    alias: 'diario_anotar_mcp_canon', serverName: 'canon', toolName: 'diario_anotar', args: { texto: 'ok' },
+  }), null);
+  assert.match(caps.takeCapabilityForCall({
+    callId: 'same-id', userId: 'user-1', conversationId: 'convo-1',
+    alias: 'diario_anotar_mcp_canon', serverName: 'canon', toolName: 'diario_anotar', args: { texto: 'ok' },
+  }), /^[^.]+\.[A-Za-z0-9_-]{86}$/);
+});
