# Modelo (env.exemplo) do ~/librechat/.env -- os segredos REAIS ficam so em ~/librechat/.env (chmod 600, fora do git).
# Gere com: openssl rand -hex 32  (CREDS_KEY/JWT*), openssl rand -hex 16 (CREDS_IV), openssl rand -hex 24 (MEILI)
HOST=127.0.0.1
PORT=3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
DOMAIN_CLIENT=http://127.0.0.1:3080
DOMAIN_SERVER=http://127.0.0.1:3080
NO_INDEX=true
#TRUST_PROXY=1                 # ligar quando for pelo Tailscale serve
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
CREDS_KEY=<64 hex>
CREDS_IV=<32 hex>
JWT_SECRET=<64 hex>
JWT_REFRESH_SECRET=<64 hex>
SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=<48 hex>
ENDPOINTS=custom
RAG_API_URL=
CONFIG_PATH=/app/librechat.yaml
