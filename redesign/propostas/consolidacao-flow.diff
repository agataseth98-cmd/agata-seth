# PROPOSTA P-8 -- NAO APLICADA (aplicada no branch sob regime de excecao, 03/09)
# arquivo alvo:  config/agata-consolidacao.service
# nome:          consolidacao-flow
# aprova com:    redesign/propostas/APROVADO-consolidacao-flow  (o Humano cria)
# depende de:    redesign/grafo/flows/consolidacao.py (P6-03) + redesign/grafo/.venv
#
# Otimizacao C2 (P8-05): a consolidacao noturna deixa de chamar o Hermes e passa
# a rodar o flow do grafo (LangGraph, saida so em propostas/, nunca canon). Tira
# a ultima amarra do Hermes-executor. O `hermes chat` antigo ja estava quebrado
# (journal 03/09 07:06: "ferramentas read_file/terminal falhando -- sem diretorio
# temporario no ambiente do Hermes").
#
# ReadWritePaths: era `propostas .hermes` -> agora `propostas .cache/agata`
# (o flow escreve o checkpoint/WAL em ~/.cache/agata/; nao toca mais ~/.hermes).
# Testado na Maquina 03/09: com o RW path corrigido, o service roda sob
# ProtectSystem=strict / ProtectHome=read-only e escreve so onde deve.
diff --git a/config/agata-consolidacao.service b/config/agata-consolidacao.service
index 75127d6..e16e6ca 100644
--- a/config/agata-consolidacao.service
+++ b/config/agata-consolidacao.service
@@ -4,9 +4,13 @@ Description=Ágata — consolidação noturna (memória → proposta em proposta
 [Service]
 Type=oneshot
 WorkingDirectory=%h/agata
-ExecStart=/bin/bash -c '/home/orusoua/.local/bin/hermes chat -q "$(cat /home/orusoua/agata/config/agata-consolidacao.prompt.txt)" --cli -Q --source cron'
+# C2 (redesenho, Fase 8): era `hermes chat` -- agora o flow do grafo (P6-03).
+# Saida so em propostas/consolidacao-<data>.md; nunca toca canon.
+ExecStart=%h/agata/redesign/grafo/.venv/bin/python %h/agata/redesign/grafo/flows/consolidacao.py --repo %h/agata
 ProtectSystem=strict
 ProtectHome=read-only
-ReadWritePaths=%h/agata/propostas %h/.hermes
+# C2: o flow do grafo escreve a proposta em propostas/ e o checkpoint/estado em
+# ~/.cache/agata/ (SqliteSaver + WAL). Nao toca mais ~/.hermes.
+ReadWritePaths=%h/agata/propostas %h/.cache/agata
 Restart=on-failure
 RestartSec=30
