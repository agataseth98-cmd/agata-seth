{
  "manifest_version": 3,
  "name": "Agata — Conselho em Rede",
  "version": "0.7.0",
  "description": "Executa envios aprovados pelo Humano via APIs oficiais do OmniRoute.",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:20146/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Conselho em Rede · Agata"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
