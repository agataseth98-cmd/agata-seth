[Unit]
Description=OmniRoute AI gateway (Agata, Fase 1 -- P1-00)
Documentation=https://github.com/pitbaden/omniroute
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CONFERIR o caminho real do binário depois do install:
#   set -p  (ou)  type -p omniroute        -> normalmente ~/.npm-global/bin/omniroute
ExecStart=%h/.npm-global/bin/omniroute
# CONFERIR o subcomando na doc: pode ser `omniroute`, `omniroute serve`, `omniroute start`.
# Se for subcomando: ExecStart=%h/.npm-global/bin/omniroute serve
Restart=on-failure
RestartSec=3
# porta: confirmar o nome da env var na doc (ilustrativo abaixo)
Environment=OMNIROUTE_PORT=20128
Environment=OMNIROUTE_HOST=127.0.0.1
# nao deixar abrir navegador nem telemetria em servico headless (confirmar as flags reais):
Environment=NO_BROWSER=1
Environment=CI=1

[Install]
WantedBy=default.target
