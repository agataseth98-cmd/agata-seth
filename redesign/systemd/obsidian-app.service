[Unit]
Description=Obsidian.app (Fase 7-adjacente) -- backend real da API REST/MCP que o proxy obsidian-ro-proxy (:27125) usa, e que a Seth le via query_canon
Documentation=file:///home/orusoua/agata/redesign/obsidian/ro_proxy.py
After=graphical-session.target
# PartOf (MEMÓRIAS (523)): sem isto `seth-parar` (que para agata.target) deixava o
# Obsidian de pé -- contra a ordem de 10/09/2026, "parar Seth parando tudo".
PartOf=agata.target
# SEM Wants=graphical-session.target (MEMÓRIAS (536), 24/09/2026): com linger, agata.target
# sobe no boot e o Wants ATIVAVA graphical-session.target antes de qualquer login; o uwsm
# entao recusava abrir o Hyprland ("A compositor or graphical-session* target is already
# active!"). A espera pela tela ja e feita pelo ExecStartPre abaixo; o After= fica so
# como ordenacao (nao puxa o target).

[Service]
Type=simple
Environment=DISPLAY=:0
# Espera o display existir antes de abrir o app (achado 23/09/2026, MEMÓRIAS (518)):
# agata.target sobe no boot, antes do login grafico; sem isto o Obsidian caia com
# status=139 (sem socket X11) em loop -- 85+ reinicios ate o Humano entrar na sessao.
# Espera sem prazo (o login pode demorar horas) e sem gastar reinicio.
# Corrigido em MEMÓRIAS (538): o socket X0 sozinho nao basta -- quem o cria no boot e o X
# da tela de login (LightDM), e o Obsidian caia 22x com SIGSEGV ate o login. Agora espera
# o logind declarar uma sessao grafica DO USUARIO (show-user -p Display: vazio ate o login;
# a do greeter e do usuario lightdm) e, depois, o socket.
ExecStartPre=/bin/sh -c 'until [ -n "$(loginctl show-user "$(id -un)" -p Display --value 2>/dev/null)" ] && [ -S /tmp/.X11-unix/X0 ]; do sleep 2; done'
TimeoutStartSec=infinity
# O app roda no escopo PROPRIO do Flatpak (app-flatpak-*.scope), fora deste servico:
# parar o servico nao o fecha. Antes de (536) ele morria "de carona" -- o escopo e
# PartOf=graphical-session.target, que este servico puxava. Sem isso (MEMÓRIAS (539)):
# - ExecStartPre fecha instancia antiga, senao o `flatpak run` entrega a vez a ela,
#   sai com 0 e o servico fica inactive sem ser dono do app;
# - ExecStop fecha o app de fato (`seth-parar` -> agata.target -> PartOf).
ExecStartPre=-/usr/bin/flatpak kill md.obsidian.Obsidian
ExecStart=/usr/bin/flatpak run md.obsidian.Obsidian
ExecStop=/usr/bin/flatpak kill md.obsidian.Obsidian
Restart=on-failure
RestartSec=5
# A API REST do Obsidian (plugin "Local REST API with MCP") so existe enquanto
# o app roda -- achado em 20/09/2026: obsidian-ro-proxy (:27125) fica de pe
# sozinho, mas devolve 403 "upstream inacessivel" (nao 502/503) quando o app
# esta fechado, o que uma leitura rapida confunde com permissao negada. Este
# servico fecha essa classe de falha, subindo o app junto com a sessao grafica.

[Install]
WantedBy=agata.target
