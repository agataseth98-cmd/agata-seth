#!/usr/bin/env bash
# Para os frentes da Seth e libera recursos. Mantem a espinha (agata.target).
# Fonte versionada: ~/agata/redesign/systemd/seth-parar
LC=~/librechat/docker-compose.yml
docker compose -f "$LC" stop >/dev/null 2>&1 || true
docker stop kokoro-tts >/dev/null 2>&1 || true
systemctl --user stop seth-gateway.service 2>/dev/null || true
notify-send -a Seth "Seth" "frentes parados (espinha segue de pe)" 2>/dev/null || true
