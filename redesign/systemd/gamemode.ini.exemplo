# ~/.config/gamemode.ini  -- precisa: sudo pacman -S gamemode
# Ao lancar um jogo com `gamemoderun <jogo>`, o GameMode roda `start=` (libera a 4060);
# ao fechar, roda `end=` (retoma). `agata down` drena o WAL antes de cortar (P4-04).
[general]
renice=10

[custom]
start=/home/orusoua/agata/redesign/grafo/.venv/bin/python /home/orusoua/agata/redesign/grafo/cli.py down
end=/home/orusoua/agata/redesign/grafo/.venv/bin/python /home/orusoua/agata/redesign/grafo/cli.py up
