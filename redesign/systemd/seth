#!/usr/bin/env bash
# Liga a Seth (atalho "Seth"). Sobe a espinha inteira (agata.target), o gateway, o LibreChat,
# a voz, o painel, o Obsidian e as vigias da Equipe. Depois abre o navegador do sistema
# (Chromium, perfil "Sistema Agata") só com as abas que faltam.
# Contraparte: `seth-parar`, que desliga tudo. O MoE :20129 continua sob demanda.
# Fonte versionada: ~/agata/redesign/systemd/seth
set -e
LC=~/librechat/docker-compose.yml
DIARIO=~/.cache/agata/sincronia/eventos.log
mkdir -p "$(dirname "$DIARIO")" 2>/dev/null || true
echo "$(TZ=America/Sao_Paulo date +%H:%M) SETH subindo (atalho seth)" >> "$DIARIO" 2>/dev/null || true
notify-send -a Seth "Seth" "subindo..." 2>/dev/null || true
systemctl --user start agata.target 2>/dev/null || true
systemctl --user start seth-gateway.service seth-escriba.service seth-verificador.service
systemctl --user start painel-operacional.service 2>/dev/null || true
# Obsidian não sobe aqui: abre pelo painel, quando você pedir.
# Skills novas (05/09/2026) -- MCP sob demanda: ponte Discord (:20135) e
# navegador Playwright+Brave (:20136). Sobem junto pra estarem no ar quando o
# LibreChat tentar se conectar; startup:false no librechat.yaml quer dizer que
# o LibreChat nao falha se elas ainda nao responderam, so tenta de novo depois.
systemctl --user start discord-mcp.service navegador-mcp.service 2>/dev/null || true
# Voz: Piper pt-BR (shim OpenAI-compat :8890, MEMÓRIAS (387)). Kokoro (:8880)
# fica de pe pra ingles -- ver comentario no librechat.yaml.
systemctl --user start piper-tts.service 2>/dev/null || true
# Vigias da Equipe (Claude e Codex): sobem com a Seth e param com ela.
systemctl --user start agata-vigia@claude.service agata-vigia@codex.service 2>/dev/null || true
# Deploy da config versionada -> ~/librechat/ (H5, MEMÓRIAS (401)). Antes era
# cp manual: editar redesign/librechat/ e esquecer o cp deixava o LibreChat
# rodando a versao velha (achado em (389)/(392)). Agora o atalho sincroniza e
# so reinicia o container se algo mudou.
_lc_changed=0
# docker-compose.yml entrou na lista em (532): antes o atalho sincronizava o
# librechat.yaml mas NÃO o compose -- os dois podiam divergir (yaml falando com
# 172.29.7.1, compose ainda em modo host), exatamente a quebra de (517). Os dois
# andam juntos agora. `compose up -d` abaixo aplica a mudança de compose sozinho.
for _pair in "librechat.yaml|$HOME/librechat/librechat.yaml" \
             "docker-compose.yml|$HOME/librechat/docker-compose.yml" \
             "canon-mcp.mjs|$HOME/librechat/data/mcp/canon-mcp.mjs" \
             "agata-tema.css|$HOME/librechat/agata-tema.css"; do
  # agata-tema.css entrou em (680): o compose monta o tema da Agata, mas o atalho
  # não o copiava -- tema editado no repo ficaria velho no LibreChat sem aviso.
  _src=~/agata/redesign/librechat/"${_pair%%|*}"; _dst="${_pair#*|}"
  if [ -f "$_src" ] && ! cmp -s "$_src" "$_dst"; then
    mkdir -p "$(dirname "$_dst")" && cp "$_src" "$_dst" && _lc_changed=1
    echo "deploy: $_dst sincronizado da fonte versionada"
  fi
done
docker compose -f "$LC" up -d >/dev/null 2>&1 || true
[ "$_lc_changed" = 1 ] && docker restart librechat >/dev/null 2>&1 || true
# espera o LibreChat responder (ate ~60s -- o primeiro boot e o mais lento)
for i in $(seq 1 30); do
  curl -sf -o /dev/null --max-time 2 http://127.0.0.1:3080/health && break || sleep 2
done
# Navegador do sistema: Chromium, perfil "Sistema Agata" (Profile 1 do Chromium).
# Se ele já estiver aberto, só entram as abas que faltam (nada duplicado).
# Ao abrir do zero, o Chromium volta com as abas da última vez (Continuar de onde parou).
AGATA_NAVEGADOR=${AGATA_NAVEGADOR:-chromium}
AGATA_PERFIL="Profile 1"
PAINEL=http://127.0.0.1:20146
_chromium_aberto() {
  local _l _p
  _l=$(readlink "$HOME/.config/chromium/SingletonLock" 2>/dev/null) || return 1
  _p=${_l##*-}
  [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null
}
# Modo programa: o painel abre como janela de aplicativo (sem barra de endereço).
# As janelas dos modelos e o LibreChat não abrem aqui: abrem pelo painel, quando você clica.
if ! _chromium_aberto; then
  setsid "$AGATA_NAVEGADOR" --profile-directory="$AGATA_PERFIL" --no-first-run --app="$PAINEL/prototipo" >/dev/null 2>&1 &
  # Dá tempo para a janela do painel aparecer e para a extensão do Conselho avisar o painel.
  sleep 25
fi
notify-send -a Seth "Seth" "pronta: painel do Agata aberto" 2>/dev/null || true
