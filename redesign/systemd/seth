#!/usr/bin/env bash
# Inicia a Seth para CONVERSA (Open WebUI). Sobe o que precisa, abre o navegador.
set -e
notify-send -a Seth "Seth" "subindo…" 2>/dev/null || true
systemctl --user start agata.target 2>/dev/null || true
systemctl --user start seth-gateway.service
docker start open-webui kokoro-tts >/dev/null 2>&1 || true
# espera o OWUI responder (ate ~40s)
for i in $(seq 1 20); do
  curl -sf -o /dev/null --max-time 2 http://127.0.0.1:8080/health && break || sleep 2
done
xdg-open "http://127.0.0.1:8080" >/dev/null 2>&1 &
