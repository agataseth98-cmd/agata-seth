[Unit]
Description=Agata -- todos os servicos locais (Fase 7, P7-01)
Documentation=file:///home/orusoua/agata/redesign/systemd/README.md
# Sem Requires/Wants aqui: os membros se ligam pelo [Install] WantedBy=agata.target
# (systemctl --user enable <unit>). PartOf nos membros propaga stop/restart do target.

[Install]
WantedBy=default.target
