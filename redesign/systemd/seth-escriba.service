[Unit]
Description=Agata -- seth_escriba: canal de escrita APPEND-ONLY da Seth (:20140)
Documentation=file:///home/orusoua/agata/redesign/router/seth_escriba.py
# Sob demanda -- sem [Install]. Sobe pelo atalho "Seth" junto do seth-gateway.
# Nao e' membro do agata.target (nao e' espinha; e' um canal da frente).

[Service]
Type=simple
Environment=SETH_ESCRIBA_BIND=127.0.0.1:20140
Environment=SETH_REPO=%h/agata
Environment=SETH_ESCRIBA_TZ=America/Sao_Paulo
ExecStart=/usr/bin/python3 %h/agata/redesign/router/seth_escriba.py
Restart=on-failure
RestartSec=3
Nice=5
# Baseline de hardening (item 6 do plano de mitigação da auditoria do
# Marcos, MEMÓRIAS (437)) -- ANTES deste conserto, este serviço (o ÚNICO
# canal de escrita da Seth) não tinha NENHUMA diretiva de hardening,
# menos que o seth-verificador (só leitura) -- achado invertido do que o
# risco pediria, confirmado na auditoria. Escreve só em MEMÓRIAS.md e
# SETH-DIARIO.md do repo (a trava de verdade é a aplicação: fcntl.flock +
# verificação pós-escrita, insert/append puro) -- ReadWritePaths cobre o
# repositório inteiro porque a escrita atômica (os.replace) e o lock
# precisam do diretório, não só dos dois arquivos.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=%h/agata
