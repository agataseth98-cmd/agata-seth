[Unit]
Description=Agata -- seth_gateway: reidrata a Seth antes do OmniRoute (:20126)
After=omniroute-sanitizer.service
Requires=omniroute-sanitizer.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/agata/redesign/router/seth_gateway.py
Environment=SETH_HIDRATA_MODO=compacto
# Rota pela cota por minuto do tier 0 (02/10/2026): 0 = desligada. Só trocar
# para 1 DEPOIS de `python3 scripts/combos_sem_cota.py --aplicar` criar os
# combos -sg no OmniRoute -- sem eles, ligar quebra a Seth (404).
Environment=SETH_ROTA_COTA=0
# Taxa chars/token do esquema das ferramentas no estimador da cota (03/10/2026).
# Sem esta linha = a mesma do texto (3.0). Valor decidido pela medição isolada no
# Groq (mesma conversa com e sem tools, as duas atendidas por ele) -- MEMÓRIAS (646).
#Environment=SETH_CHARS_POR_TOKEN_TOOLS=
Restart=on-failure
RestartSec=3
# Baseline de hardening (item 6 do plano de mitigação da auditoria do
# Marcos, MEMÓRIAS (437)) -- ANTES deste conserto, este serviço (vê TODO o
# tráfego da Seth, hidrata, roteia) não tinha NENHUMA diretiva de
# hardening -- o mais exposto dos serviços da Seth era também o menos
# isolado. Só lê REGRAS/PROJETO/MEMÓRIAS pra hidratar e responde por
# socket -- confirmado por grep antes de aplicar, zero escrita em disco.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadOnlyPaths=%h/agata

# Sem [Install] -- sobe sob demanda (o atalho da Seth faz `systemctl --user start
# seth-gateway`), nao no boot. Mesma logica do llamacpp-agata / agata-warmup.
