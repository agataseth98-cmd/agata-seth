#!/usr/bin/env bash
# Regenera .hermes.md se REGRAS.md, PROJETO.md ou DIÁRIO.md mudaram, e inclui no commit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only -z | grep -zqE '^(REGRAS\.md|PROJETO\.md|DIÁRIO\.md)$'; then
  bash .githooks/gerar-hermes-md.sh
  git add .hermes.md
fi
