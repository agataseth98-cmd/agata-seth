#!/usr/bin/env bash
# 1. Roda o perimetro (scripts/perimetro.sh, 10 controles P-1..P-10, MEMÓRIAS (191)/(192))
#    e bloqueia o commit se algum falhar de verdade.
# 2. Reescreve a âncora de SHA em PROMPT_CARREGAMENTO.md/REGRAS.md/PROJETO.md/MEMÓRIAS.md.
# 3. Regenera .hidrata.md e INDICE_MEMORIAS.md se REGRAS.md, PROJETO.md ou
#    MEMÓRIAS.md mudaram (passo 2 conta -- ver nota abaixo), e inclui os dois no commit.
#
# ORDEM IMPORTA (achado auditando um carregamento real da Seth, 19/09/2026):
# o passo 3 tem que rodar DEPOIS do passo 2. A âncora de SHA muda REGRAS/PROJETO/
# MEMÓRIAS.md em TODO commit (é o ponteiro pro "HEAD anterior", sempre anda). Se o
# passo 3 checar o staged ANTES da âncora rodar, ele só vê o que o autor deu `git add`
# à mão -- nunca a mudança que a própria âncora acabou de fazer -- e `.hidrata.md`
# (o que a Seth de fato recebe) fica congelado até alguém editar REGRAS/PROJETO/
# MEMÓRIAS.md com as próprias mãos de novo. Rodou 17h atrasado sem nenhum commit
# falhar: `IDADE-HIDRATACAO` (scripts/estado_para_eco.sh) é o sinal que pegou isso,
# não o perimetro -- não era um dos 10 controles P-1..P-10 de então.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! bash scripts/perimetro.sh; then
  echo "pre-commit: perimetro.sh falhou -- commit bloqueado. Veja a saída acima." >&2
  exit 1
fi

# Âncora de SHA em PROMPT_CARREGAMENTO.md (item 2, 20/08/2026, ordem do
# Humano). Sempre o SHA do HEAD ANTES deste commit -- um commit não pode
# embutir o próprio SHA (auto-referência), então fica até 1 commit
# atrasado, nunca mais, e isso está documentado no próprio arquivo.
# Falha aqui só avisa, nunca bloqueia o commit -- não é um controle de
# segurança, é conveniência pra sessões só-HTTP.
if [ -f PROMPT_CARREGAMENTO.md ]; then
  HEAD_ANTERIOR=$(git rev-parse HEAD 2>/dev/null || echo "")
  if [ -n "$HEAD_ANTERIOR" ]; then
    AGORA=$(date '+%d/%m/%Y %H:%M %z' | sed -E 's/([+-][0-9]{2})00$/\1/')
    if python3 scripts/atualizar_ancora_prompt.py PROMPT_CARREGAMENTO.md "$HEAD_ANTERIOR" "$AGORA"; then
      git add PROMPT_CARREGAMENTO.md
    else
      echo "pre-commit: AVISO -- não consegui atualizar a âncora de SHA em PROMPT_CARREGAMENTO.md" >&2
      echo "$(date -Iseconds) PROMPT_CARREGAMENTO.md $HEAD_ANTERIOR" >> "$(git rev-parse --git-dir)/AGATA_ANCORA_AVISOS.log"
    fi
    # Âncora de SHA também no PREÂMBULO de REGRAS/PROJETO/MEMÓRIAS (MEMÓRIAS
    # (378), resolução do B5): um leitor offline compara o SHA entre os três
    # -- divergiu, a cópia veio de commits diferentes (canal serviu um velho
    # e um novo). O bloco fica ACIMA do marcador ENTRADAS-NOVAS em MEMÓRIAS.md,
    # que o P-5 não policia (só o corpo de entradas). Mesma regra fail-soft.
    #
    # Guarda de integridade (achado real, MEMÓRIAS (458)): o `git add "$_canon"`
    # abaixo estagia o ARQUIVO INTEIRO, não só as linhas da âncora -- se houver
    # edição pendente sem stage nesse arquivo (ex: uma proposta ainda não
    # assinada, deixada na árvore de trabalho), ela entra no commit sem o
    # autor ter mandado `git add` nela. Não dá pra virar controle de
    # perimetro.sh (P-N): perimetro.sh já rodou e passou, linha 9 acima,
    # ANTES deste laço -- um controle lá nunca veria a varredura acontecer.
    # Por isso mora aqui: snapshot do STAGED (index) de cada canônico, SEM o
    # bloco da âncora, antes do laço; comparado depois. Qualquer diferença
    # fora da âncora só pode ter vindo do `git add` do laço, nunca de um
    # `git add` explícito do autor -- bloqueia o commit, desfaz o stage
    # indevido, e diz exatamente o que fazer.
    _sem_ancora() {
      awk '/<!-- ANCORA-SHA:INICIO/{s=1} !s{print} /<!-- ANCORA-SHA:FIM -->/{s=0}'
    }
    declare -A _ANCORA_ANTES
    for _canon in REGRAS.md PROJETO.md MEMÓRIAS.md; do
      [ -f "$_canon" ] || continue
      _ANCORA_ANTES["$_canon"]="$(git show ":$_canon" 2>/dev/null | _sem_ancora | sha256sum)"
    done

    for _canon in REGRAS.md PROJETO.md MEMÓRIAS.md; do
      [ -f "$_canon" ] || continue
      if python3 scripts/atualizar_ancora_prompt.py "$_canon" "$HEAD_ANTERIOR" "$AGORA"; then
        git add "$_canon"
      else
        echo "pre-commit: AVISO -- não consegui atualizar a âncora de SHA em $_canon" >&2
        echo "$(date -Iseconds) $_canon $HEAD_ANTERIOR" >> "$(git rev-parse --git-dir)/AGATA_ANCORA_AVISOS.log"
      fi
    done

    for _canon in REGRAS.md PROJETO.md MEMÓRIAS.md; do
      [ -f "$_canon" ] || continue
      [ -n "${_ANCORA_ANTES[$_canon]:-}" ] || continue
      _ancora_depois="$(git show ":$_canon" 2>/dev/null | _sem_ancora | sha256sum)"
      if [ "$_ancora_depois" != "${_ANCORA_ANTES[$_canon]}" ]; then
        git reset -q -- "$_canon" 2>/dev/null || true
        echo "pre-commit: FALHA -- '$_canon' staged ganhou conteúdo fora da âncora de SHA que você não tinha mandado 'git add' -- provavelmente uma edição pendente na árvore de trabalho (proposta ainda não assinada?) foi varrida pelo passo da âncora." >&2
        echo "pre-commit: desfiz o stage de '$_canon'. Rode 'git diff -- \"$_canon\"' pra ver o que sobrou pendente, decida se entra (stage explícito) ou fica de fora, e commite de novo." >&2
        exit 1
      fi
    done
  fi
fi

# Regenera .hidrata.md/INDICE_MEMORIAS.md se REGRAS/PROJETO/MEMÓRIAS.md mudaram
# NESTE commit -- checado AQUI, depois da âncora acima, de propósito (ver nota
# no topo do arquivo): a âncora muda os três em todo commit, e isso TEM que
# contar como "mudou" pra .hidrata.md não ficar defasado sem nenhum commit falhar.
if git diff --cached --name-only -z | grep -zqE '^(REGRAS\.md|PROJETO\.md|MEMÓRIAS\.md)$'; then
  bash .githooks/gerar-hidratacao.sh
  # INDICE_MEMORIAS_PALAVRAS-CHAVE.md ficava de fora deste `git add` --
  # gerar-hidratacao.sh regenera os três, mas só os dois primeiros entravam
  # no commit; o terceiro (rastreado no git) sobrava como modificação não
  # comitada depois de todo commit que tocasse REGRAS/PROJETO/MEMÓRIAS.
  # Achado auditando junto de MEMÓRIAS (271); adicionado se o arquivo
  # existir (geração é fail-soft, ver comentário em gerar-hidratacao.sh).
  git add .hidrata.md INDICE_MEMORIAS.md
  [ -f INDICE_MEMORIAS_PALAVRAS-CHAVE.md ] && git add INDICE_MEMORIAS_PALAVRAS-CHAVE.md
fi
