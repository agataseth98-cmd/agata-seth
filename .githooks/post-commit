#!/usr/bin/env bash
# A cada commit: regenera o bundle --all num staging local (sempre — não
# depende do HD) E, se o HD externo AgataBkup01 estiver montado agora,
# escreve uma cópia versionada lá também (últimas N gerações, nunca uma
# só — commit ruim não deve levar junto a última cópia boa). Se o HD não
# estiver montado, deixa um marcador de pendência visível.
#
# Isto NÃO substitui as passadas datadas com MANIFESTO.txt (ver MEMÓRIAS,
# entradas (116)/(117)) — aquelas continuam sendo o ponto de restauração
# point-in-time verificado. Isto só reduz o quanto elas precisam alcançar
# quando alguém lembrar de fazer uma.
set -uo pipefail
# Onde estamos (medido em 16/10/2026, reproduzido num repositório sintético): `core.hooksPath` é
# ABSOLUTO para o checkout principal, então o hook vive lá mesmo quando o commit acontece numa
# worktree vinculada; nesse caso o git exporta GIT_DIR/GIT_INDEX_FILE da worktree. O `cd "$0/.."`
# antigo ia para o checkout principal MANTENDO esse GIT_DIR: `git rev-parse HEAD` devolvia o commit
# da worktree enquanto os arquivos lidos eram os do principal -- vault rotulado com um SHA que não
# era o do que foi lido. Agora: raiz do hook e local do commit são medidos separadamente.
RAIZ_HOOK="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)" \
  || { echo "post-commit: AVISO — não consegui localizar a raiz do hook; backup e vault pulados neste commit." >&2; exit 0; }
TOPO_COMMIT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$RAIZ_HOOK")"
EM_WORKTREE=0
[ "$TOPO_COMMIT" != "$RAIZ_HOOK" ] && EM_WORKTREE=1

STAGING="$HOME/.agata-backup-staging"
mkdir -p "$STAGING"

# Um hook por vez. Dois commits (ou um commit e um `git pull`, que roda este mesmo script pelo
# post-merge) simultâneos disputavam o MESMO `agata-canonico.bundle.tmp` e os geradores do vault.
# Lock cooperativo, com espera limitada; se não vier, avisa e não trava o commit.
exec 9>"$STAGING/.post-commit.lock"
if ! flock -w 600 9; then
  echo "post-commit: AVISO — outro post-commit/post-merge segura o lock há mais de 10 min; backup e vault pulados neste commit." >&2
  exit 0
fi

SHORT=$(git rev-parse --short HEAD)
STAMP=$(date +%Y%m%d-%H%M%S)

# 1. Staging local — sempre, cache descartável, uma geração só. Temporário único, publicação
# atômica (`mv`) e dentro do lock acima.
BUNDLE_TMP="$(mktemp "$STAGING/agata-canonico.bundle.XXXXXX")" \
  || { echo "post-commit: AVISO — não consegui criar temporário do bundle" >&2; exit 0; }
if ! git bundle create "$BUNDLE_TMP" --all >/dev/null 2>&1; then
  rm -f "$BUNDLE_TMP"
  echo "post-commit: AVISO — falha ao gerar bundle no staging local" >&2
  exit 0
fi
mv -f "$BUNDLE_TMP" "$STAGING/agata-canonico.bundle"

USB="/run/media/$USER/AgataBkup01"
if mountpoint -q "$USB" 2>/dev/null; then
  AUTO="$USB/auto-backups"
  mkdir -p "$AUTO"
  DEST="$AUTO/agata-canonico-${STAMP}-${SHORT}.bundle"
  cp "$STAGING/agata-canonico.bundle" "$DEST"
  # Poda: mantém só as 5 gerações mais recentes deste padrão.
  ls -1t "$AUTO"/agata-canonico-*.bundle 2>/dev/null | tail -n +6 | xargs -r rm --
  rm -f "$STAGING/PENDENTE-HD-DESCONECTADO"
  echo "post-commit: bundle em $STAGING E em $DEST (HD conectado)"
else
  {
    echo "HD AgataBkup01 não estava montado no commit $SHORT ($STAMP)."
    echo "Staging local ($STAGING/agata-canonico.bundle) está atualizado até este commit."
    echo "Plugue o HD e rode: cp \"$STAGING/agata-canonico.bundle\" \"/run/media/\$USER/AgataBkup01/auto-backups/agata-canonico-${STAMP}-${SHORT}.bundle\""
  } > "$STAGING/PENDENTE-HD-DESCONECTADO"
  echo "post-commit: bundle só no staging local — HD não conectado (marcador escrito)"
fi

# Os derivados (vault, índice por sentido, índice do canon e envio ao Drive) são do checkout PRINCIPAL:
# vêm do `main` que está lá. Commit numa worktree de branch não os refaz (o `git pull`/merge no
# principal refaz, pelo post-merge). Daqui para baixo o ambiente é o do checkout principal e o git
# não pode herdar o GIT_DIR/GIT_INDEX_FILE da worktree.
if [ "$EM_WORKTREE" -eq 1 ]; then
  echo "post-commit: commit em worktree vinculada ($TOPO_COMMIT) — bundle feito; vault, índice e Drive só se refazem no checkout principal"
  exit 0
fi
cd "$RAIZ_HOOK" || exit 0
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Consistência dos derivados (achado do Codex, 16/10/2026): vault, índice e envio leem o checkout VIVO, e um `git pull`,
# checkout ou edição feita enquanto eles rodam mistura duas versões sob o mesmo rótulo de SHA. Aqui só se DETECTA (o
# lock não impede quem não passa por ele): mede o HEAD e o CONTEÚDO dos arquivos rastreados (`git diff HEAD --binary`,
# que muda mesmo quando um arquivo já modificado continua modificado) antes e depois da geração; se mudou, avisa e deixa
# um marcador POR CHECKOUT para o próximo `--atualizar`/commit refazer. Fail-soft: nunca bloqueia o commit.
# LIMITES (parcial, não é snapshot por SHA): uma mudança que volta ao estado inicial antes do fim (ABA) não é vista;
# arquivo não rastreado não entra; o aviso não impede o envio do derivado ao Drive. Consistência prometida exigiria
# gerar de uma árvore exportada do SHA (item adiado).
estado_checkout() { git rev-parse HEAD 2>/dev/null; git diff HEAD --binary 2>/dev/null; }
MARCADOR_MISTURA="$HOME/.cache/agata/derivados-possivelmente-misturados-$(printf '%s' "$RAIZ_HOOK" | sha256sum | cut -c1-12)"
ESTADO_INICIO="$(estado_checkout | sha256sum | cut -d' ' -f1)"
SHA_INICIO="$(git rev-parse HEAD 2>/dev/null)"

# 2. Vault Obsidian derivado — refaz memoria/obsidian/ a cada commit para
# ficar sempre em dia com MEMÓRIAS.md e o canon. É gitignorado, não entra
# no commit. Fail-soft: nunca atrapalha o commit (MEMÓRIAS (290)).
#
# Achado real, 05/09/2026 (MEMÓRIAS (343)): rodar sem AGATA_CANON_SHA/DATA faz
# gerar_obsidian.py inferir o SHA via `git diff --quiet HEAD` -- e HEAD aqui é
# o commit que ACABOU de ser feito, então qualquer arquivo rastreado com
# mudança pendente e NUNCA comitado de propósito (ex: memoria/sincronizacao.log,
# que acumula linha a cada checagem de sync) marca o vault inteiro como
# "-arvore-suja" mesmo ele estando correto. P-10 então reprova sozinho no
# próximo perimetro.sh, sem nenhuma edição real ter acontecido. Corrigido
# fixando o SHA/data no HEAD que este hook JÁ SABE que é o certo -- mesmo
# padrão que o P-10 usa passando as env vars pro extract em sandbox.
# 2a. (670) Índice por sentido ANTES do vault: o gerador só LÊ o índice para
# escrever `parecidas` e os trechos parecidos -- embedar o que é novo aqui (só a
# entrada nova e seus parágrafos, segundos) deixa o vault deste commit completo
# e o P-10 do próximo commit regenera igual. Fail-soft com teto: embedding fora
# do ar não segura o commit; o vault sai sem a seção para a entrada nova e a
# próxima busca/commit completa.
if [ -f scripts/busca_semantica.py ]; then
  if timeout 120 python3 scripts/busca_semantica.py --atualizar >/dev/null 2>&1; then
    echo "post-commit: índice por sentido em dia"
  else
    echo "post-commit: AVISO — índice por sentido não atualizou (embedding :20134 fora do ar?)" >&2
  fi
fi
if [ -f scripts/gerar_obsidian.py ]; then
  if AGATA_CANON_SHA="$(git rev-parse HEAD)" AGATA_CANON_DATA="$(git log -1 --format=%cI)" \
     python3 scripts/gerar_obsidian.py >/dev/null 2>&1; then
    echo "post-commit: vault Obsidian regenerado (memoria/obsidian/)"
  else
    echo "post-commit: AVISO — gerar_obsidian.py falhou; vault pode estar desatualizado" >&2
  fi
fi

# 3. Índice derivado do canon público — refaz indice.md + manifesto.md em
# memoria/missoes/agata-sistema/derivado/ (repo missoes, gitignorado do
# principal) para ficar em dia com o canon. Fail-soft (MEMÓRIAS (298)/(301)).
#
# 3b. Export + upload pro Drive — automático a partir daqui (ordem do Humano,
# achado de indice_export.md defasado 155 entradas). SÓ roda preparar_export_
# indice.py/subir_esfera_projeto.py quando o sha256 de indice.md mudou desde
# o último envio (marcador em ~/.cache/agata/, fora do repo) -- evita reenviar
# em commit que não toca canon (ex: mudar só um script). Fail-soft: falha de
# rede, token ou varredura de segredo nunca bloqueia o commit, só avisa --
# mesmo espírito dos passos 1/2/3a.
if [ -f scripts/gerar_indice_derivado.py ]; then
  if python3 scripts/gerar_indice_derivado.py >/dev/null 2>&1; then
    echo "post-commit: índice derivado regenerado (memoria/missoes/agata-sistema/derivado/)"
    INDICE="memoria/missoes/agata-sistema/derivado/indice.md"
    MARCADOR="$HOME/.cache/agata/indice-export-ultimo-sha"
    mkdir -p "$(dirname "$MARCADOR")"
    SHA_ATUAL="$(sha256sum "$INDICE" 2>/dev/null | awk '{print $1}')"
    SHA_ENVIADO="$(cat "$MARCADOR" 2>/dev/null || echo "")"
    if [ -n "$SHA_ATUAL" ] && [ "$SHA_ATUAL" != "$SHA_ENVIADO" ]; then
      if python3 scripts/preparar_export_indice.py >/dev/null 2>&1 \
         && python3 scripts/subir_esfera_projeto.py memoria/missoes/agata-sistema/derivado/indice_export.md >/dev/null 2>&1 \
         && python3 scripts/subir_esfera_projeto.py memoria/missoes/agata-sistema/derivado/manifesto.md >/dev/null 2>&1; then
        printf '%s' "$SHA_ATUAL" > "$MARCADOR"
        echo "post-commit: índice exportado e enviado ao Drive (conteúdo do canon mudou desde o último envio)"
      else
        echo "post-commit: AVISO — export/envio ao Drive falhou (rede, token, ou varredura de segredo) -- rode manualmente: preparar_export_indice.py + subir_esfera_projeto.py" >&2
      fi
    fi
  else
    echo "post-commit: AVISO — gerar_indice_derivado.py falhou; índice pode estar desatualizado" >&2
  fi
fi

# Fim da geração: o checkout mudou enquanto os derivados eram gerados?
if [ "$(estado_checkout | sha256sum | cut -d' ' -f1)" != "$ESTADO_INICIO" ]; then
  mkdir -p "$HOME/.cache/agata"
  printf '%s %s\n' "$(date -Iseconds)" "$SHA_INICIO" > "$MARCADOR_MISTURA"
  echo "post-commit: AVISO — o checkout mudou durante a geração dos derivados (pull, checkout ou edição); vault e índice rotulados $SHA_INICIO podem misturar duas versões. Refaça: python3 scripts/busca_semantica.py --atualizar e um novo commit/pull (marcador $MARCADOR_MISTURA)." >&2
else
  rm -f "$MARCADOR_MISTURA"
fi

exit 0
