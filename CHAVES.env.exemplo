# Modelo (CHAVES.env.exemplo) de ~/.config/agata/.env -- os segredos REAIS
# ficam SÓ em ~/.config/agata/.env (chmod 600, fora do git, nunca colado no
# chat). Fase 1 do plano de replicabilidade (propostas/plano-replicabilidade-
# 2026-09-25.md): este arquivo documenta a FORMA, nunca um valor real.
#
# Depois de preencher ~/.config/agata/.env de verdade:
#   chmod 600 ~/.config/agata/.env
#   bash scripts/cifrar_env.sh   # backup cifrado, ver CHAVES.md
# Nenhuma chave aqui é lida em runtime pelo OmniRoute -- ele guarda cifrado
# em ~/.omniroute/storage.sqlite depois do registro inicial (CHAVES.md,
# "Como o OmniRoute usa as chaves"). Provedor que sua conta não usa: deixe a
# linha comentada ou vazia, não invente um valor.

# --- Provedores de modelo (grátis, cadastro por e-mail) --------------------
# Groq -- https://console.groq.com/keys -- criar conta, "API Keys" -> Create
GROQ_API_KEY=

# OpenRouter -- https://openrouter.ai/keys -- login, "Keys" -> Create Key
OPENROUTER_API_KEY=

# Google AI Studio (Gemini) -- https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Zhipu / Z.ai (GLM) -- https://open.bigmodel.cn/ (ou z.ai) -> API Keys
ZHIPU_API_KEY=

# Cerebras -- https://cloud.cerebras.ai/ -> API Keys
CEREBRAS_API_KEY=

# DeepSeek -- https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# HuggingFace (inferência serverless) -- https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Mistral -- https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# --- Discord (ponte de leitura/escrita da Seth, redesign/mcp/discord/) -----
# discord.com/developers/applications -> aplicação -> Bot -> Reset Token,
# depois convidar o bot no servidor/canal desejado (escopo "bot", permissões
# "Read Messages"/"Send Messages"). Sem isto, ler_mensagens/enviar_mensagem
# devolvem erro estruturado -- não é obrigatório pro resto do sistema rodar.
DISCORD_BOT_TOKEN=
