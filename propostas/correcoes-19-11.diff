+#!/usr/bin/env bash
+# Involucro do lancador agata-run (Fase 2 do sandbox). Resolve o link e chama o Python.
+DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
+exec python3 "$DIR/agata_run.py" "$@"
diff --git a/scripts/agata_run.py b/scripts/agata_run.py
