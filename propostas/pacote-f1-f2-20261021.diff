+#!/usr/bin/env bash
+# P-24 (proposta 21/10/2026, v8): quente (MEMÓRIAS.md) acima do orçamento de hidratação.
+# Estado atual: AVISO (PARCIAL) com o excesso medido. Escalada para FALHA: fase seguinte.
+p24_quente_orcamento() {
+  local orc=25000 tam
+  [ -f MEMÓRIAS.md ] || return 0
+  tam=$(python3 -c "import sys;print(len(open('MEMÓRIAS.md',encoding='utf-8').read()))")
+  if [ "$tam" -gt "$orc" ]; then
+    PERIMETRO_ESTADO="PARCIAL"
+    echo "AVISO (P-24): MEMÓRIAS.md tem $tam caracteres; orçamento de hidratação é $orc. Escalada para FALHA ainda não implementada."
+  fi
+  return 0
+}
diff --git a/scripts/perimetro/p25_selos_cadeia.sh b/scripts/perimetro/p25_selos_cadeia.sh
new file mode 100644
index 0000000..0635b18
--- /dev/null
+++ b/scripts/perimetro/p25_selos_cadeia.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# P-25-SELOS (proposta 21/10/2026, v8): cadeia de SELOS.txt.
+# SELOS.chain: c_i = sha256(c_{i-1} + "\n" + linha_i_de_SELOS.txt). Não altera o formato de SELOS.txt.
+# NÃO é o P-25 do registro de sessão (C0), que fica para proposta posterior.
+p25_selos_cadeia() {
+  [ -f SELOS.txt ] || return 0
+  if [ ! -f SELOS.chain ]; then
+    PERIMETRO_ESTADO="PARCIAL"
+    echo "AVISO (P-25-SELOS): SELOS.chain ausente; rodar 'bash scripts/selar.sh --iniciar-cadeia' para começar a cadeia."
+    return 0
+  fi
+  python3 - <<'PY' || return 1
+import hashlib,sys
+linhas=[l.rstrip('\n') for l in open('SELOS.txt',encoding='utf-8') if l.strip()]
+cadeia=[l.split()[0] for l in open('SELOS.chain',encoding='utf-8') if l.strip()]
+if len(cadeia)!=len(linhas):
+    print(f"SUSPEITO (P-25-SELOS): {len(linhas)} selos e {len(cadeia)} elos; cauda divergente."); sys.exit(1)
+c=""
+for i,l in enumerate(linhas):
+    c=hashlib.sha256((c+"\n"+l).encode('utf-8')).hexdigest()
+    if c!=cadeia[i]:
+        print(f"SUSPEITO (P-25-SELOS): elo {i+1} não confere; SELOS.txt foi alterado."); sys.exit(1)
+print(f"OK (P-25-SELOS): cadeia de {len(linhas)} selos íntegra.")
+PY
+}
diff --git a/scripts/perimetro/p26_frio_tag.sh b/scripts/perimetro/p26_frio_tag.sh
new file mode 100644
index 0000000..f306a2b
--- /dev/null
+++ b/scripts/perimetro/p26_frio_tag.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# P-26 (proposta 21/10/2026, v8): todo chunk frio selado tem tag de git.
+# Estado atual: 11 chunks sem tag própria -> PARCIAL (aviso) com a lista. Criar tags = backfill aprovado.
+p26_frio_tag() {
+  [ -f SELOS.txt ] || return 0
+  local faltam="" arq base tag
+  while read -r _hash arq _data; do
+    [ -z "$arq" ] && continue
+    case "$arq" in memoria/frio/*|MEMORIAS-FRIO-*) ;; *) continue ;; esac
+    base="${arq%.md}"; base="${base##*/}"; tag="${base}-final"
+    git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1 || faltam="$faltam $tag"
+  done < SELOS.txt
+  if [ -n "$faltam" ]; then
+    PERIMETRO_ESTADO="PARCIAL"
+    echo "AVISO (P-26): chunks frios sem tag:$faltam (backfill pendente, aprovado pelo Humano)."
+  else
+    echo "OK (P-26): todo chunk frio selado tem tag."
+  fi
+  return 0
+}
