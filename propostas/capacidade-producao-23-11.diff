+        self.assertEqual((r["provedor"], r["endpoint"], r["data"]), ("gemini", "gemini/gemini-2.5-flash", DATA))
+        self.assertEqual(len(self._registros("gemini/gemini-2.5-flash", "codigo")), 1)
+        self.assertEqual(cap.conferir(self.reg), [])
