+    lat = [x["latencia_ms"] for x in grupo if x["latencia_ms"] is not None]
+    ok = sum(1 for x in grupo if x["status"] == 200 and not x["bloqueado"])
+    return {"amostra": len(grupo), "ok": ok, "falhas": len(grupo) - ok, "lat_n": len(lat),
