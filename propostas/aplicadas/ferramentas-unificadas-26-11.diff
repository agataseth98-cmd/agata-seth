+#!/usr/bin/env python3
+"""Reverte uma execução do sync pelo registro (lote ferramentas-unificadas-26-11; A3, AC-09, AC-10).
+
+Uso:
+  reverter.py --listar                      lista as execuções com registro
+  reverter.py <ts> --dry-run                mostra o que voltaria, sem mexer
+  reverter.py <ts> [--com-overlay]          reverte; --com-overlay também move o overlay para ~/agata-arquivo/
+
+Regra: se alguma entrada, ponteiro ou o opencode.jsonc mudou depois do sync, nada é revertido (código 3).
+- Claude e Codex: remove a entrada, ou recoloca o valor anterior, pelo comando nativo. Ausente é registrado, sem falhar.
+- OpenCode (sem remove, L6): volta o arquivo do backup só se o hash ainda é o que o sync deixou; senão, pede ao Humano.
+- Ponteiros de skill: mv para ~/agata-arquivo/ferramentas-<ts>/ (nunca rm).
+- Manifest: volta ao que havia antes de cada ação (campo manifesto_antes do registro).
+Códigos: 0 ok; 2 execução inexistente, registro ou config ilegível, ou falha de comando; 3 recusa.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from datetime import datetime
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import estado as E  # noqa: E402
+import nativos as N  # noqa: E402
+import schema as S  # noqa: E402
+import sincronizar as SYNC  # noqa: E402
+
+NATIVAS = ("adicionar", "substituir", "remover")
+
+
+class ErroReversao(RuntimeError):
+    """Execução inexistente, já revertida ou com registro que não serve para reverter."""
+
+
+def listar(ctx: E.Contexto) -> list[dict]:
+    raiz = ctx.base / "backup"
+    if not raiz.is_dir():
+        return []
+    saida = []
+    for d in sorted(raiz.iterdir()):
+        reg = d / "sincronia.json"
+        if not reg.is_file():
+            continue
+        try:
+            r = json.loads(reg.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            saida.append({"ts": d.name, "erro": "registro ilegível"})
+            continue
+        saida.append({"ts": d.name, "mcp": len(r.get("mcp", [])), "ponteiros": len(r.get("ponteiros", [])),
+                      "revertida_em": r.get("revertida_em")})
+    return saida
+
+
+def _carregar(ctx: E.Contexto, ts: str) -> dict:
+    p = ctx.base / "backup" / ts / "sincronia.json"
+    if not p.is_file():
+        raise ErroReversao(f"execução {ts} não encontrada")
+    try:
+        reg = json.loads(p.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        raise ErroReversao(f"registro de {ts} ilegível") from None
+    if reg.get("revertida_em"):
+        raise ErroReversao(f"execução {ts} já foi revertida em {reg['revertida_em']}")
+    return reg
+
+
+def _divergencias(ctx: E.Contexto, reg: dict, nativos: dict) -> list[str]:
+    out = []
+    for a in reg.get("mcp", []):
+        atual = nativos[a["cli"]].get(a["nome"])
+        h_atual = N.hash_entrada(atual) if atual is not None else None
+        if a["acao"] not in NATIVAS or h_atual == a.get("depois"):
+            continue
+        if a.get("estado") == "iniciado":
+            # a chamada nativa não terminou: aceita ausente (falhou antes) ou o valor de antes (não chegou a mudar)
+            if h_atual is None or (a.get("antes") is not None and h_atual == N.hash_entrada(a["antes"])):
+                continue
+        out.append(f"{a['cli']} {a['nome']}: mudou depois do sync")
+    info = reg.get("arquivos", {}).get("opencode")
+    if info and info.get("depois") is not None and E.hash_arquivo(ctx.opencode_jsonc) != info["depois"]:
+        out.append("opencode.jsonc mudou depois do sync; volta só com ordem do Humano (A3)")
+    for p in reg.get("ponteiros", []):
+        if p["acao"] in ("registrar_sem_escrita", "limpar_manifest"):
+            continue
+        atual = SYNC.destino_ponteiro(Path(p["link"]))
+        if p["acao"] == "ponteiro_remover":
+            if atual is not None:
+                out.append(f"skill {p['nome']} ({p['cli']}): ponteiro reapareceu depois do sync")
+        elif atual is None or str(atual) != p.get("depois"):
+            out.append(f"skill {p['nome']} ({p['cli']}): ponteiro mudou depois do sync")
+    return out
+
+
+def _restaurar(secao: dict, chave: str, antes) -> None:
+    if antes is None:
+        secao.pop(chave, None)
+    else:
+        secao[chave] = antes
+
+
+def _reverter_mcp(ctx: E.Contexto, reg: dict, nativos: dict, manifesto: dict, imprimir) -> None:
+    for a in reversed(reg.get("mcp", [])):
+        cli, nome = a["cli"], a["nome"]
+        if cli != "opencode" and a["acao"] in NATIVAS:
+            atual = nativos[cli].get(nome)
+            antes = a.get("antes")
+            if antes is None:
+                if atual is not None:
+                    SYNC.rodar_nativo(ctx, N.argv_remover(cli, nome), f"{cli} remover {nome}")
+                    imprimir(f"removida: {cli} {nome}")
+                else:
+                    imprimir(f"ausente: {cli} {nome} (registrada, sem falhar)")
+            elif atual is None or N.hash_entrada(atual) != N.hash_entrada(antes):
+                if antes.get("transporte") not in ("stdio", "http"):
+                    raise ErroReversao(f"{cli} {nome}: transporte anterior não restaurável pelo comando nativo")
+                if atual is not None:
+                    SYNC.rodar_nativo(ctx, N.argv_remover(cli, nome), f"{cli} remover {nome}")
+                antes_resolvido = {k: antes.get(k) for k in ("transporte", "comando", "args", "url", "env")}
+                SYNC.rodar_nativo(ctx, N.argv_adicionar(cli, nome, antes_resolvido), f"{cli} restaurar {nome}")
+                imprimir(f"restaurada: {cli} {nome}")
+        _restaurar(manifesto["entradas"], f"{cli}|mcp|{nome}", a.get("manifesto_antes"))
+
+
+def _reverter_opencode(ctx: E.Contexto, reg: dict, manifesto: dict, ts: str, imprimir) -> None:
+    info = reg.get("arquivos", {}).get("opencode")
+    if not info:
+        return
+    if info.get("depois") is not None:
+        pasta = ctx.base / "backup" / ts
+        if ctx.opencode_jsonc.exists():
+            E.gravar_bytes(pasta / "opencode-antes-de-reverter.jsonc", ctx.opencode_jsonc.read_bytes())
+        if info.get("backup"):
+            E.gravar_bytes(ctx.opencode_jsonc, (pasta / info["backup"]).read_bytes())
+            imprimir("restaurado: opencode.jsonc do backup (hash conferido antes)")
+        elif ctx.opencode_jsonc.exists():
+            os.rename(ctx.opencode_jsonc, E.area_arquivo(ctx, ts) / "opencode.jsonc")
+            imprimir("opencode.jsonc movido para ~/agata-arquivo (não existia antes do sync)")
+    _restaurar(manifesto["arquivos"], "opencode", info.get("manifesto_antes"))
+
+
+def _reverter_ponteiros(ctx: E.Contexto, reg: dict, manifesto: dict, ts: str, imprimir) -> None:
+    for p in reversed(reg.get("ponteiros", [])):
+        cli, nome, acao = p["cli"], p["nome"], p["acao"]
+        link = Path(p["link"])
+        if acao == "ponteiro_criar" and link.is_symlink():
+            os.rename(link, E.area_arquivo(ctx, ts) / f"{cli}-{nome}")
+            imprimir(f"ponteiro movido para o arquivo: {cli} {nome}")
+        elif acao == "ponteiro_atualizar":
+            if p.get("antes"):
+                tmp = link.with_name(f".{link.name}.{ts}.rev")
+                os.symlink(p["antes"], tmp)
+                os.replace(tmp, link)
+                imprimir(f"ponteiro voltou ao alvo anterior: {cli} {nome}")
+            elif link.is_symlink():
+                os.rename(link, E.area_arquivo(ctx, ts) / f"{cli}-{nome}")
+        elif acao == "ponteiro_remover" and p.get("arquivo") and os.path.lexists(p["arquivo"]):
+            os.rename(p["arquivo"], link)
+            imprimir(f"ponteiro restaurado: {cli} {nome}")
+        _restaurar(manifesto["ponteiros"], f"{cli}|skill|{nome}", p.get("manifesto_antes"))
+
+
+def reverter(ctx: E.Contexto, ts: str, dry_run: bool = False, com_overlay: bool = False, imprimir=print) -> int:
+    try:
+        reg = _carregar(ctx, ts)
+        manifesto = E.ler_manifest(ctx)
+        nativos = {cli: N.ler_mcp(cli, ctx) for cli in S.CLIS}
+    except (ErroReversao, E.ErroEstado, N.ErroConfig) as e:
+        imprimir(f"ERRO: {e}")
+        return 2
+    recusas = _divergencias(ctx, reg, nativos)
+    if recusas:
+        for r in recusas:
+            imprimir(f"RECUSA: {r}")
+        imprimir("nada revertido: volte só com o estado que o sync deixou")
+        return 3
+    prefixo = "(simulação, nada revertido) " if dry_run else ""
+    for a in reversed(reg.get("mcp", [])):
+        if a["acao"] in NATIVAS and a["cli"] != "opencode":
+            imprimir(f"{prefixo}{a['cli']} {a['nome']}: {'remover' if a.get('antes') is None else 'recolocar valor anterior'}")
+    if reg.get("arquivos", {}).get("opencode", {}).get("depois") is not None:
+        imprimir(f"{prefixo}opencode.jsonc: voltar ao backup (A3)")
+    for p in reversed(reg.get("ponteiros", [])):
+        if p["acao"] in ("ponteiro_criar", "ponteiro_atualizar", "ponteiro_remover"):
+            imprimir(f"{prefixo}skill {p['nome']} ({p['cli']}): {p['acao']} desfeito")
+    if dry_run:
+        return 0
+    try:
+        _reverter_mcp(ctx, reg, nativos, manifesto, imprimir)
+        _reverter_opencode(ctx, reg, manifesto, ts, imprimir)
+        _reverter_ponteiros(ctx, reg, manifesto, ts, imprimir)
+        if com_overlay and ctx.overlay.exists():
+            os.rename(ctx.overlay, E.area_arquivo(ctx, ts) / "ferramentas.yml")
+            imprimir("overlay movido para ~/agata-arquivo")
+    except (SYNC.ErroCli, ErroReversao, OSError) as e:
+        imprimir(f"ERRO: {e}")
+        imprimir("reversão parcial; rode de novo com o mesmo ts depois de olhar o erro")
+        return 2
+    finally:
+        E.gravar_json(ctx.base / "gerenciado.json", manifesto)
+    reg["revertida_em"] = datetime.now().isoformat(timespec="seconds")
+    E.gravar_json(ctx.base / "backup" / ts / "sincronia.json", reg)
+    E.registrar(ctx, {"ts": ts, "acao": "reverter", "cli": "-", "tipo": "-", "nome": "-"})
+    imprimir(f"execução {ts} revertida")
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    p = argparse.ArgumentParser(description="Reverte uma execução do sync de ferramentas.")
+    p.add_argument("ts", nargs="?", help="nome da pasta em <base>/backup/")
+    p.add_argument("--listar", action="store_true")
+    p.add_argument("--dry-run", action="store_true")
+    p.add_argument("--com-overlay", action="store_true")
+    a = p.parse_args(argv)
+    ctx = E.contexto_padrao()
+    if a.listar:
+        execucoes = listar(ctx)
+        for e in execucoes:
+            if "erro" in e:
+                print(f"{e['ts']}  {e['erro']}")
+            else:
+                estado = f"revertida em {e['revertida_em']}" if e["revertida_em"] else "pode reverter"
+                print(f"{e['ts']}  mcp={e['mcp']}  ponteiros={e['ponteiros']}  {estado}")
+        if not execucoes:
+            print("nenhuma execução registrada")
+        return 0
+    if not a.ts:
+        p.error("informe a execução (ts) ou use --listar")
+    return reverter(ctx, a.ts, a.dry_run, a.com_overlay)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ferramentas/schema.py b/scripts/ferramentas/schema.py
new file mode 100644
index 00000000..db57316e
--- /dev/null
+++ b/scripts/ferramentas/schema.py
@@ -0,0 +1,254 @@
+#!/usr/bin/env python3
+"""Schema e carga das fontes de ferramentas (lote ferramentas-unificadas-26-11).
+
+Fonte canônica: config/ferramentas/{mcp,skills,agentes}.yml (sob P-8). Overlay do Humano:
+~/agata-local/ferramentas.yml, mesmo schema, sobrepõe por nome. Nenhum campo guarda valor de segredo:
+`env` é lista de NOMES de variável, `url` não pode trazer usuário, senha nem query, e `args` passa por
+uma checagem de padrões de segredo (heurística, não prova). Erros nomeiam campo e arquivo, nunca valor.
+"""
+from __future__ import annotations
+
+import re
+from collections import OrderedDict
+from dataclasses import dataclass
+from pathlib import Path
+from urllib.parse import urlsplit
+
+import yaml
+
+CLIS = ("claude", "codex", "opencode")
+TIPOS = ("mcp", "skills", "agentes")
+CATEGORIA = {"mcp": "mcp", "skills": "skill", "agentes": "agente"}
+ARQUIVO_CANON = {"mcp": "mcp.yml", "skills": "skills.yml", "agentes": "agentes.yml"}
+PREFIXO_ORIGEM = {"skills": ".agents/skills/", "agentes": ".claude/agents/"}
+TOPO_CANON = {"mcp": {"mcp"}, "skills": {"skills", "indice"}, "agentes": {"agentes"}}
+OBRIGATORIOS = {
+    "mcp": {"nome", "transporte", "clis"},
+    "skills": {"nome", "origem", "clis"},
+    "agentes": {"nome", "origem", "clis"},
+}
+ESPECIFICOS = {"mcp": {"transporte", "comando", "args", "url", "env"}, "skills": set(), "agentes": set()}
+COMUNS = {"adotar", "gerenciado", "motivo", "descricao"}
+RE_NOME = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")
+RE_VARIAVEL = re.compile(r"[A-Z_][A-Z0-9_]*")
+RE_CAMPO_SEGURO = re.compile(r"[a-z_]{1,32}")
+# Heurística: nome=valor de chave conhecida ou prefixo de token conhecido em args.
+RE_SEGREDO_ARG = re.compile(
+    r"(?i)(token|senha|secret|password|passwd|apikey|api_key)\s*[=:]|\b(ghp_|github_pat_|sk-|xox[bp]-)"
+)
+
+
+class ErroSchema(ValueError):
+    """Fonte fora do schema. A mensagem nomeia campo e arquivo; nunca traz valor."""
+
+
+@dataclass
+class Fonte:
+    entradas: dict  # tipo -> OrderedDict nome -> entrada normalizada (overlay sobrepõe por nome)
+    origem: dict  # tipo -> nome -> "canonico" | "overlay"
+    canonico: dict  # tipo -> OrderedDict nome -> entrada (só a fonte canônica)
+    indice: str | None
+
+
+def _erro(onde: str, msg: str) -> ErroSchema:
+    return ErroSchema(f"{onde}: {msg}")
+
+
+def _nomes_seguros(campos) -> str:
+    return ", ".join(c if isinstance(c, str) and RE_CAMPO_SEGURO.fullmatch(c) else "[campo não listável]" for c in campos)
+
+
+def _validar_mcp(dado: dict, onde: str) -> dict:
+    transporte = dado["transporte"]
+    if transporte not in ("stdio", "http"):
+        raise _erro(onde, "transporte tem de ser stdio ou http")
+    if transporte == "stdio":
+        if "url" in dado:
+            raise _erro(onde, "url só vale com transporte http")
+        comando = dado.get("comando")
+        if not isinstance(comando, str) or not comando.strip():
+            raise _erro(onde, "transporte stdio exige comando")
+        args = dado.get("args", [])
+        if not isinstance(args, list) or not all(isinstance(a, str) and "\n" not in a for a in args):
+            raise _erro(onde, "args é lista de texto, uma entrada por argumento")
+        for a in args:
+            if RE_SEGREDO_ARG.search(a):
+                raise _erro(onde, "args parece trazer segredo; passe a variável em env (só o nome)")
+        env = dado.get("env", [])
+        if not isinstance(env, list):
+            raise _erro(onde, "env é lista de nomes de variável")
+        for var in env:
+            if not isinstance(var, str) or not RE_VARIAVEL.fullmatch(var):
+                raise _erro(onde, "env lista só nomes de variável (maiúsculas, números e _); valor não entra na fonte")
+        return {"transporte": "stdio", "comando": comando, "args": list(args), "url": None, "env": list(env)}
+    for campo in ("comando", "args", "env"):
+        if campo in dado:
+            raise _erro(onde, f"{campo} só vale com transporte stdio")
+    url = dado.get("url")
+    if not isinstance(url, str):
+        raise _erro(onde, "transporte http exige url")
+    p = urlsplit(url)
+    if p.scheme not in ("http", "https") or not p.hostname or p.username or p.password or p.query or p.fragment:
+        raise _erro(onde, "url tem de ser http(s), sem usuário, senha, query ou fragmento")
+    return {"transporte": "http", "comando": None, "args": [], "url": url, "env": []}
+
+
+def validar_entrada(tipo: str, dado, onde: str = "entrada") -> dict:
+    """Valida uma entrada de um tipo e devolve a forma normalizada (com padrões preenchidos)."""
+    if not isinstance(dado, dict):
+        raise _erro(onde, "a entrada tem de ser um mapa")
+    permitidos = OBRIGATORIOS[tipo] | ESPECIFICOS[tipo] | COMUNS
+    fora = set(dado) - permitidos
+    if fora:
+        raise _erro(onde, "campo fora do schema: " + _nomes_seguros(sorted(fora, key=str)))
+    faltam = OBRIGATORIOS[tipo] - set(dado)
+    if faltam:
+        raise _erro(onde, "campo obrigatório ausente: " + _nomes_seguros(sorted(faltam)))
+    nome = dado["nome"]
+    if not isinstance(nome, str) or len(nome) > 64 or not RE_NOME.fullmatch(nome):
+        raise _erro(onde, "nome deve ser minúsculas, números e hífen (até 64 caracteres)")
+    clis = dado["clis"]
+    if not isinstance(clis, list) or not clis or len(set(clis)) != len(clis) or any(c not in CLIS for c in clis):
+        raise _erro(onde, "clis é lista não vazia, sem repetição, de: " + ", ".join(CLIS))
+    adotar = dado.get("adotar", False)
+    gerenciado = dado.get("gerenciado", True)
+    if not isinstance(adotar, bool) or not isinstance(gerenciado, bool):
+        raise _erro(onde, "adotar e gerenciado são true ou false")
+    motivo = dado.get("motivo", "")
+    if not isinstance(motivo, str):
+        raise _erro(onde, "motivo é texto")
+    if not gerenciado and not motivo.strip():
+        raise _erro(onde, "gerenciado: false exige motivo")
+    descricao = dado.get("descricao", "")
+    if not isinstance(descricao, str):
+        raise _erro(onde, "descricao é texto")
+    saida = {
+        "nome": nome,
+        "clis": list(clis),
+        "adotar": adotar,
+        "gerenciado": gerenciado,
+        "motivo": motivo,
+        "descricao": descricao,
+    }
+    if tipo == "mcp":
+        saida.update(_validar_mcp(dado, onde))
+        return saida
+    origem = dado["origem"]
+    prefixo = PREFIXO_ORIGEM[tipo]
+    partes = origem.split("/") if isinstance(origem, str) else []
+    if not isinstance(origem, str) or not origem.startswith(prefixo) or ".." in partes or origem.endswith("/"):
+        raise _erro(onde, f"origem tem de ficar em {prefixo}, sem '..'")
+    base = partes[-1]
+    if tipo == "skills" and base != nome:
+        raise _erro(onde, "em skills, o último trecho da origem é o nome da skill")
+    if tipo == "agentes" and base != nome + ".md":
+        raise _erro(onde, "em agentes, a origem é <nome>.md")
+    saida["origem"] = origem
+    return saida
+
+
+def _ler_yaml(caminho: Path, obrigatorio: bool) -> dict:
+    if not caminho.exists():
+        if obrigatorio:
+            raise ErroSchema(f"{caminho}: fonte ausente")
+        return {}
+    try:
+        dados = yaml.safe_load(caminho.read_text(encoding="utf-8")) or {}
+    except (OSError, yaml.YAMLError) as e:
+        # só o tipo do erro: a mensagem do PyYAML mostra trechos do arquivo
+        raise ErroSchema(f"{caminho}: YAML inválido ({type(e).__name__})") from None
+    if not isinstance(dados, dict):
+        raise ErroSchema(f"{caminho}: o topo tem de ser um mapa")
+    return dados
+
+
+def _checar_topo(dados: dict, permitidos: set, onde: str) -> None:
+    fora = set(dados) - permitidos
+    if fora:
+        raise _erro(onde, "chave de topo fora do schema: " + _nomes_seguros(sorted(fora, key=str)))
+
+
+def _lista(tipo: str, bruto, onde: str) -> OrderedDict:
+    if bruto is None:
+        bruto = []
+    if not isinstance(bruto, list):
+        raise _erro(onde, f"{tipo} tem de ser lista")
+    saida: OrderedDict = OrderedDict()
+    for i, item in enumerate(bruto):
+        e = validar_entrada(tipo, item, f"{onde} [{tipo}][{i}]")
+        if e["nome"] in saida:
+            raise _erro(onde, f"nome repetido em {tipo}: {e['nome']}")
+        saida[e["nome"]] = e
+    return saida
+
+
+def carregar_overlay(caminho: Path) -> dict:
+    """Overlay do Humano como tipo -> OrderedDict nome -> entrada. Arquivo ausente é overlay vazio."""
+    dados = _ler_yaml(caminho, obrigatorio=False)
+    _checar_topo(dados, set(TIPOS), str(caminho))
+    return {tipo: _lista(tipo, dados.get(tipo), str(caminho)) for tipo in TIPOS}
+
+
+def carregar_canonico(raiz: Path) -> tuple[dict, str | None]:
+    """Fonte canônica como tipo -> OrderedDict, e o ponteiro de índice de skills (se houver)."""
+    canon, indice = {}, None
+    for tipo in TIPOS:
+        arq = raiz / "config" / "ferramentas" / ARQUIVO_CANON[tipo]
+        dados = _ler_yaml(arq, obrigatorio=True)
+        _checar_topo(dados, TOPO_CANON[tipo], str(arq))
+        if tipo == "skills":
+            indice = dados.get("indice")
+            if indice is not None and not isinstance(indice, str):
+                raise _erro(str(arq), "indice é um caminho de texto")
+        canon[tipo] = _lista(tipo, dados.get(tipo), str(arq))
+    return canon, indice
+
+
+def carregar_fontes(raiz: Path, overlay: Path) -> Fonte:
+    """Canônico ∪ overlay; o overlay sobrepõe por nome e a origem de cada entrada fica registrada."""
+    canon, indice = carregar_canonico(raiz)
+    ov = carregar_overlay(overlay)
+    entradas, origem = {}, {}
+    for tipo in TIPOS:
+        mesclada: OrderedDict = OrderedDict()
+        origem_tipo: dict = {}
+        for nome, e in canon[tipo].items():
+            mesclada[nome] = e
+            origem_tipo[nome] = "canonico"
+        for nome, e in ov[tipo].items():
+            mesclada[nome] = e
+            origem_tipo[nome] = "overlay"
+        entradas[tipo] = mesclada
+        origem[tipo] = origem_tipo
+    return Fonte(entradas=entradas, origem=origem, canonico=canon, indice=indice)
+
+
+def para_yml(tipo: str, e: dict) -> dict:
+    """Forma de arquivo (só campos informados, sem padrões) para gravar no overlay ou propor no canônico."""
+    d: dict = {"nome": e["nome"]}
+    if tipo == "mcp":
+        d["transporte"] = e["transporte"]
+        if e["transporte"] == "stdio":
+            d["comando"] = e["comando"]
+            if e["args"]:
+                d["args"] = list(e["args"])
+            if e["env"]:
+                d["env"] = list(e["env"])
+        else:
+            d["url"] = e["url"]
+    else:
+        d["origem"] = e["origem"]
+    d["clis"] = list(e["clis"])
+    if e["adotar"]:
+        d["adotar"] = True
+    if not e["gerenciado"]:
+        d["gerenciado"] = False
+        d["motivo"] = e["motivo"]
+    if e["descricao"]:
+        d["descricao"] = e["descricao"]
+    return d
+
+
+def serializar_overlay(ov: dict) -> dict:
+    """Overlay (tipo -> OrderedDict) na forma de arquivo, pronta para yaml.safe_dump."""
+    return {tipo: [para_yml(tipo, e) for e in ov[tipo].values()] for tipo in TIPOS}
