+    def test_uma_so_folha_de_estilo(self):
+        folhas = re.findall(r'<link rel="stylesheet" href="([^"]+)"', HTML)
+        self.assertEqual(folhas, ["prototipo.css"])
+        for arq in ("nova_versao.css", "styles.css", '"frentes.js"'):
