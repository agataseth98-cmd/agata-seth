-*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:14px;line-height:1.5}
-button,input{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit}.shell{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
