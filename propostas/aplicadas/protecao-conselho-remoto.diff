+    e["fails"] = int(e.get("fails", 0)) + 1
+    espera = min(BREAKER_BASE_S * (2 ** (e["fails"] - 1)), BREAKER_MAX_S)
+    e["cooldown_ate"] = time.time() + espera
+    b[modelo] = e
+    _gravar_breaker(b)
+    return int(espera)
