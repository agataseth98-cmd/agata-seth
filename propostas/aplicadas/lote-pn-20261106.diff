+        "treina_com_prompts": "nao", "cota": "c", "compartilhada_com_seth": False, "cota_medida": True,
+        "conferida_em": "2026-11-06", "fonte": "f"}
+
+
+def rota(**kw):
+    r = dict(BASE); r.update(kw); return r
