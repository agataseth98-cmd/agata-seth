+.atalhos-lista{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;font-size:var(--fs-3);line-height:1.45}
+kbd{font:var(--fs-2) var(--mono);border:1px solid var(--line);border-bottom-width:2px;border-radius:var(--r-1);padding:0 5px;background:var(--blue-soft);color:var(--ink)}
+
+/* ===== Acabamento visual e funcional (16/11/2026, lote painel-funcional-16-11). Só tokens do :root. ===== */
+
+/* F9: estados em um só lugar. ok = --teal; atenção = --gold; erro = --rose; sem leitura = neutro apagado; ausente = contorno tracejado neutro (não é erro). */
+.chip{background:transparent;color:var(--muted);border:1px solid var(--line);font:var(--fs-1) var(--mono)}
+.chip.active{background:var(--teal-soft);color:var(--teal-ink);border-color:transparent}
+.chip.partial{background:var(--gold-soft);color:var(--gold);border-color:transparent}
+.chip.erro{background:var(--rose-soft);color:var(--rose);border-color:transparent}
+.chip.horizon{background:transparent;color:var(--faint);border:1px solid var(--line)}
+.chip.planned{background:var(--blue-soft);color:var(--blue-ink);border-color:transparent}
+.chip.ausente{background:transparent;color:var(--muted);border:1px dashed var(--line-strong)}
+.cap-card[data-state="sem-leitura"]{border-color:var(--line)}
+.cap-card[data-state="sem-leitura"] h3{color:var(--muted)}
+
+/* F10: estados vazios com um estilo só: centrado, --muted, com respiro. */
+.vazio,.seth-vazio,td.vazio{padding:22px 16px;text-align:center;color:var(--muted);font-size:var(--fs-3);line-height:1.5}
+#sub-conselho li.vazio{padding:22px 16px;text-align:center;color:var(--muted);font-size:var(--fs-3)}
+
+/* F1: botões do vault (Panorama e Conhecimento) com o estilo de botão secundário do painel. */
+.memory-links button,.memory-links a{display:inline-flex;align-items:center;min-height:34px;padding:6px 12px;border:1px solid var(--line);border-radius:var(--r-2);background:var(--sheet);color:var(--ink);font:var(--fs-3)/1.2 var(--sans);text-decoration:none;cursor:pointer}
+.memory-links button:hover,.memory-links a:hover{border-color:var(--teal);color:var(--teal)}
+.memory-links button:focus-visible,.memory-links a:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+
+/* F2: serviços da lateral discretos: contorno --line, texto --muted; realce só no hover e no foco. */
+.abrir-lista .btn{background:transparent;color:var(--muted);border:1px solid var(--line);box-shadow:none;transform:none}
+.abrir-lista .btn:hover,.abrir-lista .btn:focus-visible{background:transparent;color:var(--teal);border-color:var(--teal);transform:none}
+.abrir-lista .btn:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
+
+/* F4: cartões do Conselho com 14px entre eles; botões com a largura do conteúdo, alinhados à esquerda. */
+#sub-conselho .conselho-page{display:grid;gap:14px}
+#sub-conselho .row > button,#sub-conselho .chain-controls button{flex:none;width:auto;justify-self:start}
+#sub-conselho .row > button{align-self:flex-start}
+
+/* F5: anel e legenda lado a lado, com intervalo; empilhados no celular. */
+.memory-orbit{grid-template-columns:150px minmax(0,1fr);gap:18px}
+.orbit-150{width:150px;height:150px}
+@media (max-width:690px){.memory-orbit{grid-template-columns:1fr;justify-items:start}}
+
+/* F6: lista de conversas. Título em até 2 linhas (o completo fica no atributo title); ações e pasta em --fs-2 e --muted; cheias no item em hover, foco ou ativo; sempre cheias em tela de toque. */
+.seth-item-abrir{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.35;overflow-wrap:anywhere}
+.seth-item-acoes,.seth-item-org{font-size:var(--fs-2);color:var(--muted);opacity:.45;transition:opacity .15s}
+.seth-item-acoes .text-link{color:var(--muted);border-color:var(--line)}
+.seth-item-acoes .text-link:hover{color:var(--teal);border-color:var(--teal)}
+.seth-item-org summary{font-size:var(--fs-2);color:var(--muted)}
+.seth-item:hover .seth-item-acoes,.seth-item:hover .seth-item-org,.seth-item:focus-within .seth-item-acoes,.seth-item:focus-within .seth-item-org,.seth-item.ativa .seth-item-acoes,.seth-item.ativa .seth-item-org{opacity:1}
+@media (hover:none){.seth-item-acoes,.seth-item-org{opacity:1}}
+
+/* F8: celular (até 690px). A barra quebra em linhas e a busca ocupa a largura toda; Serviços e a nota do Humano saem do topo; tabelas rolam dentro do cartão; alvos de toque com 40px. */
+@media (max-width:690px){
+  .topbar{height:auto;flex-direction:column;align-items:stretch;gap:10px;margin-bottom:12px}
+  .top-actions{flex-wrap:wrap;width:100%;gap:8px}
+  .ajustes{flex-wrap:wrap;gap:8px}
+  .searchbox{width:100%;box-sizing:border-box}
+  #servicos-locais,.side-bottom,.side-foot{display:none}
+  main{min-width:0}
+  .panel table,.conselho-page table,#sub-conselho table{display:block;max-width:100%;overflow-x:auto}
+  .nav button,.abas button,.filterbar button,.btn,.memory-links button,.memory-links a,.seth-item-acoes .text-link,.seth-item-org summary{min-height:40px}
+  .text-link{display:inline-flex;align-items:center;min-height:40px}
+  .sidebar-toggle{width:40px;height:40px}
+}
+
+/* F3: Operator Console com as superfícies e os raios dos tokens do painel. */
+#oc-raiz .oc-cards article,#oc-raiz .oc-lista p,#oc-raiz .oc-lista article,#oc-raiz pre,#oc-raiz .oc-fonte,#oc-raiz .oc-carregar{border-radius:var(--r-2)}
+#oc-raiz .oc-cards article{border-radius:var(--r-3)}
