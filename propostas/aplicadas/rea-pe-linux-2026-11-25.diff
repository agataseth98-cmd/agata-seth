+#!/usr/bin/env python3
+"""Contrato local do wrapper PE: argv, recusas e fixtures sintéticas estáveis."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+WRAPPER = ROOT / "scripts" / "rea_leitura.sh"
+PE_COMMANDS = (
+    "inspect-pe-imports",
+    "inspect-pe-certificates",
+    "inspect-pe-resources",
+    "inspect-pe-load-config",
+)
+JS_COMMANDS = (
+    "analyze-javascript-application", "recover-javascript-sources", "export-web-scripts",
+    "trace-javascript-semantics", "compare-source-to-bundle", "compare-application-versions",
+    "compare-javascript-export-shapes", "reconcile-javascript-runtime", "inspect-web-network-capture",
+    "compare-web-captures", "trace-web-module-imports", "trace-web-source-location",
+    "inspect-analysis-view", "inspect-evidence-bundle",
+)
+
+
+def cached_rea_package() -> Path | None:
+    for package_json in Path.home().glob(".npm/_npx/*/node_modules/rea-agents/package.json"):
+        try:
+            if json.loads(package_json.read_text(encoding="utf-8")).get("version") == "6.8.0":
+                return package_json.parent
+        except (OSError, json.JSONDecodeError):
+            continue
+    return None
+
+
+def pe_fixture(is_plus: bool = False, populated: bool = False) -> bytes:
+    """Gera PE32/PE32+ sintético, com diretórios vazios ou dados de domínio conhecidos."""
+    image = bytearray(0x1000 if populated else 0x400)
+    image[0:2] = b"MZ"
+    struct.pack_into("<I", image, 0x3C, 0x80)
+    image[0x80:0x84] = b"PE\0\0"
+    machine = 0x8664 if is_plus else 0x014C
+    struct.pack_into("<HHIIIHH", image, 0x84, machine, 3 if populated else 1, 0, 0, 0, 0xF0 if is_plus else 0xE0, 0x0102)
+    opt = 0x98
+    struct.pack_into("<H", image, opt, 0x020B if is_plus else 0x010B)
+    struct.pack_into("<I", image, opt + 16, 0x1000)
+    if is_plus:
+        struct.pack_into("<Q", image, opt + 24, 0x140000000)
+        dirs = opt + 112
+    else:
+        struct.pack_into("<I", image, opt + 28, 0x00400000)
+        dirs = opt + 96
+    struct.pack_into("<II", image, opt + 32, 0x1000, 0x200)
+    struct.pack_into("<I", image, opt + 56, 0x4000 if populated else 0x2000)
+    struct.pack_into("<I", image, opt + 60, 0x200)
+    struct.pack_into("<I", image, dirs - 4, 16)
+    sec = opt + (0xF0 if is_plus else 0xE0)
+    image[sec:sec + 8] = b".text\0\0\0"
+    struct.pack_into("<IIII", image, sec + 8, 0x400 if populated else 0x200, 0x1000,
+                     0x400 if populated else 0x200, 0x200)
+    struct.pack_into("<I", image, sec + 36, 0x60000020)
+    if populated:
+        rdata = sec + 40
+        image[rdata:rdata + 8] = b".rdata\0\0"
+        struct.pack_into("<IIII", image, rdata + 8, 0x600, 0x2000, 0x600, 0x600)
+        struct.pack_into("<I", image, rdata + 36, 0x40000040)
+        rsrc = rdata + 40
+        image[rsrc:rsrc + 8] = b".rsrc\0\0\0"
+        struct.pack_into("<IIII", image, rsrc + 8, 0x200, 0x3000, 0x200, 0xC00)
+        struct.pack_into("<I", image, rsrc + 36, 0x40000040)
+        struct.pack_into("<II", image, dirs + 8, 0x2000, 40)       # import directory
+        struct.pack_into("<II", image, dirs + 16, 0x3000, 0x80)   # resources
+        struct.pack_into("<II", image, dirs + 32, 0xE00, 24)      # security uses file offset
+        struct.pack_into("<II", image, dirs + 72, 0x2200, 40 if is_plus else 24)  # TLS
+        struct.pack_into("<II", image, dirs + 80, 0x2280, 0x90 if is_plus else 0x40)  # load config
+
+        pointer = "<Q" if is_plus else "<I"
+        width = 8 if is_plus else 4
+        # IMAGE_IMPORT_DESCRIPTOR, thunk, DLL name and hint/name.
+        struct.pack_into("<IIIII", image, 0x600, 0x2040, 0, 0, 0x2070, 0x20A0)
+        struct.pack_into(pointer, image, 0x640, 0x2090)
+        struct.pack_into(pointer, image, 0x640 + width, 0)
+        image[0x670:0x670 + 13] = b"KERNEL32.dll\0"
+        struct.pack_into("<H", image, 0x690, 0)
+        image[0x692:0x69E] = b"CreateFileW\0"
+        struct.pack_into(pointer, image, 0x6A0, 0x2090)
+        struct.pack_into(pointer, image, 0x6A0 + width, 0)
+
+        # TLS callback VA points into .text; callback list is null-terminated.
+        if is_plus:
+            struct.pack_into("<QQQQII", image, 0x800, 0, 0, 0, (0x140000000 + 0x2240), 0, 0)
+            struct.pack_into("<QQ", image, 0x840, 0x140001234, 0)
+        else:
+            struct.pack_into("<IIIIII", image, 0x800, 0, 0, 0, 0x402240, 0, 0)
+            struct.pack_into("<II", image, 0x840, 0x401234, 0)
+        struct.pack_into("<I", image, 0x880, 0x90 if is_plus else 0x40)
+        struct.pack_into(pointer, image, 0x880 + (0x58 if is_plus else 0x3C),
+                         (0x140000000 if is_plus else 0x400000) + 0x2300)
+
+        # Three resource directory levels: type 10 / name 7 / language 0x0409.
+        def resource_dir(offset: int, resource_id: int, child: int, child_is_dir: bool):
+            struct.pack_into("<IIHHHH", image, offset, 0, 0, 0, 0, 0, 1)
+            value = child | (0x80000000 if child_is_dir else 0)
+            struct.pack_into("<II", image, offset + 16, resource_id, value)
+        resource_dir(0xC00, 10, 0x18, True)
+        resource_dir(0xC18, 7, 0x30, True)
+        resource_dir(0xC30, 0x0409, 0x48, False)
+        struct.pack_into("<IIII", image, 0xC48, 0x3080, 15, 0, 0)
+        image[0xC80:0xC8F] = b"REA-RESOURCE-v1"
+
+        # WIN_CERTIFICATE payload, aligned security directory offset, no signature claim.
+        struct.pack_into("<IHH", image, 0xE00, 19, 0x0200, 0xFFFF)
+        image[0xE08:0xE13] = b"REA-CERT-v1"
+    image[0x200:0x204] = b"PEFX"
+    return bytes(image)
+
+
+def malformed_fixtures(base: bytes) -> dict[str, bytes]:
+    mismatch = bytearray(base)
+    struct.pack_into("<H", mismatch, 0x84, 0x8664)
+    out_of_range = bytearray(base)
+    # PE32 import data directory: RVA inválido, mas intervalo coerente em tamanho.
+    struct.pack_into("<II", out_of_range, 0x98 + 96 + 8, 0xFFFFFFF8, 0x20)
+    return {
+        "truncated_optional_header": base[:0xA0],
+        "machine_magic_mismatch": bytes(mismatch),
+        "out_of_range_import_rva": bytes(out_of_range),
+    }
+
+
+def over_budget_fixtures() -> dict[str, bytes]:
+    """Gera amostras válidas que excedem um limite padrão cada uma."""
+    imports = bytearray(pe_fixture(False, populated=True))
+    imports.extend(b"\0" * (0x4000 - len(imports)))
+    opt = 0x98
+    sections = opt + 0xE0
+    rdata = sections + 40
+    struct.pack_into("<H", imports, 0x86, 2)
+    struct.pack_into("<IIII", imports, rdata + 8, 0x3000, 0x2000, 0x3000, 0x600)
+    struct.pack_into("<I", imports, opt + 56, 0x5000)
+    dirs = opt + 96
+    descriptor_count = 257
+    descriptor_bytes = (descriptor_count + 1) * 20
+    thunk_offset = descriptor_bytes
+    name_offset = thunk_offset + descriptor_count * 8
+    for index in range(descriptor_count):
+        name = f"D{index:03}.dll\0".encode("ascii")
+        desc = 0x600 + index * 20
+        thunk = 0x2000 + thunk_offset + index * 8
+        name_rva = 0x2000 + name_offset + index * len(name)
+        struct.pack_into("<IIIII", imports, desc, 0, 0, 0, name_rva, thunk)
+        struct.pack_into("<II", imports, 0x600 + thunk_offset + index * 8, 0x80000001, 0)
+        start = 0x600 + name_offset + index * len(name)
+        imports[start:start + len(name)] = name
+    struct.pack_into("<II", imports, dirs + 8, 0x2000, descriptor_bytes)
+
+    certificates = bytearray(pe_fixture(False, populated=True))
+    cert_count = 9
+    for index in range(cert_count):
+        offset = 0xE00 + index * 16
+        struct.pack_into("<IHH", certificates, offset, 16, 0x0200, 0xFFFF)
+        certificates[offset + 8:offset + 16] = f"CERT{index:04}".encode("ascii")
+    struct.pack_into("<II", certificates, dirs + 32, 0xE00, cert_count * 16)
+
+    resources = bytearray(pe_fixture(False, populated=True))
+    entry_count = 16385
+    root = 0xC00
+    entries_offset = root + 16
+    data_offset = entries_offset + entry_count * 8
+    resource_size = 16 + entry_count * 24
+    raw_resource_size = (resource_size + 0x1FF) & ~0x1FF
+    resources.extend(b"\0" * (0xC00 + raw_resource_size - len(resources)))
+    rsrc = sections + 80
+    struct.pack_into("<IIII", resources, rsrc + 8, resource_size, 0x3000, raw_resource_size, 0xC00)
+    struct.pack_into("<I", resources, opt + 56, 0x3000 + ((resource_size + 0xFFF) & ~0xFFF))
+    struct.pack_into("<IIHHHH", resources, root, 0, 0, 0, 0, 0, entry_count)
+    for index in range(entry_count):
+        struct.pack_into("<II", resources, entries_offset + index * 8, index, data_offset - root + index * 16)
+        struct.pack_into("<IIII", resources, data_offset + index * 16, 0x1000, 4, 0, 0)
+    struct.pack_into("<II", resources, dirs + 16, 0x3000, resource_size)
+
+    callbacks = bytearray(pe_fixture(False, populated=True))
+    callback_count = 65
+    struct.pack_into(f"<{callback_count + 1}I", callbacks, 0x840, *([0x401234] * callback_count), 0)
+    return {
+        "imports_257_descriptors": bytes(imports),
+        "certificates_9_entries": bytes(certificates),
+        "resources_16385_entries": bytes(resources),
+        "callbacks_65": bytes(callbacks),
+    }
+
+
+class ReaPeContractTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="rea-pe-test-")
+        self.addCleanup(self.temp.cleanup)
+        self.tmp = Path(self.temp.name)
+        self.home = self.tmp / "home"
+        self.pkg = self.home / ".npm/_npx/fake/node_modules/rea-agents"
+        (self.pkg / "scripts").mkdir(parents=True)
+        (self.pkg / "package.json").write_text('{"version": "6.8.0"}\n', encoding="utf-8")
+        self.capture = self.tmp / "argv.json"
