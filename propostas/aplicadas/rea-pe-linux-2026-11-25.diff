+    def test_fixture_generators_are_deterministic_and_have_expected_pe_headers(self):
+        for is_plus, machine, magic, image_base in (
+            (False, 0x014C, 0x010B, 0x00400000), (True, 0x8664, 0x020B, 0x140000000),
+        ):
+            data = pe_fixture(is_plus)
+            self.assertEqual(data, pe_fixture(is_plus))
+            self.assertEqual(len(data), 0x400)
+            self.assertEqual(hashlib.sha256(data).hexdigest(), hashlib.sha256(pe_fixture(is_plus)).hexdigest())
+            self.assertEqual(data[:2], b"MZ")
+            self.assertEqual(struct.unpack_from("<H", data, 0x84)[0], machine)
+            self.assertEqual(struct.unpack_from("<H", data, 0x98)[0], magic)
+            base = struct.unpack_from("<Q" if is_plus else "<I", data, 0x98 + (24 if is_plus else 28))[0]
+            self.assertEqual(base, image_base)
+        bad = malformed_fixtures(pe_fixture())
+        self.assertEqual(set(bad), {"truncated_optional_header", "machine_magic_mismatch", "out_of_range_import_rva"})
+        self.assertLess(len(bad["truncated_optional_header"]), len(pe_fixture()))
+        self.assertEqual(struct.unpack_from("<H", bad["machine_magic_mismatch"], 0x84)[0], 0x8664)
+        self.assertEqual(struct.unpack_from("<I", bad["out_of_range_import_rva"], 0x98 + 96 + 8)[0], 0xFFFFFFF8)
