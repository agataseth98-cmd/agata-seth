+  local -a antes=() depois=()
+  local f tmp staged_frio
+  for f in "MEMÓRIAS.md" "MEMORIAS-MORNO.md"; do
+    if git show "HEAD:$f" >/dev/null 2>&1; then
+      tmp="$(mktemp)"; git show "HEAD:$f" > "$tmp"; antes+=("$tmp")
