+    grep -qi 'economia de tokens' <<<"$texto" || faltam="${faltam:+$faltam e }economia de tokens"
     # (26/10/2026, (849)) "todo modelo aberto em ~/agata usa as mesmas regras e as mesmas ferramentas":
