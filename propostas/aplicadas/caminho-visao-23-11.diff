diff --git a/scripts/perimetro/p27_atalhos_fonte.sh b/scripts/perimetro/p27_atalhos_fonte.sh
new file mode 100644
index 00000000..24244721
--- /dev/null
+++ b/scripts/perimetro/p27_atalhos_fonte.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+# P-27 (23/11/2026): atalho instalado em ~/.local/bin igual à fonte versionada que ele declara.
+# Motivo medido: em 23/11/2026 ~/.local/bin/fechar-agata estava diferente de redesign/systemd/seth-parar sem ninguém
+# perceber. O atalho roda a cópia instalada, não a do repositório; uma correção versionada pode nunca chegar ao uso.
+# Decisão do Humano, 18/11/2026: o sistema precisa se atualizar sozinho.
+#
+# Pares (instalado <- fonte): ~/.local/bin/agata <- redesign/systemd/seth
+#                             ~/.local/bin/fechar-agata <- redesign/systemd/seth-parar
+# A fonte de cada par é a que o próprio atalho declara na linha "# Fonte versionada: ..." (hoje ~/agata/redesign/systemd/...),
+# e o nome dela tem de bater com o do par. Assim a conferência não depende da worktree em que o perímetro roda.
+#
+# AVISA, nunca falha (mesma doutrina de P-6/P-9): diferença, ausência ou cabeçalho faltando viram AVISO com o comando
+# de reinstalar. Não copia nada sozinho; corrigir é decisão do Humano.
+p27_atalhos_fonte() {
+  local par nome fonte_nome inst decl fonte raiz padrao atencao=0 ok=""
+  raiz="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
+  for par in "agata:seth" "fechar-agata:seth-parar"; do
+    nome="${par%%:*}"
+    fonte_nome="${par##*:}"
+    inst="${HOME:-}/.local/bin/$nome"
+    padrao="$raiz/redesign/systemd/$fonte_nome"
+    if [ ! -f "$inst" ]; then
+      atencao=1
+      echo "AVISO (P-27): $inst não existe -- o atalho \"$nome\" não está instalado."
+      echo "  Por que importa: sem o atalho instalado, o comando não faz o que o repositório manda."
+      echo "  O que fazer: cp $padrao $inst && chmod +x $inst"
+      continue
+    fi
+    decl="$(sed -n 's/^# Fonte versionada: *//p' "$inst" | head -n1 | tr -d '\r' | sed 's/[[:space:]]*$//')"
+    if [ -z "$decl" ]; then
+      atencao=1
+      echo "AVISO (P-27): $inst não tem a linha \"# Fonte versionada: ...\" -- não dá para conferir contra a fonte."
+      echo "  Por que importa: sem a fonte declarada, uma diferença fica invisível."
+      echo "  O que fazer: cp $padrao $inst   (a cópia do repositório traz a linha)"
+      continue
+    fi
+    case "$decl" in
+      "~/"*) fonte="${HOME:-}/${decl#"~/"}" ;;
+      *) fonte="$decl" ;;
+    esac
+    if [ "$(basename "$fonte")" != "$fonte_nome" ]; then
+      atencao=1
+      echo "AVISO (P-27): $inst declara como fonte $fonte, que não é $fonte_nome."
+      echo "  Por que importa: o par do atalho não confere; a comparação sairia contra o arquivo errado."
+      echo "  O que fazer: corrija a linha \"# Fonte versionada\" do atalho para redesign/systemd/$fonte_nome, ou reinstale: cp $padrao $inst"
+      continue
+    fi
+    if [ ! -f "$fonte" ]; then
+      atencao=1
+      echo "AVISO (P-27): a fonte declarada por $inst não existe: $fonte"
+      echo "  Por que importa: sem a fonte, não há como saber se o atalho está atualizado."
+      echo "  O que fazer: confira o checkout do sistema; a fonte versionada é redesign/systemd/$fonte_nome."
+      continue
+    fi
+    if cmp -s "$inst" "$fonte"; then
+      ok="$ok $nome"
+      continue
+    fi
+    atencao=1
+    echo "AVISO (P-27): $inst difere da fonte versionada $fonte."
+    echo "  Por que importa: o atalho roda a cópia instalada, não a do repositório; uma correção versionada pode nunca chegar ao uso."
+    echo "  O que fazer: cp $fonte $inst"
+  done
+  if [ "$atencao" -eq 0 ]; then
+    echo "OK (P-27): atalhos instalados iguais às fontes versionadas:$ok."
+    return 0
+  fi
+  set -- $ok
+  echo "P-27: $# de 2 atalho(s) iguais à fonte versionada; os demais têm AVISO acima."
+  PERIMETRO_ESTADO="PARCIAL"
+  return 0
+}
diff --git a/scripts/testar_ci_progresso.py b/scripts/testar_ci_progresso.py
new file mode 100644
index 00000000..9c2d7359
--- /dev/null
+++ b/scripts/testar_ci_progresso.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Testes do progresso do CI local (Regra 0, decisão do Humano 18/11/2026).
+
+Cada linha OK/FALHA de scripts/ci_sdd_local.sh traz "[n/total · tempo]". O total é contado
+no próprio script (passada sem executar comandos), nunca escrito à mão. Estes testes conferem:
+o formato do marcador, o formato da linha OK/FALHA (prefixo preservado), e que o total contado
+bate com as chamadas `passo` que o código realmente tem (inclusive as do laço `for`).
+Não roda o CI inteiro: só a passada de contagem (CI_SO_CONTAR=1), que não executa passo nenhum.
+"""
+import os
+import pathlib
+import re
+import subprocess
+import sys
+import tempfile
+import unittest
+
+RAIZ = pathlib.Path(__file__).resolve().parent.parent
+CI = RAIZ / "scripts" / "ci_sdd_local.sh"
+
+
+def _ambiente(extra=None):
+    # GIT_* herdado de um hook apontaria o script para outro repositório.
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(extra or {})
+    return env
+
+
+def _chamadas_no_codigo():
+    """Conta as chamadas `passo "..."` do código: as de fora de laço valem 1; as de dentro de
+    `for ... in <palavras>; do ... done` valem <palavras> vezes. Não usa o número do script."""
+    total = 0
+    bloco = None  # [palavras do laço, chamadas dentro do laço]
+    for linha in CI.read_text(encoding="utf-8").splitlines():
+        s = linha.strip()
+        m = re.match(r"^for \w+ in (.+); do$", s)
+        if m:
+            bloco = [len(m.group(1).split()), 0]
+            continue
+        if s == "done" and bloco is not None:
+            total += bloco[0] * bloco[1]
+            bloco = None
+            continue
+        if re.match(r'^passo "', s):
+            if bloco is None:
+                total += 1
+            else:
+                bloco[1] += 1
+    if bloco is not None:
+        raise AssertionError("laço for sem done em ci_sdd_local.sh")
+    return total
+
+
+class MarcadorTests(unittest.TestCase):
+    def _marca(self, n, total, seg):
+        r = subprocess.run(
+            ["bash", "-c", 'source "$1"; _ci_marca "$2" "$3" "$4"', "bash", str(CI), str(n), str(total), str(seg)],
+            capture_output=True, text=True, env=_ambiente(), check=True,
+        )
+        return r.stdout.strip()
+
+    def test_minutos_e_segundos_com_dois_digitos(self):
+        self.assertEqual(self._marca(12, 92, 64), "[12/92 · 1m04s]")
+
+    def test_zero_segundos(self):
+        self.assertEqual(self._marca(1, 3, 0), "[1/3 · 0m00s]")
+
+    def test_mais_de_uma_hora_mantem_minutos(self):
+        self.assertEqual(self._marca(90, 92, 3725), "[90/92 · 62m05s]")
+
+
+class LinhaDePassoTests(unittest.TestCase):
+    def test_tempo_e_o_do_fim_do_passo(self):
+        # a linha sai quando o passo termina: um passo de 2 s, começando agora, tem de mostrar ~2 s (e não 0 s)
+        script = (
+            'source "$1"\n'
+            'TMP="$(mktemp -d)"; FALHAS=0; CI_TOTAL=1; CI_INICIO="$(date +%s)"\n'
+            'passo "lento" sleep 2\n'
+            'rm -rf "$TMP"\n'
+        )
+        r = subprocess.run(["bash", "-c", script, "bash", str(CI)], capture_output=True, text=True,
+                           env=_ambiente(), check=True)
+        self.assertEqual(r.stdout.splitlines()[0], "  ... [1/1] lento")  # anúncio do início (Regra 0)
+        self.assertRegex(r.stdout.splitlines()[1], r"^OK    \[1/1 · 0m0[23]s\] lento$")
+
+    def test_ok_e_falha_trazem_progresso_e_prefixo_preservado(self):
+        script = (
+            'source "$1"\n'
+            'TMP="$(mktemp -d)"; FALHAS=0; CI_TOTAL=3; CI_INICIO=$(( $(date +%s) - 64 ))\n'
+            'passo "um passo" true\n'
+            'passo "outro passo" false\n'
+            'passo "terceiro" true\n'
+            'echo "FALHAS=$FALHAS"\n'
+            'echo "PASSOS=${CI_PASSOS[*]}"\n'
+            'rm -rf "$TMP"\n'
+        )
+        r = subprocess.run(["bash", "-c", script, "bash", str(CI)], capture_output=True, text=True,
+                           env=_ambiente(), check=True)
+        # o anúncio de início ("  ... [n/total] nome") sai antes de cada passo; aqui só as linhas de resultado
+        linhas = [l for l in r.stdout.splitlines() if not l.startswith("  ... ")]
+        # o tempo pode virar 1m05s se a fronteira do segundo cair no meio da execução
+        self.assertRegex(linhas[0], r"^OK    \[1/3 · 1m0[45]s\] um passo$")
+        self.assertRegex(linhas[1], r"^FALHA \[2/3 · 1m0[45]s\] outro passo$")
+        self.assertRegex(linhas[-3], r"^OK    \[3/3 · 1m0[45]s\] terceiro$")
+        self.assertIn("FALHAS=1", linhas)
+        self.assertIn("PASSOS=um passo|1 outro passo|0 terceiro|1", linhas)
+
+
+class ContagemTests(unittest.TestCase):
+    def test_total_bate_com_as_chamadas_do_codigo(self):
+        esperado = _chamadas_no_codigo()
+        self.assertGreater(esperado, 50, "a conta do código não pode dar um número trivial")
+        with tempfile.TemporaryDirectory() as d:
+            env = _ambiente({
+                "CI_SO_CONTAR": "1",
+                "AGATA_CI_DIR": d,
+                # a contagem não executa o pytest; só precisa de um valor não vazio
+                "PYTEST": os.environ.get("PYTEST") or sys.executable,
+            })
+            r = subprocess.run(["bash", str(CI)], capture_output=True, text=True, env=env,
+                               cwd=str(RAIZ), timeout=120)
+            self.assertEqual(r.returncode, 0, r.stderr)
+            self.assertEqual(int(r.stdout.strip()), esperado)
+            self.assertFalse((pathlib.Path(d) / "ultimo.json").exists(),
+                             "a passada de contagem não grava o resumo do CI")
+
+    def test_laco_conta_cada_iteracao(self):
+        # o laço "for c in ..." do script tem duas chamadas por item: a conta tem de multiplicar
+        texto = CI.read_text(encoding="utf-8")
+        m = re.search(r"^for \w+ in (.+); do$", texto, re.M)
+        self.assertIsNotNone(m, "o script deve ter um laço for com lista de componentes")
+        palavras = len(m.group(1).split())
+        self.assertGreaterEqual(palavras, 2)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/scripts/testar_p10_worktree.sh b/scripts/testar_p10_worktree.sh
new file mode 100644
index 00000000..528fc8e9
--- /dev/null
+++ b/scripts/testar_p10_worktree.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+# Contraprovas offline do P-10 em worktree vinculada (23/11/2026). Sem vault, a worktree não é "clone fresco":
+# é SKIP isento (PERIMETRO_P17_ISENTO=1), que o P-17 não conta. No checkout principal, sem vault, continua
+# SKIP comum (não isento). Com o vault presente na worktree, a conferência roda de verdade (não vira SKIP).
+# Repositório descartável em $TMP. Saída 0 = todos os casos passaram.
+set -u
+unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
+      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE
+RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+# shellcheck source=/dev/null
+source "$RAIZ/scripts/perimetro/p10_vault_derivado.sh"
+falhas=0
+caso() { if eval "$2"; then echo "PASS  $1"; else echo "FALHA $1"; falhas=$((falhas + 1)); fi; }
+
+PRINCIPAL="$TMP/principal"
+VINCULADA="$TMP/vinculada"
+git init -q "$PRINCIPAL"
+git -C "$PRINCIPAL" -c user.name=teste -c user.email=teste@teste commit -q --allow-empty -m base
+git -C "$PRINCIPAL" worktree add -q -b teste-p10-worktree "$VINCULADA" 2>/dev/null
+
+# roda o P-10 dentro de um diretório, do jeito que o perímetro roda (na raiz do checkout)
+rodar_p10() {  # $1 = diretório
+  (
+    cd "$1" || exit 9
+    PERIMETRO_ESTADO=""; PERIMETRO_P17_ISENTO=0
+    p10_vault_derivado
+    rc=$?
+    echo "ESTADO=$PERIMETRO_ESTADO ISENTO=$PERIMETRO_P17_ISENTO RC=$rc"
+  )
+}
+
+# 1. checkout principal, sem vault: SKIP comum (clone fresco), não isento
+saida="$(rodar_p10 "$PRINCIPAL")"
+caso "principal sem vault: SKIP comum, não isento" 'printf "%s" "$saida" | grep -q "ESTADO=SKIP ISENTO=0 "'
+caso "principal sem vault: mensagem de clone fresco, não de worktree" 'printf "%s" "$saida" | grep -q "ainda não existe" && ! printf "%s" "$saida" | grep -q "worktree vinculada"'
+
+# 2. worktree vinculada, sem vault: SKIP isento, com a explicação
+saida="$(rodar_p10 "$VINCULADA")"
+caso "worktree sem vault: SKIP isento" 'printf "%s" "$saida" | grep -q "ESTADO=SKIP ISENTO=1 RC=0"'
+
+# 3. worktree vinculada com vault presente: a conferência roda, não é SKIP isento
+mkdir -p "$VINCULADA/memoria/obsidian"
+saida="$(rodar_p10 "$VINCULADA")"
+caso "worktree com vault: não vira SKIP isento" '! printf "%s" "$saida" | grep -q "ISENTO=1"'
+caso "worktree com vault: a conferência de fato roda (não é SKIP)" '! printf "%s" "$saida" | grep -q "ESTADO=SKIP"'
+rm -rf "$VINCULADA/memoria"
+
+# 4. o detector: principal não é vinculada; worktree é
+caso "detector: principal não é worktree vinculada" '! (cd "$PRINCIPAL" && _p10_worktree_vinculada)'
+caso "detector: worktree é vinculada" '(cd "$VINCULADA" && _p10_worktree_vinculada)'
+
+[ "$falhas" -eq 0 ] && echo "P-10 worktree: OK" || echo "P-10 worktree: $falhas FALHA(S)"
+exit "$falhas"
