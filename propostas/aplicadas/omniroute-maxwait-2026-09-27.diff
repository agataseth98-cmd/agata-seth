diff --git a/redesign/systemd/dropin-omniroute-resilience.conf b/redesign/systemd/dropin-omniroute-resilience.conf
new file mode 100644
index 0000000..15d81d9
--- /dev/null
+++ b/redesign/systemd/dropin-omniroute-resilience.conf
@@ -0,0 +1,25 @@
+# Agata -- OmniRoute: RATE_LIMIT_MAX_WAIT_MS, o único jeito determinístico
+# e versionável de reproduzir o conserto de MEMÓRIAS (363) sem UI.
+#
+# Contexto: em 08/09/2026, requestQueue.maxWaitMs foi subido de 15000 pra
+# 45000 pela UI (PATCH /api/resilience) pra corrigir 504 do OmniRoute
+# (MEMÓRIAS (362)/(363)). Isso grava direto em ~/.omniroute/storage.sqlite
+# (tabela key_value, namespace "settings", chave "resilienceSettings",
+# JSON sem cifra) -- um clone novo, com banco vazio, nasce com o padrão
+# de fábrica (15000) e reproduz o mesmo 504.
+#
+# Achado do laboratório "Ensaio" (26/09/2026), lendo o código-fonte real
+# do pacote (`npm pack omniroute@3.8.50`), confirmado por mim lendo o
+# mesmo trecho: `src/lib/resilience/settings.ts`,
+# DEFAULT_REQUEST_QUEUE_MAX_WAIT_MS = Number(process.env.RATE_LIMIT_MAX_WAIT_MS
+# || "15000"). O valor gravado no banco SEMPRE vence o da variável
+# (resolveResilienceSettings: `current` antes de `fallback`) -- então
+# aplicar este drop-in numa Máquina que já tem o valor no banco (como
+# esta) não muda nada; só garante o padrão certo pra um clone que nasce
+# com banco vazio.
+#
+# Instala com: `cp dropin-omniroute-resilience.conf
+# ~/.config/systemd/user/omniroute.service.d/resiliencia.conf` (sem sudo,
+# unit de --user) + `systemctl --user daemon-reload` + restart.
+[Service]
+Environment=RATE_LIMIT_MAX_WAIT_MS=45000
