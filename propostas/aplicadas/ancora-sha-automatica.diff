+
+# Âncora de SHA em PROMPT_CARREGAMENTO.md (item 2, 20/08/2026, ordem do
+# Humano). Sempre o SHA do HEAD ANTES deste commit -- um commit não pode
+# embutir o próprio SHA (auto-referência), então fica até 1 commit
+# atrasado, nunca mais, e isso está documentado no próprio arquivo.
+# Falha aqui só avisa, nunca bloqueia o commit -- não é um controle de
+# segurança, é conveniência pra sessões só-HTTP.
+if [ -f PROMPT_CARREGAMENTO.md ]; then
+  HEAD_ANTERIOR=$(git rev-parse HEAD 2>/dev/null || echo "")
+  if [ -n "$HEAD_ANTERIOR" ]; then
+    AGORA=$(date '+%d/%m/%Y %H:%M %z' | sed -E 's/([+-][0-9]{2})00$/\1/')
+    if python3 scripts/atualizar_ancora_prompt.py PROMPT_CARREGAMENTO.md "$HEAD_ANTERIOR" "$AGORA"; then
+      git add PROMPT_CARREGAMENTO.md
+    else
+      echo "pre-commit: AVISO -- não consegui atualizar a âncora de SHA em PROMPT_CARREGAMENTO.md" >&2
+    fi
+  fi
+fi
