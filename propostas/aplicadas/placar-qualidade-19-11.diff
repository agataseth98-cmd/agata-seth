+    return out, avisos
+
+
+def nota_final(nota_ajustada: float, c: dict | None) -> float:
+    if not c or c.get("nota") is None:
+        return round(min(nota_ajustada, TETO_NAO_MEDIDO), 4)
+    return round(0.5 * nota_ajustada + 0.5 * c["nota"], 4)
