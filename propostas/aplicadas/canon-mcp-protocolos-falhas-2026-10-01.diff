+// Mesmo slug de scripts/gerar_obsidian.py::slug() -- a nota de um script NÃO
+// mora no caminho literal (achado 01/10/2026: a Seth pediu "scripts/
+// estado_para_eco.sh", a ferramenta prefixava memoria/obsidian/ ao caminho
+// cru e dava 404 -- o arquivo real é memoria/obsidian/scripts/script-estado-
+// -para-eco-sh.md). Ordem das transformações tem que bater exatamente com o
+// Python: "." -> "-" ANTES de remover não-[\w\s-], prefixo "script-" DEPOIS
+// do corte de 60 chars. Sem o colisor `_slugs` do gerador (SEM colisão
+// hoje, lista fixa de scripts) -- se um nome novo colidir, esta tradução
+// erra, e vault_consultar cai no 404 de novo (fail-soft: só essa consulta).
+function scriptSlug(nome) {
+  let s = nome.normalize("NFKD").replace(/[̀-ͯ]/g, "");
+  s = s.replace(/\./g, "-");
+  s = s.replace(/[^\w\s-]/g, "").trim().toLowerCase();
+  s = s.replace(/[\s_-]+/g, "-").slice(0, 60).replace(/^-+|-+$/g, "") || "x";
+  return "script-" + s;
+}
