+
+class MedicoesTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.dir = tempfile.TemporaryDirectory()
+        cls.env = mock.patch.dict(os.environ, {"AGATA_MEDICOES_DIR": cls.dir.name}); cls.env.start()
