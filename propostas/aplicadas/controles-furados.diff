+# --- Guarda de codificacao (achado 04/09/2026, sessao Claude Code na nuvem) ---
+# Este gerador reconhece entrada de MEMORIAS por rotulo ACENTUADO (DIÁRIO,
+# CORREÇÃO) e separador em travessão. Num ambiente sem locale UTF-8, ou com um
+# awk nao-multibyte (mawk, padrao de Debian/Ubuntu), os
+# regex de `grep -E` e do `awk` da janela deixam de casar essas linhas -- e o
+# script NAO falha: escreve um .hidrata.md e um INDICE_MEMORIAS.md
+# silenciosamente truncados, comecando na entrada ASCII mais antiga ((276),
+# escrita sem acento pelo Qwen). Medido de verdade, nao teorico: mawk 1.3.4 +
+# LC_ALL=POSIX derrubou o indice de 329 para 78 linhas e a janela de
+# hidratacao de (316)..(312) para (276)..(264) -- exatamente a classe de falha
+# de MEMORIAS (248)-(252), hidratacao errada que se le coerente. Silencio alto,
+# entao: aborta antes de escrever qualquer byte, nunca gera pela metade.
+_LINHA_TESTE='(0) DIÁRIO — 01/01/2026 · guarda de codificação'
+if ! printf '%s\n' "$_LINHA_TESTE" | grep -qE '^\([0-9]+\) (DI[AÁ]RIO|CONSELHO|MOD[^—-]*|CORRE[CÇ][AÃ]O) [—-] [0-9]{2}/[0-9]{2}/[0-9]{4}'; then
+  echo "gerar-hidratacao: ABORTADO -- o 'grep' deste ambiente nao casa rotulo acentuado (locale sem UTF-8?). Rode com LANG/LC_ALL em UTF-8. Nada foi escrito." >&2
+  exit 1
+fi
+if ! printf '%s\n' "$_LINHA_TESTE" | awk '/^\([0-9]+\) (DI[AÁ]RIO|CONSELHO|MOD|CORRE[CÇ][AÃ]O)/ { ok=1 } END { exit !ok }'; then
+  echo "gerar-hidratacao: ABORTADO -- o 'awk' deste ambiente nao casa rotulo acentuado (mawk?). Use um awk multibyte (gawk). Nada foi escrito." >&2
+  exit 1
+fi
+unset _LINHA_TESTE
+
 OUT=".hidrata.md"
 INDICE="INDICE_MEMORIAS.md"
 # Índice paralelo com palavras-chave por entrada (grep, nunca embedding --
