diff --git a/redesign/systemd/agata-jogo b/redesign/systemd/agata-jogo
index 4ec1b3e..821e38c 100644
--- a/redesign/systemd/agata-jogo
+++ b/redesign/systemd/agata-jogo
@@ -57,10 +57,23 @@ if [ "$#" -eq 0 ]; then
   exit 0
 fi
 
+# GPU: em MUX hibrido (iGPU Intel + dGPU NVIDIA, as duas no lspci) o painel esta
+# ligado na Intel, entao o jogo SO usa a RTX 4060 com PRIME render offload --
+# sem isso ele roda na iGPU. `prime-run` (pacote nvidia-prime) junta as env
+# vars. Em "Discrete only" (so a NVIDIA aparece no lspci) este bloco fica vazio
+# e nao muda nada. (10/09/2026)
+_pr=()
+if command -v prime-run >/dev/null 2>&1 \
+   && lspci -nn 2>/dev/null | grep -qiE 'VGA.*Intel' \
+   && lspci -nn 2>/dev/null | grep -qiE '(VGA|3D).*NVIDIA'; then
+  _pr=(prime-run)
+  echo "agata-jogo: MUX hibrido -- offload pra RTX 4060 via prime-run" >&2
+fi
+
 if command -v game-performance >/dev/null 2>&1; then
   echo "agata-jogo: lancando via game-performance (power-profiles-daemon -> performance)" >&2
-  game-performance "$@"
+  game-performance "${_pr[@]}" "$@"
 else
   echo "agata-jogo: game-performance ausente -- lancando direto" >&2
-  "$@"
+  "${_pr[@]}" "$@"
 fi
diff --git a/redesign/systemd/seth b/redesign/systemd/seth
index ef0387f..a29b494 100755
--- a/redesign/systemd/seth
+++ b/redesign/systemd/seth
@@ -1,6 +1,7 @@
 #!/usr/bin/env bash
-# Inicia a Seth para CONVERSA (LibreChat). Sobe a espinha + o gateway + a stack
-# do LibreChat + a voz, espera responder e abre o navegador.
+# Inicia a Seth para CONVERSA (LibreChat). Sobe a espinha INTEIRA (agata.target)
+# + o gateway + a stack do LibreChat + a voz, espera responder e abre o navegador.
+# Contraparte de `seth-parar` (que para tudo). O MoE :20129 continua sob demanda.
 # Fonte versionada: ~/agata/redesign/systemd/seth
 set -e
 LC=~/librechat/docker-compose.yml
diff --git a/redesign/systemd/seth-parar b/redesign/systemd/seth-parar
index b6f347d..87dfba2 100755
--- a/redesign/systemd/seth-parar
+++ b/redesign/systemd/seth-parar
@@ -1,5 +1,8 @@
 #!/usr/bin/env bash
-# Para os frentes da Seth e libera recursos. Mantem a espinha (agata.target).
+# Para a Seth INTEIRA: as frentes E a espinha (agata.target). Libera todos os
+# recursos -- inclusive a VRAM da RTX 4060 e os modelos carregados no Ollama.
+# (Ordem do Humano 10/09/2026: "parar Seth parando tudo". Antes parava so as
+# frentes e mantinha a espinha de pe.)
 # Fonte versionada: ~/agata/redesign/systemd/seth-parar
 LC=~/librechat/docker-compose.yml
 docker compose -f "$LC" stop >/dev/null 2>&1 || true
@@ -7,4 +10,14 @@ docker stop kokoro-tts >/dev/null 2>&1 || true
 systemctl --user stop piper-tts.service 2>/dev/null || true
 systemctl --user stop seth-gateway.service seth-escriba.service seth-verificador.service 2>/dev/null || true
 systemctl --user stop discord-mcp.service navegador-mcp.service 2>/dev/null || true
-notify-send -a Seth "Seth" "frentes parados (espinha segue de pe)" 2>/dev/null || true
+# descarrega os modelos ativos do Ollama de producao (:11434) -- sem sudo, nao
+# mexe no ollama.service
+if command -v ollama >/dev/null 2>&1; then
+  ollama ps 2>/dev/null | awk 'NR>1 && $1 != "" {print $1}' | while read -r _m; do
+    [ -n "$_m" ] && ollama stop "$_m" 2>/dev/null || true
+  done
+fi
+# espinha: no stop o agata-drain roda antes e drena o WAL -> nunca corta no meio
+# de um commit. Derruba os 5 servicos + o MoE :20129 (libera a VRAM).
+systemctl --user stop agata.target 2>/dev/null || true
+notify-send -a Seth "Seth" "parada por completo (frentes + espinha)" 2>/dev/null || true
