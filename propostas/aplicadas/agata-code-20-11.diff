+def _rodar_opencode(cmd: list, pasta: Path, transcricao: Path, timeout_s: float, cancelar) -> str | None:
+    """Roda o agente com a saída (eventos json) direto no arquivo. Devolve None se terminou, ou o motivo (tempo/cancelado)."""
