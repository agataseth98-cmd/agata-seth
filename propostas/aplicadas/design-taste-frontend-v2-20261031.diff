+/* tasteskill / app.css
+   A neutral foundation for app screens (dashboards, admin, settings, inboxes), set to the defaults
+   measured in the study of real product screens (references/app-screens.md). Copy it into the project,
+   replace the token values with the ones on the app sheet (draw.mjs --app), and build on top.
+   Delete what you do not use. It has no brand of its own: neutral grounds, one quiet line, one accent. */
+
+/* ---------- tokens (replace with the dealt style) ---------- */
+:root {
+  /* names match the app sheet printed by draw.mjs --app */
+  --ground: #f9fafb;          /* the app chrome and page */
+  --surface: #ffffff;         /* panels and the work sheet */
+  --raised: #f4f5f6;          /* a filled inner well, hover rows */
+  --active: #eeeeee;          /* the active nav pill */
+  --border: #e8e8e8;          /* panel edges: about 1.2:1 on white */
+  --rule: #f1f2f3;            /* row rules inside tables */
+  --control: #d1d5db;         /* inputs and outlined buttons: one step stronger */
+  --text: #111111;
+  --muted: #5f6368;           /* secondary text, labels (4.5:1 or more on its ground) */
+  --faint: #6b6b6b;           /* meta and placeholders: the lightest grey that holds 4.5:1 on white */
+  --accent: #1f6f5c;          /* one hue: data, focus, the selected thing */
+  --primary: #1d1f20;         /* the primary button is near-black unless the style says otherwise */
+  --primary-ink: #ffffff;
+  --positive: #247b50; --negative: #c4242a; --warning: #92400e;  /* references/app-screens.md §9.5; a green accent is also --positive */
+  --pill-positive-bg: #dcfae5; --pill-positive-ink: #04250e;
+  --pill-negative-bg: #ffedea; --pill-negative-ink: #831c1e;
+  --pill-warning-bg: #fffbeb; --pill-warning-ink: #92400e;
+  --pill-neutral-bg: #eeeeee; --pill-neutral-ink: #3d3d3d;
+  --chart-1: var(--accent); --chart-2: #8fb8ad; --chart-3: #b08a2e; --chart-muted: #cfd3d6;
+  --chart-mark: var(--text);  /* a marked period in Charts.diverging: the second tone */
+  --chart-span: 0.06;         /* opacity of a shaded span (a selling window, an outage) */
+  --grid: var(--rule);        /* chart gridlines (charts.js) */
+  --axis-ink: var(--muted);   /* chart tick labels (charts.js) */
+  --ink: var(--text);
+
+  --font: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
+  --fs-title: 24px; --fs-section: 16px; --fs-kpi: 28px; --fs-body: 14px; --fs-small: 12px;
+
+  --sidebar-width: 232px;
+  --pad: 24px;                /* canvas padding */
+  --gap: 16px;                /* one gutter, horizontal and vertical */
+  --card-pad: 20px;
+  --radius-card: 8px;         /* radius is bimodal: tight 4–8 (controls 6) or soft 16–24 (controls full); never 11–12 */
+  --radius-control: 6px;
+  --control-height: 32px;     /* every control in the title and filter rows */
+  --row-height: 48px;         /* single-line table row */
+  --nav-row: 32px;            /* sidebar item height, on a 34px pitch */
