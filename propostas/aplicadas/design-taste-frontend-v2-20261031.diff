+    for (const [k, v] of Object.entries(t)) {
+      if (k === 'font' || k === 'density') continue;
+      if (typeof v === 'string') p(`  --${kebab(k)}: ${v};`);
+      else if (typeof v === 'number') p(`  --${kebab(k)}: ${v}px;`);
