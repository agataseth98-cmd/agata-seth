+# B8 / ISO-05 (auditoria de Marcos; MEMORIAS (532)): a app NAO usa mais
+# network_mode:host -- antes ela enxergava TODA a rede local da Maquina (qualquer
+# porta), nao so as que precisa. Agora fica na bridge `librechat` (subnet fixa
+# 172.29.7.0/24) e so alcanca a Maquina pelo `librechat-ponte-host`: um container
+# minusculo (socat, sem interpretador de proposito geral) em network_mode:host que
+# encaminha SO as 7 portas que a app usa, a partir do gateway da bridge (172.29.7.1):
+#   20126 seth_gateway · 8890 piper-tts · 27125 obsidian-ro-proxy (canon)
+#   20135 discord-mcp · 20136 navegador-mcp · 20140 seth_escriba · 20141 seth_verificador
+# A tentativa de 21/09 cobria 4 e esqueceu escriba/verificador/piper -- e o
+# librechat.yaml meio-convertido derrubou a Seth em 22/09 ((517)). Porta nova que a
+# app precise = entra aqui E no librechat.yaml, nos dois, no mesmo commit.
+# Mongo/Meili: a app fala com eles pelo NOME do servico, dentro da bridge.
 #
 # restart:"no" em tudo -- nada sobe no boot. Os atalhos `seth` / `Parar Seth` controlam.
 # Fonte versionada: ~/agata/redesign/librechat/docker-compose.yml
@@ -36,6 +45,21 @@ services:
     volumes:
       - librechat-meili-data:/meili_data
 
+  librechat-ponte-host:
+    container_name: librechat-ponte-host
+    image: alpine/socat:1.8.0.1
+    restart: "no"
+    network_mode: host
+    depends_on:
+      - librechat-mongodb
+    entrypoint: ["/bin/sh", "-c"]
+    command:
+      - |
+        for p in 20126 8890 27125 20135 20136 20140 20141; do
+          socat TCP-LISTEN:$$p,bind=172.29.7.1,fork,reuseaddr TCP:127.0.0.1:$$p &
+        done
+        wait
+
