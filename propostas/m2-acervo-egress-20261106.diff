+++ b/redesign/alexandria/tests/test_egress_userinfo.py
@@ -0,0 +1,27 @@
+import sys
+import unittest
+from pathlib import Path
+
+AQUI = Path(__file__).resolve().parent
+sys.path.insert(0, str(AQUI.parent.parent.parent / "scripts"))
+import politica_egress  # noqa: E402
+
+
+class UserinfoTests(unittest.TestCase):
+    """A checagem de userinfo roda antes de qualquer DNS: estes testes não usam rede."""
+
+    def test_url_com_usuario_e_senha_e_recusada(self):
+        _h, _p, _ips, motivo = politica_egress._resolver_destino("https://user:senha@exemplo.invalid/p")
+        self.assertIn("userinfo", motivo)
+
+    def test_url_so_com_usuario_tambem_e_recusada(self):
+        _h, _p, _ips, motivo = politica_egress._resolver_destino("https://token@exemplo.invalid/")
+        self.assertIn("userinfo", motivo)
+
+    def test_url_sem_userinfo_nao_cai_nessa_regra(self):
+        _h, _p, _ips, motivo = politica_egress._resolver_destino("https://exemplo.invalid/p")
+        self.assertNotIn("userinfo", motivo)
+
+
+if __name__ == "__main__":
+    unittest.main()
