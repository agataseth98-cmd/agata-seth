     echo ""
     resumo_entradas_mais_antigas "$_janela_txt"
-  } > "$out"
+  } | sed "s/{{NOME_SISTEMA}}/$NOME_SISTEMA_SED/g" > "$out"
 }
 
 montar_hermes "" "$OUT"
