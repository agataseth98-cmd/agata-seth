@@ -28,6 +28,20 @@ if ! printf '%s\n' "$_LINHA_TESTE" | awk '/^\([0-9]+\) (DI[AÁ]RIO|CONSELHO|MOD|
 fi
 unset _LINHA_TESTE
 
+# --- Nome do sistema (Fase 2, plano de replicabilidade, 25/09/2026) ---
+# REGRAS.md carrega o token {{NOME_SISTEMA}} nos ~5 pontos onde o nome
+# falado aparece (nunca nos caminhos/serviços internos -- aqueles continuam
+# "agata" por desenho, ver propostas/plano-replicabilidade-2026-09-25.md).
+# Resolvido aqui, na saída gerada -- REGRAS.md em si fica byte-idêntico ao
+# framework oficial, sem conflito de merge numa atualização (Fase 5).
+# Sem ~/.config/agata/identidade.env (o caso de hoje, nesta Máquina): cai em
+# "Agata", .hidrata.md sai byte a byte igual ao que saía antes desta mudança.
+_IDENTIDADE="$HOME/.config/agata/identidade.env"
+NOME_SISTEMA="$(sed -n 's/^NOME_SISTEMA=//p' "$_IDENTIDADE" 2>/dev/null | head -1)"
+NOME_SISTEMA="${NOME_SISTEMA:-Agata}"
+# escapa pra uso seguro dentro de s/// do sed (barra, &, barra invertida)
+NOME_SISTEMA_SED="$(printf '%s' "$NOME_SISTEMA" | sed -e 's/[\/&\\]/\\&/g')"
+
 OUT=".hidrata.md"
 INDICE="INDICE_MEMORIAS.md"
 # Índice paralelo com palavras-chave por entrada (grep, nunca embedding --
@@ -495,7 +509,7 @@ montar_hermes() {
