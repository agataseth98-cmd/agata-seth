+def nome_nuvem(rota: dict) -> str:
+    """Nome da rota de nuvem no OmniRoute (provedor/modelo, ex.: nvidia/poolside/laguna-xs-2.1) e no painel."""
+    return f"{rota['provedor']}/{rota['modelo']}"
