--- a/scripts/perimetro/p08_quarentena.sh
+++ b/scripts/perimetro/p08_quarentena.sh
@@ -37,6 +37,25 @@
 # residual registrado sem suavizar: o marcador é um arquivo que o
 # próprio executor tem permissão técnica de criar -- P-8 impede
 # automação agindo sem ninguém perceber, não impede contorno deliberado.
+# --- Gênese (MEMÓRIAS (564)/(565)) ----------------------------------------
+# O 1º commit de um repo recém-nascido não tem HEAD contra o qual o P-8
+# compare nem pai para o P-16 testar. A exceção é MECÂNICA, não uma flag:
+# vale só quando o repositório nunca teve commit nenhum. Três provas juntas:
+#   1. não há HEAD;
+#   2. não há ref nenhuma (fecha `git checkout --orphan` num repo existente,
+#      que também fica sem HEAD);
+#   3. não há objeto de commit nenhum no banco de objetos (fecha apagar todas
+#      as refs à mão para "renascer" um repo que já teve história).
+# P-1 e P-20 NÃO usam isto: no nascimento tudo está staged, então eles
+# varrem a árvore inteira -- é o único momento em que isso acontece.
+_perimetro_eh_genese() {
+  git rev-parse --verify --quiet HEAD >/dev/null 2>&1 && return 1
+  [ -n "$(git for-each-ref --count=1 2>/dev/null)" ] && return 1
+  git cat-file --batch-all-objects --batch-check='%(objecttype)' 2>/dev/null \
+    | grep -qx commit && return 1
+  return 0
+}
+
 _p8_eh_comportamento() {
   case "$1" in
     REGRAS.md|PROJETO.md|scripts/*|.githooks/*|config/*) return 0 ;;
