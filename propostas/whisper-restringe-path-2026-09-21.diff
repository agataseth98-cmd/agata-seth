+    p4, _ = _caminho_permitido(link)
+    print(f"{'PASS' if not p4 else 'FALHA'}  BLOQUEIA symlink de dentro da pasta apontando pra fora")
+    ok = ok and (not p4)
+    os.remove(link)
+
+    print("\nSELFTEST OFFLINE OK" if ok else "\nSELFTEST OFFLINE FALHOU")
+    return 0 if ok else 1
