+def metricas_por_rota(registros: list[dict]) -> dict:
+    """Agrega só metadados existentes. Rota ativa não é escolha crua nem desfecho.
+
+    Latência mede a chamada ao decisor, inclusive falhas, não a resposta da Seth.
+    Não inventa tokens, custo, acerto, intervenção humana ou rota ausentes.
+    """
+    import math
+    grupos = {}
+    for d in registros:
+        if not isinstance(d, dict) or d.get("continuacao"):
+            continue
+        rota = d.get("rota_ativa")
+        # Classes fechadas: não expõe texto arbitrário eventualmente presente no log.
+        chave = rota if rota in ("seth-rapido", "seth-livre", "seth-pesado", "seth-codigo") else "não registrada"
+        g = grupos.setdefault(chave, {"decisões": 0, "falhas": 0, "amostras_ms": []})
+        g["decisões"] += 1
+        g["falhas"] += d.get("respostas") is None
+        ms = d.get("ms")
+        if isinstance(ms, (int, float)) and not isinstance(ms, bool) and math.isfinite(ms) and ms >= 0:
+            g["amostras_ms"].append(ms)
+    for g in grupos.values():
+        ms = sorted(g.pop("amostras_ms"))
+        g["latências válidas"] = len(ms)
+        g["taxa de falha"] = g["falhas"] / g["decisões"]
+        # Percentil por posto mais próximo; nenhuma interpolação em amostra curta.
+        for p in (50, 95):
+            g[f"latência p{p} do decisor (ms)"] = ms[math.ceil(p / 100 * len(ms)) - 1] if ms else None
+    return dict(sorted(grupos.items()))
+
