diff --git a/.github/dependabot.yml b/.github/dependabot.yml
index b82e0b9..ba172d5 100644
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -10,3 +10,9 @@ updates:
       interval: "weekly"
     cooldown:
       default-days: 7
+    # Versão MAIOR de uma action muda comportamento do CI e mexe em workflow protegido: entra só por proposta
