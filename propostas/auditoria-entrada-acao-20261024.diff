+# (24/10/2026) Lacunas achadas pelo benchmark do roteamento (rodada 4): resposta que cita
+# entrada de MEMÓRIAS inexistente passava (o P-7 só roda no commit do canon), e "criei os
+# arquivos" sem nenhuma chamada passava (o M1 só conhece endereçado/fechado/confirmado).
+_CITA_ENTRADA = re.compile(r"(?i)(?:\bmem[óo]rias?\s*(?:n[º°o]\.?\s*)?\(?|\bentrada\s*\(?)(\d{1,10})\)?")
+_ACAO = re.compile(r"(?i)(?<!n[ãa]o )\b(criei|gravei|salvei|escrevi|apliquei|executei|anotei|enviei|registrei|"
+                   r"instalei|reiniciei|apaguei|removi|publiquei)\b")
+_NUMEROS_CACHE: dict = {}
+
+
+def _numeros_existentes(raiz: Path | None = None) -> set[int]:
+    raiz = raiz or RAIZ
+    historia = [raiz / "MEMÓRIAS.md", raiz / "MEMORIAS-MORNO.md"] + sorted((raiz / "memoria" / "frio").glob("*.md"))
+    canon = [raiz / "REGRAS.md", raiz / "PROTOCOLOS.md", raiz / "PROJETO.md"]
+    chave = tuple((str(f), f.stat().st_mtime) for f in historia + canon if f.exists())
+    if _NUMEROS_CACHE.get("chave") != chave:
+        nums: set[int] = set()
+        for f in historia:
+            if f.exists():
+                nums |= {int(x) for x in re.findall(r"^\((\d+)\) ", f.read_text(encoding="utf-8"), re.M)}
+        # entradas anteriores à (49) não estão em arquivo nenhum, mas o canon cita algumas -- (47) na Regra 4
+        for f in canon:
+            if f.exists():
+                nums |= {int(x) for x in re.findall(r"\((\d{1,4})\)", f.read_text(encoding="utf-8"))}
+        _NUMEROS_CACHE.update(chave=chave, nums=nums)
+    return _NUMEROS_CACHE["nums"]
+
+
+def _fora_de_codigo(texto: str) -> str:
+    corpo, em_codigo = [], False
+    for l in texto.splitlines():
+        if l.strip().startswith("```"):
+            em_codigo = not em_codigo
+            continue
+        if not em_codigo:
+            corpo.append(l)
+    return "\n".join(corpo)
+
+
+def _entrada_inexistente(texto: str, raiz: Path | None = None) -> list[str]:
+    """Número de entrada citado que não existe no histórico (MEMÓRIAS + morno + frio) nem é
+    citado pelo canon (REGRAS, PROTOCOLOS, PROJETO)."""
+    nums = _numeros_existentes(raiz)
+    if not nums:
+        return []
+    faltam = sorted({int(n) for n in _CITA_ENTRADA.findall(_fora_de_codigo(texto)) if int(n) not in nums})
+    if not faltam:
+        return []
+    return [f"evidência: cita {len(faltam)} entrada(s) de MEMÓRIAS que não existe(m) no histórico — "
+            "não invente fonte; sem fonte lida, escreva \"não encontrei\""]
+
+
+def _acao_sem_chamada(texto: str, msgs: list) -> list[str]:
+    """Ação afirmada na 1ª pessoa ("criei", "gravei", "apliquei"...) sem nenhuma chamada de
+    ferramenta no turno auditado: o modelo não tem como ter feito."""
+    if _chamadas_do_turno(msgs):
+        return []
+    m = _ACAO.search(_fora_de_codigo(texto))
+    if not m:
+        return []
+    return [f"ação afirmada sem chamada de ferramenta neste turno ('{m.group(0)}') — diga o que "
+            "propõe fazer, não o que fez"]
+
 
