+      </form>
+      <p class="hint" id="turnoHint">Nenhum prompt é enviado à extensão antes de você aprovar o pedido na fila.</p>
+      <div class="chain-box">
+        <div class="chain-title">Conversa e bateria de avaliação</div>
+        <label for="groupKind">Tipo de rodada</label>
+        <select id="groupKind"><option value="debate">Debate independente + síntese</option><option value="chain">Conversa em cadeia</option><option value="evaluation">Bateria de ensaios de um modelo</option></select>
+        <label for="chainSites">Participantes (até 3 adaptadores, separados por vírgula)</label>
+        <div class="chain-controls"><input id="chainSites" value="deepseek,gemini,zai" aria-label="Participantes da conversa" /><input id="groupRepetitions" type="number" min="1" max="5" value="3" aria-label="Número de ensaios" /><button id="btnConversa" type="button" class="primary">Preparar rodada</button></div>
+        <p class="hint">Debates e cadeias avançam etapa por etapa. Cada prompt, síntese, repetição e handoff fica pendente de aprovação humana individual.</p>
+      </div>
+    </section>
+    <section id="provedores" class="wide">
+      <h2>Catálogo de provedores</h2><p class="hint">Catálogo e estado de autenticação não comprovam resposta funcional. Apenas adaptadores instalados recebem envios.</p>
+      <div class="provider-table-wrap"><table id="providerTable"><thead><tr><th>Provedor</th><th>Tipo</th><th>Acesso</th><th>Estado do catálogo</th></tr></thead><tbody><tr><td colspan="4" class="hint">carregando catálogo…</td></tr></tbody></table></div>
+    </section>
+    <section id="fila"><h2>Fila de aprovação <span id="filaCount" class="badge">0</span></h2><ul id="filaLista"></ul></section>
+    <section id="rodadas" class="wide"><h2>Debates e baterias</h2><ul id="rodadasLista"></ul></section>
+    <section id="ferramentas">
+      <h2>Solicitar ferramenta</h2><p class="hint">O pedido será mostrado para aprovação antes de consultar dados do Agata. O modelo não executa a ferramenta diretamente.</p>
+      <form id="toolForm"><label for="tool">Ferramenta</label><select id="tool"><option value="SEARCH">Busca no canon</option><option value="STATE">Estado medido do Agata</option><option value="CACHE">Leitura do cache do Conselho</option><option value="AUDIT">Auditoria do texto</option><option value="RELAY">Encaminhar pergunta a outro modelo</option><option value="DELIVER">Preparar entrega para revisão humana</option></select>
+        <label for="toolArgs">Argumentos (JSON)</label><input id="toolArgs" value='{"canon":""}' autocomplete="off" />
+        <label for="toolText">Texto/contexto (se aplicável)</label><textarea id="toolText" maxlength="60000" placeholder="Texto que a ferramenta deve analisar ou encaminhar"></textarea>
+        <button type="submit" class="primary">Solicitar aprovação da ferramenta</button>
+      </form>
+    </section>
+    <section id="historico" class="wide"><h2>Histórico recente</h2><ul id="historicoLista"></ul></section>
+    <section id="decisao" class="wide"><h2>Pedidos de ferramentas</h2><p class="hint">Pedidos manuais e tags interpretadas das respostas ficam pendentes. Nada é executado sem aprovação individual.</p><ul id="decisaoLista"></ul></section>
+  </main>
+  <footer><a href="/prototipo">Voltar ao painel operacional da Agata</a></footer>
+  <script src="/conselho-rede/app.js" defer></script>
+</body>
+</html>
diff --git a/redesign/painel_operacional/conselho-rede/style.css b/redesign/painel_operacional/conselho-rede/style.css
new file mode 100644
index 0000000000000000000000000000000000000000..7fa4581f7df8085fb89243beaa0860d5537c7edb
--- /dev/null
+++ b/redesign/painel_operacional/conselho-rede/style.css
@@ -0,0 +1,182 @@
+:root {
+  --bg: #080d18;
+  --fg: #eaf2ff;
+  --muted: #91a4ba;
+  --accent: #61d9ed;
+  --warn: #ffc276;
+  --err: #ff91a8;
+  --ok: #69e0c1;
+  --border: #2b4058;
+  --card: rgba(15, 26, 42, .86);
+}
+* { box-sizing: border-box; }
+body {
+  font-family: "Fira Sans", "Noto Sans", "Segoe UI", sans-serif;
+  background: radial-gradient(ellipse at 78% 0%, rgba(35,83,130,.18), transparent 35%), radial-gradient(ellipse at 0% 85%, rgba(75,46,125,.12), transparent 32%), var(--bg);
+  color: var(--fg);
+  margin: 0;
+  padding: 20px;
+  font-size: 14px;
+  line-height: 1.5;
+  min-height: 100vh;
+}
+header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin: -20px auto 24px;
+  max-width: 1280px;
+  border-bottom: 1px solid rgba(102,178,218,.18);
+  padding: 18px 0 14px;
+}
+.brand-inline { display: flex; align-items: center; gap: 10px; }
+.brand-mark { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid rgba(97,217,237,.55); border-radius: 10px; color: var(--accent); font-weight: 700; background: rgba(20,39,60,.72); }
+.brand-inline h1 { margin: 0; font-size: 20px; letter-spacing: -.035em; }
+.brand-sub, .crumb { color: var(--muted); font-size: 10px; letter-spacing: .12em; }
+.header-meta { display: flex; align-items: center; gap: 10px; }
+.status {
+  font-size: 11px;
+  color: var(--muted);
+  padding: 3px 8px;
+  background: rgba(97,217,237,.08);
+  border: 1px solid rgba(97,217,237,.18);
+  border-radius: 99px;
+}
+.status.connected { color: var(--ok); }
+.status.disconnected { color: var(--err); }
+main {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 20px;
+  max-width: 1280px;
+  margin: 0 auto;
+}
+section {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  padding: 17px 18px;
+  box-shadow: 0 12px 34px rgba(0,0,0,.12);
+  min-width: 0;
+}
+section.wide { grid-column: 1 / -1; }
+.provider-table-wrap { overflow-x: auto; }
+table { width: 100%; border-collapse: collapse; font-size: 12px; }
+th, td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--border); }
+th { color: var(--muted); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
+td { color: var(--fg); }
+td.state-green { color: var(--ok); font-weight: 700; }
+td.state-monitoring { color: var(--warn); font-weight: 700; }
+td.state-experimental, td.state-variable { color: var(--muted); }
+section h2 {
+  font-size: 14px;
+  margin: 0 0 12px 0;
+  color: var(--accent);
+}
+.row { display: flex; gap: 10px; align-items: center; margin-bottom: 8px; }
+.row > * { flex: 1; }
+label { display: block; font-size: 11px; color: var(--muted); margin: 8px 0 3px; }
+select, textarea, input {
+  width: 100%;
+  padding: 8px;
+  background: rgba(7, 13, 25, .72);
+  color: var(--fg);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  font-size: 13px;
+  font-family: inherit;
+}
+textarea { resize: vertical; min-height: 100px; }
+button {
+  padding: 8px 14px;
+  background: transparent;
+  color: var(--fg);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  cursor: pointer;
+  font-size: 12px;
+  font-weight: 600;
+}
+button:hover { border-color: var(--accent); }
+button.primary { background: var(--accent); color: #111; border-color: var(--accent); }
+button.primary:hover { background: #6ab4ff; }
+button.danger { background: var(--err); color: #111; border-color: var(--err); }
+button:disabled { opacity: 0.4; cursor: not-allowed; }
+.chain-box {
+  margin-top: 18px;
+  padding-top: 14px;
+  border-top: 1px solid var(--border);
+}
+.chain-title {
+  color: var(--accent);
+  font-size: 12px;
+  font-weight: 700;
+  letter-spacing: .02em;
+  margin-bottom: 2px;
+}
+.chain-controls {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 8px;
+  align-items: center;
+}
+.chain-controls button { white-space: nowrap; }
+.badge {
+  display: inline-block;
+  background: var(--accent);
+  color: #111;
+  font-size: 11px;
+  padding: 1px 7px;
+  border-radius: 10px;
+  margin-left: 6px;
+}
+ul { list-style: none; padding: 0; margin: 0; max-height: 300px; overflow-y: auto; }
+li {
+  padding: 10px;
+  border-bottom: 1px solid var(--border);
+  font-size: 12px;
+}
+li:last-child { border-bottom: none; }
+li .meta { color: var(--muted); font-size: 10px; margin-bottom: 4px; }
+li .text {
+  font-family: monospace, monospace;
+  white-space: pre-wrap;
+  word-break: break-word;
+  max-height: 200px;
+  overflow-y: auto;
+  background: var(--bg);
+  padding: 8px;
+  border-radius: 3px;
+  font-size: 11px;
+}
+li.error .text { color: var(--err); }
+li.ok .meta { color: var(--ok); }
+.hint { color: var(--muted); font-size: 11px; margin-top: 6px; }
+footer { margin-top: 30px; border-top: 1px solid var(--border); padding-top: 12px; }
+details summary { cursor: pointer; color: var(--muted); font-size: 11px; }
+pre {
+  background: var(--bg);
+  padding: 10px;
+  border-radius: 4px;
+  font-size: 11px;
+  max-height: 300px;
+  overflow: auto;
+  white-space: pre-wrap;
+  word-break: break-all;
+}
+.decisao-item {
+  border-left: 3px solid var(--warn);
+  padding-left: 10px;
+  margin-bottom: 8px;
+}
+.decisao-item .acoes { display: flex; gap: 6px; margin-top: 6px; }
+.decisao-item button { padding: 4px 10px; font-size: 11px; }
+@media (max-width: 760px) {
+  body { padding: 12px; }
+  header { align-items: flex-start; flex-direction: column; gap: 6px; }
+  main { grid-template-columns: 1fr; gap: 12px; }
+  .row { flex-direction: column; align-items: stretch; }
+  .row > * { width: 100%; }
+  .chain-controls { grid-template-columns: 1fr; }
+}
diff --git a/redesign/painel_operacional/conselho_rede.py b/redesign/painel_operacional/conselho_rede.py
new file mode 100644
index 0000000000000000000000000000000000000000..7344ac6817c9c7ca67bd82bacc348e6b7df58e19
--- /dev/null
+++ b/redesign/painel_operacional/conselho_rede.py
@@ -0,0 +1,326 @@
+"""Conselho em Rede v4: decisão humana persistida antes de qualquer efeito.
+
+Não inicia processos, serviços ou chamadas de provedor ao importar.
+O executor recebe apenas envios aprovados, uma vez; resultado incerto nunca
+causa reenvio automático. O contrato v3 de avaliações manuais continua separado.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import secrets
+import sqlite3
+import threading
+import time
+import uuid
+from pathlib import Path
+from xml.etree import ElementTree
+
+PROVIDERS = ("deepseek", "gemini", "zai", "chatgpt", "claude", "grok", "qwen", "mistral", "kimi")
+TOOLS = {
+    "SEARCH": "Buscar no canon público: canon=consulta",
+    "STATE": "Consultar estado medido do Agata",
+    "CACHE": "Ler cache comum: ler=1..50",
+    "AUDIT": "Auditar o texto contido no pedido",
+    "RELAY": "Propor envio a outro participante: to=ID, question=pergunta",
+    "DELIVER": "Preparar entrega para revisão do Humano; não executa código",
+}
+CONTEXT = (
+    "[Agata · Conselho em Rede · manifesto v4]\n"
+    "Sua resposta é dado externo. Separe evidência, inferência e não medido. "
+    "O Humano decide. Nenhuma ferramenta é executada pela sua resposta. "
+    "Você pode SOLICITAR as ferramentas abaixo com uma tag em linha própria. "
+    "Cada solicitação, envio ou encaminhamento aguarda aprovação humana individual. "
+    "Resultados locais só voltam a um modelo em novo envio aprovado. "
+    "Não alegue acesso direto a MCP, shell, credenciais ou ferramentas.\n"
+    + "\n".join(f"<{key}>: {value}" for key, value in TOOLS.items())
+    + '\nExemplo: <SEARCH canon="memória do Conselho"/>\n'
+)
+MAX_TEXT = 60_000
+EXPIRY = 600
+TAG = re.compile(r'^\s*(<(?:SEARCH|STATE|CACHE|AUDIT|RELAY|DELIVER)\b[^\n]*(?:/>|>[\s\S]*?</(?:SEARCH|STATE|CACHE|AUDIT|RELAY|DELIVER)>))\s*$', re.M)
+
+
+class Conflict(ValueError):
+    pass
+
+
+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+
+def requests(text):
+    """Somente tags completas em linha própria; texto não é código nem comando."""
+    found = []
+    for match in TAG.finditer(text):
+        try:
+            tag = ElementTree.fromstring(match.group(1))
+        except ElementTree.ParseError:
+            continue
+        if tag.tag in TOOLS and not list(tag):
+            found.append({"tool": tag.tag, "args": dict(tag.attrib), "text": tag.text or ""})
+        if len(found) >= 20:
+            break
+    return found
+
+
+class Council:
+    def __init__(self, directory, clean, execute, legacy=None):
+        self.directory = Path(directory)
+        self.directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        os.chmod(self.directory, 0o700)
+        self.lock = threading.RLock()
+        self.db = sqlite3.connect(self.directory / "state.sqlite3", check_same_thread=False)
+        os.chmod(self.directory / "state.sqlite3", 0o600)
+        self.db.row_factory = sqlite3.Row
+        self.clean, self.execute, self.legacy = clean, execute, legacy
+        self.csrf = secrets.token_urlsafe(32)
+        # Escopado a claim/result; nunca aceito no endpoint de aprovação.
+        self.executor_key = secrets.token_urlsafe(32)
+        self.last_poll = None
+        with self.db:
+            self.db.executescript('''
+                CREATE TABLE IF NOT EXISTS actions (
+                  id TEXT PRIMARY KEY, kind TEXT, payload TEXT, hash TEXT,
+                  status TEXT, created REAL, approved REAL, lease TEXT, result TEXT,
+                  parent TEXT, revision INTEGER DEFAULT 1);
+                CREATE TABLE IF NOT EXISTS events (
+                  n INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT, status TEXT, ts REAL);
+                CREATE TABLE IF NOT EXISTS groups_ (
+                  id TEXT PRIMARY KEY, kind TEXT, prompt TEXT, sites TEXT, synthesis TEXT);
+            ''')
+            # Sobreviver a restart não significa ter autorização para repetir.
+            for row in self.db.execute("SELECT id,status FROM actions WHERE status IN ('approved','running','executing')").fetchall():
+                state = "pending" if row["status"] == "approved" else "unknown"
+                self.db.execute("UPDATE actions SET status=?,approved=NULL WHERE id=?", (state, row["id"]))
+                self.event(row["id"], state)
+
+    def event(self, action, status):
+        self.db.execute("INSERT INTO events(action,status,ts) VALUES(?,?,?)", (action, status, time.time()))
+
+    def _text(self, value, maximum=MAX_TEXT, minimum=1):
+        if not isinstance(value, str) or not minimum <= len(value.strip()) <= maximum:
+            raise ValueError("texto vazio ou acima do limite")
+        return self.clean(value.strip())
+
+    def _payload(self, kind, p):
+        if not isinstance(p, dict):
+            raise ValueError("payload deve ser objeto")
+        if kind == "send":
+            if p.get("site") not in PROVIDERS:
+                raise ValueError("provedor sem adaptador de relay")
+            return {"site": p["site"], "text": self._text(p.get("text")),
+                    "group": p.get("group"), "phase": p.get("phase", "single")}
+        if kind != "tool" or p.get("tool") not in TOOLS:
+            raise ValueError("ação fora da lista")
+        tool, args = p["tool"], p.get("args", {})
+        if not isinstance(args, dict):
+            raise ValueError("argumentos inválidos")
+        if tool == "SEARCH":
+            args = {"canon": self._text(args.get("canon"), 200)}
+        elif tool == "CACHE":
+            n = args.get("ler", 5)
+            if isinstance(n, bool) or not re.fullmatch(r"[0-9]{1,2}", str(n)) or not 1 <= int(n) <= 50:
+                raise ValueError("CACHE exige ler entre 1 e 50")
+            args = {"ler": int(n)}
+        elif tool == "RELAY":
+            if args.get("to") not in PROVIDERS:
+                raise ValueError("destino sem adaptador")
+            args = {"to": args["to"], "question": self._text(args.get("question") or p.get("text"))}
+        else:
+            args = {}
+        text = self._text(p.get("text") or " ") if str(p.get("text", "")).strip() else ""
+        if tool in {"AUDIT", "DELIVER"} and not text:
+            raise ValueError("AUDIT/DELIVER exigem texto explícito")
+        return {"tool": tool, "args": args, "text": text}
+
+    def _create(self, kind, p, parent=None):
+        payload = self._payload(kind, p)
+        if self.db.execute("SELECT count(*) FROM actions WHERE status IN ('pending','approved','running','executing')").fetchone()[0] >= 200:
+            raise Conflict("fila local cheia")
+        action = uuid.uuid4().hex
+        h = digest({"kind": kind, "payload": payload})
+        self.db.execute("INSERT INTO actions(id,kind,payload,hash,status,created,parent) VALUES(?,?,?,?,?,?,?)",
+                        (action, kind, json.dumps(payload, ensure_ascii=False), h, "pending", time.time(), parent))
+        self.event(action, "pending")
+        return action
+
+    def create(self, kind, payload):
+        with self.lock, self.db:
+            return self._create(kind, payload)
+
+    def group(self, kind, prompt, sites, repetitions=1):
+        if kind not in {"debate", "chain", "evaluation"}:
+            raise ValueError("tipo de rodada inválido")
+        if not isinstance(sites, list) or not sites or len(sites) > 3 or any(s not in PROVIDERS for s in sites) or len(set(sites)) != len(sites):
+            raise ValueError("participantes inválidos")
+        if (kind == "debate" and len(sites) != 3) or (kind == "chain" and len(sites) < 2) or (kind == "evaluation" and len(sites) != 1):
+            raise ValueError("número de participantes inválido")
+        if type(repetitions) is not int or not 1 <= repetitions <= 5:
+            raise ValueError("bateria exige 1 a 5 ensaios")
+        prompt = self._text(prompt)
+        with self.lock, self.db:
+            gid = uuid.uuid4().hex
+            self.db.execute("INSERT INTO groups_ VALUES(?,?,?,?,NULL)", (gid, kind, prompt, json.dumps(sites)))
+            initial = sites if kind == "debate" else [sites[0]] * (repetitions if kind == "evaluation" else 1)
+            for site in initial:
+                text = prompt if kind != "debate" else "[Resposta independente: tese, razões, limites e teste; não pressuponha outras respostas.]\n" + prompt
+                self._create("send", {"site": site, "text": text, "group": gid, "phase": kind}, gid)
+            return gid
+
+    def _row(self, action):
+        row = self.db.execute("SELECT * FROM actions WHERE id=?", (action,)).fetchone()
+        if row is None:
+            raise ValueError("pedido desconhecido")
+        return dict(row)
+
+    def decide(self, action, expected_hash, approve):
+        with self.lock, self.db:
+            row = self._row(action)
+            if row["status"] != "pending" or row["hash"] != expected_hash:
+                raise Conflict("pedido mudou ou já foi decidido; revise novamente")
+            if type(approve) is not bool:
+                raise ValueError("decisão precisa ser booleana")
+            status = "approved" if approve else "rejected"
+            self.db.execute("UPDATE actions SET status=?,approved=? WHERE id=?", (status, time.time() if approve else None, action))
+            self.event(action, status)
+        if approve and row["kind"] == "tool":
+            self._execute_tool(action)
+        return self._row(action)
+
+    def _execute_tool(self, action):
+        with self.lock, self.db:
+            row = self._row(action)
+            if row["status"] != "approved":
+                raise Conflict("ferramenta sem aprovação")
+            self.db.execute("UPDATE actions SET status='executing' WHERE id=?", (action,))
+            self.event(action, "executing")
+        try:
+            payload = json.loads(row["payload"])
+            if payload["tool"] == "RELAY":
+                with self.lock, self.db:
+                    result = "Encaminhamento preparado: " + self._create("send", {
+                        "site": payload["args"]["to"], "text": payload["args"]["question"]}, action)
+            elif payload["tool"] == "DELIVER":
+                result = "Entrega para revisão humana; nenhuma execução local:\n" + payload["text"]
+            else:
+                result = self.execute(payload["tool"], payload["args"], payload["text"])
+            self.finish(action, {"ok": True, "text": self._text(result), "error": ""}, "executing")
+        except Exception:
+            self.finish(action, {"ok": False, "text": "", "error": "ferramenta indisponível; consulte a origem antes de tentar de novo"}, "executing")
+
+    def claim(self):
+        with self.lock, self.db:
+            self.last_poll = time.time()
+            self.db.execute("UPDATE actions SET status='unknown' WHERE status='running' AND approved<?", (time.time() - EXPIRY,))
+            if self.db.execute("SELECT 1 FROM actions WHERE status='running'").fetchone():
+                return []
+            rows = self.db.execute("SELECT id,approved FROM actions WHERE kind='send' AND status='approved' ORDER BY created").fetchall()
+            for item in rows:
+                if item["approved"] < time.time() - EXPIRY:
+                    self.db.execute("UPDATE actions SET status='pending',approved=NULL WHERE id=?", (item["id"],))
+                    self.event(item["id"], "pending")
+                    continue
+                row, lease = self._row(item["id"]), secrets.token_urlsafe(24)
+                self.db.execute("UPDATE actions SET status='running',lease=? WHERE id=?", (lease, item["id"]))
+                self.event(item["id"], "running")
+                return [{"id": row["id"], "action": "send_prompt", **json.loads(row["payload"]),
+                         "approval_hash": row["hash"], "lease": lease}]
+            return []
+
+    def finish(self, action, result, required="running", lease=None, site=None):
+        if not isinstance(result, dict) or type(result.get("ok")) is not bool:
+            raise ValueError("resultado inválido")
+        clean = {"ok": result["ok"], "text": self._text(result["text"]) if result.get("text") else "",
+                 "error": self._text(result["error"], 2000) if result.get("error") else ""}
+        if clean["ok"] and not clean["text"]:
+            raise ValueError("resposta positiva sem texto")
+        with self.lock, self.db:
+            row = self._row(action)
+            if required == "running":
+                p = json.loads(row["payload"])
+                if row["kind"] != "send" or not lease or not secrets.compare_digest(row["lease"] or "", lease) or site != p["site"]:
+                    raise Conflict("resultado não corresponde à entrega")
+            serialized = json.dumps(clean, sort_keys=True, ensure_ascii=False)
+            if row["result"]:
+                if row["result"] != serialized:
+                    raise Conflict("resultado conflitante")
+                return {"duplicate": True}
+            if row["status"] != required:
+                raise Conflict("pedido não está em execução")
+            self.db.execute("UPDATE actions SET status=?,result=? WHERE id=?", ("completed" if clean["ok"] else "error", serialized, action))
+            self.event(action, "completed" if clean["ok"] else "error")
+            if clean["ok"] and row["kind"] == "send":
+                for request in requests(clean["text"]):
+                    try:
+                        self._create("tool", request, action)
+                    except ValueError:
+                        self.event(action, "invalid_request")
+                self._next(row)
+            return {"duplicate": False}
+
+    def _next(self, row):
+        p = json.loads(row["payload"])
+        gid = p.get("group")
+        if not gid or p["phase"] not in {"chain", "debate"}:
+            return
+        group = self.db.execute("SELECT * FROM groups_ WHERE id=?", (gid,)).fetchone()
+        members = json.loads(group["sites"])
+        actions = [dict(r) for r in self.db.execute("SELECT * FROM actions WHERE parent=? AND kind='send' ORDER BY created", (gid,))]
+        if any(r["status"] != "completed" for r in actions):
+            return
