diff --git a/redesign/painel_operacional/relay-extension-v2/background.js b/redesign/painel_operacional/relay-extension-v2/background.js
new file mode 100644
index 0000000000000000000000000000000000000000..7c6005f712dda14c507ca56be23e789819575cc5
--- /dev/null
+++ b/redesign/painel_operacional/relay-extension-v2/background.js
@@ -0,0 +1,426 @@
+// background.js — service worker (MV3) v2
+// Poll HTTP ao Painel do Conselho. Sem relay A↔B antigo.
+// A lógica de orquestração vive no Painel; aqui é só executor de comandos.
+
+const PAINEL_URL = "http://127.0.0.1:20146";
+const RELAY_CLIENT_ID = "agata-relay-v2";
+// O relay trabalha apenas com abas que o Humano abriu e autenticou.
+// Abrir abas automaticamente pode gerar popups, telas de login e estado
+// visual inesperado; quando desabilitado, a ausência vira erro manual claro.
+const AUTO_OPEN_MISSING_TABS = false;
+const POLL_INTERVAL_MS = 2000;      // normal
+const POLL_INTERVAL_IDLE_MS = 5000;  // após 5 polls vazios
+const POLL_TIMEOUT_MS = 5000;
+const TURN_STABLE_MS = 8000;         // 8s sem mudança = resposta terminada
+const TURN_MAX_WAIT_MS = 240000;     // 4 min por turno; provedores podem responder lentamente
+const READY_TIMEOUT_MS = 90000;      // páginas pesadas podem levar mais de 30s
+const TAB_ACTIVATION_SETTLE_MS = 900; // dá ao site tempo para receber foco/visibilidade
+const TAB_OPERATION_TIMEOUT_MS = 4000;
+
+let idleCount = 0;
+let connected = false;
+
+// keepalive: alarm a cada 25s pra evitar service worker morrer
+chrome.alarms.create("keepalive", { periodInMinutes: 0.42 });
+chrome.alarms.onAlarm.addListener((alarm) => {
+  if (alarm.name === "keepalive") {
+    pollOnce();
+  }
+  if (alarm.name === "active-wait") {
+    // não usado ainda; placeholder pra wait ativo durante turno
+  }
+});
+
+async function pollOnce() {
+  try {
+    const r = await fetch(`${PAINEL_URL}/api/relay-council/tasks`, {
+      method: "GET",
+      headers: { "X-Relay-Client": RELAY_CLIENT_ID },
+      signal: AbortSignal.timeout(POLL_TIMEOUT_MS),
+    });
+    if (!r.ok) {
+      console.warn("[relay] painel respondeu", r.status);
+      connected = false;
+      updateBadge("X");
+      return;
+    }
+    const tasks = await r.json();
+    connected = true;
+    if (!tasks.length) {
+      idleCount++;
+      updateBadge("");
+      return;
+    }
+    idleCount = 0;
+    updateBadge(String(tasks.length));
+    for (const task of tasks) {
+      await executeTask(task);
+    }
+  } catch (e) {
+    console.warn("[relay] poll falhou:", e.message);
+    connected = false;
+    updateBadge("X");
+  }
+}
+
+function updateBadge(text) {
+  chrome.action.setBadgeText({ text });
+  chrome.action.setBadgeBackgroundColor({ color: text === "X" ? "#ff5555" : "#4a9eff" });
+}
+
+async function executeTask(task) {
+  const {
+    id, site, text, action, chain_id, chain_index, chain_total,
+    debate_id, debate_phase, debate_index, debate_total,
+    evaluation_id, evaluation_index, evaluation_total, evaluation_started_ts,
+  } = task;
+  const taskMeta = {
+    chain_id, chain_index, chain_total,
+    debate_id, debate_phase, debate_index, debate_total,
+    evaluation_id, evaluation_index, evaluation_total, evaluation_started_ts,
+  };
+  const report = (ok, response, error) => reportResult(id, site, ok, response, error, taskMeta);
+  let previousView = null;
+  try {
+    const tabId = await findTabForSite(site);
+    if (!tabId) {
+      await report(false, null, `aba do site "${site}" não encontrada`);
+      return;
+    }
+    if (site === "kimi") {
+      const busy = await detectKimiBusy(tabId);
+      if (busy) {
+        await report(false, null, `provider_busy: ${busy}`);
+        return;
+      }
+    }
+    // Alguns sites, especialmente o Gemini, suspendem a UI quando a aba não
+    // está visível. Tornamos a aba alvo ativa apenas durante este turno.
+    previousView = await activateTabForTask(tabId);
+    // injeta content script se necessário
+    await ensureContentScript(tabId, site);
+    // verifica isReady
+    const ready = await waitForReady(tabId, READY_TIMEOUT_MS, site);
+    if (!ready.ok || !ready.value) {
+      const debug = await sendSiteCmd(tabId, site, "debug");
+      const info = debug.ok && debug.value ? debug.value : {};
+      const found = info.found ? ` input=${!!info.found.inputTextarea} botão=${!!info.found.submitButton}` : "";
+      const url = info.url ? ` url=${info.url}` : "";
+      await report(false, null, `aba não está pronta (logado?)${url}${found}`);
+      return;
+    }
+    if (site === "kimi") {
+      const busy = await detectKimiBusy(tabId);
+      if (busy) {
+        await report(false, null, `provider_busy: ${busy}`);
+        return;
+      }
+    }
+    // Guarda a última resposta antes do turno para não aceitar resposta antiga.
+    const baseline = await sendSiteCmd(tabId, site, "readLast");
+    // escreve
+    const w = await sendSiteCmd(tabId, site, "write", { text });
+    if (!w.ok) {
+      await report(false, null, `write falhou: ${w.error}`);
+      return;
+    }
+    // submit
+    const s = await sendSiteCmd(tabId, site, "submit");
+    if (!s.ok) {
+      await report(false, null, `submit falhou: ${s.error}`);
+      return;
+    }
+    // espera resposta estabilizar
+    const response = await waitForResponse(tabId, site, baseline.ok ? baseline.value : "");
+    if (!response) {
+      await report(false, null, "timeout esperando resposta");
+      return;
+    }
+    await report(true, response, null);
+  } catch (e) {
+    await report(false, null, String(e.message || e));
+  } finally {
+    await restorePreviousView(previousView);
+  }
+}
+
+async function activateTabForTask(tabId) {
+  const activeTabs = await chrome.tabs.query({ active: true, lastFocusedWindow: true });
+  const current = activeTabs[0] || null;
+  const target = await chrome.tabs.get(tabId);
+  const previous = current ? { tabId: current.id, windowId: current.windowId } : null;
+
+  if (target.windowId !== undefined) {
+    await withTimeout(chrome.windows.update(target.windowId, { focused: true }), TAB_OPERATION_TIMEOUT_MS, "focar janela");
+  }
+  await withTimeout(chrome.tabs.update(tabId, { active: true }), TAB_OPERATION_TIMEOUT_MS, "ativar aba");
+  await new Promise((resolve) => setTimeout(resolve, TAB_ACTIVATION_SETTLE_MS));
+  return previous;
+}
+
+async function restorePreviousView(previous) {
+  if (!previous || previous.tabId === undefined) return;
+  try {
+    await withTimeout(chrome.windows.update(previous.windowId, { focused: true }), TAB_OPERATION_TIMEOUT_MS, "restaurar janela");
+    await withTimeout(chrome.tabs.update(previous.tabId, { active: true }), TAB_OPERATION_TIMEOUT_MS, "restaurar aba");
+  } catch (e) {
+    // A aba/janela anterior pode ter sido fechada pelo usuário durante o turno.
+    console.debug("[relay] não foi possível restaurar a aba anterior:", e.message);
+  }
+}
+
+function withTimeout(promise, timeoutMs, operation) {
+  return Promise.race([
+    promise,
+    new Promise((_, reject) => setTimeout(() => reject(new Error(`${operation} excedeu ${timeoutMs}ms`)), timeoutMs)),
+  ]);
+}
+
+async function waitForResponse(tabId, siteId, baseline = "") {
+  const start = Date.now();
+  let lastText = baseline || "";
+  let stableSince = 0;
+  let seenNewText = !baseline;
+  while (Date.now() - start < TURN_MAX_WAIT_MS) {
+    if (siteId === "kimi") {
+      const busy = await detectKimiBusy(tabId);
+      if (busy) throw new Error(`provider_busy: ${busy}`);
+    }
+    const r = await sendSiteCmd(tabId, siteId, "readLast");
+    if (!r.ok && /^provider_busy:/.test(r.error || "")) {
+      throw new Error(r.error);
+    }
+    if (r.ok && r.value) {
+      const txt = r.value;
+      if (baseline && txt !== baseline) seenNewText = true;
+      if (txt === lastText) {
+        if (!stableSince) stableSince = Date.now();
+        if (seenNewText && Date.now() - stableSince > TURN_STABLE_MS) {
+          return txt;
+        }
+      } else {
+        lastText = txt;
+        stableSince = 0;
+      }
+    }
+    await new Promise((r) => setTimeout(r, 1000));
+  }
+  return null;
+}
+
+async function detectKimiBusy(tabId) {
+  try {
+    const results = await chrome.scripting.executeScript({
+      target: { tabId },
+      func: () => {
+        const text = (document.body?.innerText || "").toLowerCase();
+        if (text.includes("too many people are chatting with kimi")) {
+          return "Kimi informou excesso de usuários simultâneos";
+        }
+        return "";
+      },
+    });
+    return results?.[0]?.result || "";
+  } catch (_) {
+    return "";
+  }
+}
+
+async function waitForReady(tabId, timeoutMs, siteId) {
+  const start = Date.now();
+  let last = { ok: false, value: false };
+  while (Date.now() - start < timeoutMs) {
+    last = await sendSiteCmd(tabId, siteId, "isReady");
+    if (last.ok && last.value) return last;
+    await new Promise((r) => setTimeout(r, 1000));
+  }
+  return last;
+}
+
+async function findTabForSite(siteId) {
+  const patterns = {
+    deepseek: [/^https:\/\/(www\.)?(chat\.)?deepseek\.com\//],
+    gemini: [/^https:\/\/gemini\.google\.com\//],
+    zai: [/^https:\/\/(www\.)?(chat\.)?z\.ai\//],
+    chatgpt: [/^https:\/\/chatgpt\.com\//],
+    claude: [/^https:\/\/claude\.ai\//],
+    grok: [/^https:\/\/(www\.)?grok\.com\//, /^https:\/\/x\.com\//],
+    qwen: [/^https:\/\/(chat\.)?qwen\.ai\//],
+    mistral: [/^https:\/\/(lechat|chat)\.mistral\.ai\//],
+    kimi: [/^https:\/\/(www\.)?kimi\.(com|ai)\//],
+  };
+  const re = patterns[siteId];
+  if (!re) return null;
+  const siteUrls = {
+    deepseek: "https://chat.deepseek.com/",
+    gemini: "https://gemini.google.com/",
+    zai: "https://chat.z.ai/",
+    chatgpt: "https://chatgpt.com/",
+    claude: "https://claude.ai/",
+    grok: "https://grok.com/",
+    qwen: "https://qwen.ai/",
+    mistral: "https://chat.mistral.ai/",
+    kimi: "https://www.kimi.ai/en/",
+  };
+  const tabs = await chrome.tabs.query({});
+  for (const t of tabs) {
+    if (!t.url) continue;
+    if (re.some((r) => r.test(t.url))) {
+      await pinRelayTab(t);
+      return t.id;
+    }
+  }
+  // Se a aba não foi restaurada, abra o endereço oficial. O passo seguinte
+  // ainda exige login manual; não há tentativa de contornar autenticação.
+  const url = siteUrls[siteId];
+  if (!url) return null;
+  if (!AUTO_OPEN_MISSING_TABS) {
+    console.warn(`[relay] aba de ${siteId} ausente; abertura automática bloqueada`);
+    return null;
+  }
+  const created = await chrome.tabs.create({ url, active: false });
+  await pinRelayTab(created);
+  return created.id;
+}
+
+async function pinRelayTab(tab) {
+  if (!tab || tab.pinned) return;
+  try {
+    await withTimeout(chrome.tabs.update(tab.id, { pinned: true }), TAB_OPERATION_TIMEOUT_MS, "fixar aba");
+  } catch (e) {
+    console.debug("[relay] não foi possível fixar a aba:", e.message);
+  }
+}
+
+async function ensureContentScript(tabId, siteId) {
+  const ping = await sendCmd(tabId, "isReady");
+  if (ping.ok) return;
+  try {
+    const genericSites = new Set([
+      "chatgpt", "claude", "grok", "qwen", "mistral", "kimi",
+    ]);
+    const files = ["content/_common.js"];
+    if (genericSites.has(siteId)) files.push("content/_generic.js");
+    files.push(`content/${siteId}.js`);
+    await chrome.scripting.executeScript({
+      target: { tabId },
+      files,
+    });
+    await new Promise((r) => setTimeout(r, 800));
+  } catch (e) {
+    throw new Error(`falha ao injetar content script: ${e.message}`);
+  }
+}
+
+function sendCmd(tabId, cmd, extra = {}) {
+  return new Promise((resolve) => {
+    chrome.tabs.sendMessage(tabId, { cmd, ...extra }, (resp) => {
+      const err = chrome.runtime.lastError;
+      if (err) resolve({ ok: false, error: err.message });
+      else resolve(resp || { ok: false, error: "sem resposta" });
+    });
+  });
+}
+
+async function sendSiteCmd(tabId, siteId, cmd, extra = {}) {
+  if (siteId !== "claude") return sendCmd(tabId, cmd, extra);
+  try {
+    const results = await chrome.scripting.executeScript({
+      target: { tabId },
+      world: "MAIN",
+      func: (action, text) => {
+        const visible = (el) => el && el.getClientRects().length > 0 &&
+          getComputedStyle(el).visibility !== "hidden" && getComputedStyle(el).display !== "none";
+        const editor = [...document.querySelectorAll('div[contenteditable="true"], textarea')]
+          .find((el) => visible(el) && !el.disabled && !el.readOnly);
+        if (action === "isReady") return !!editor;
+        if (action === "debug") {
+          const button = [...document.querySelectorAll("button,[role=button]")]
+            .find((el) => visible(el) && !el.disabled && /send|enviar/i.test(el.getAttribute("aria-label") || ""));
+          return { siteId: "claude", url: location.href, isReady: !!editor,
+            experimental: false, found: { assistantMessage: document.querySelectorAll('[data-testid="assistant-message"]').length,
+              inputTextarea: !!editor, submitButton: !!button, generatingIndicator: !!document.querySelector('[data-is-streaming]') } };
+        }
+        if (action === "readLast") {
+          const nodes = [...document.querySelectorAll('[data-testid="assistant-message"], [data-is-streaming]')]
+            .filter(visible).map((el) => (el.innerText || el.textContent || "").trim()).filter(Boolean);
+          if (!nodes.length) throw new Error("readLast: resposta não encontrada");
+          return nodes[nodes.length - 1];
+        }
+        if (!editor) throw new Error("editor do Claude não encontrado");
+        if (action === "write") {
+          editor.focus();
+          document.execCommand("selectAll", false);
+          document.execCommand("delete", false);
+          const selection = getSelection();
+          const range = document.createRange();
+          range.selectNodeContents(editor); range.collapse(false);
+          selection?.removeAllRanges(); selection?.addRange(range);
+          document.execCommand("insertText", false, text);
+          if (!(editor.innerText || editor.textContent || "").trim()) {
+            editor.dispatchEvent(new InputEvent("beforeinput", { inputType: "insertText", data: text, bubbles: true, cancelable: true }));
+            editor.dispatchEvent(new InputEvent("input", { inputType: "insertText", data: text, bubbles: true }));
+          }
+          const actual = (editor.innerText || editor.textContent || "").trim();
+          if (!actual.includes(text.trim())) throw new Error("texto não permaneceu no editor");
+          return true;
+        }
+        if (action === "submit") {
+          const button = [...document.querySelectorAll("button,[role=button]")]
+            .find((el) => visible(el) && !el.disabled && /send|enviar/i.test(el.getAttribute("aria-label") || ""));
+          if (button) { button.click(); return true; }
+          editor.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", code: "Enter", bubbles: true, cancelable: true }));
+          return true;
+        }
+        throw new Error("comando Claude desconhecido: " + action);
+      },
+      args: [cmd, extra.text || ""],
+    });
+    return { ok: true, value: results?.[0]?.result };
+  } catch (e) {
+    return { ok: false, error: e.message || String(e) };
+  }
+}
+
+async function reportResult(taskId, site, ok, text, error, meta = {}) {
+  const body = JSON.stringify({ task_id: taskId, site, ok, text, error, ...meta });
+  let lastError = null;
+  for (let attempt = 0; attempt < 3; attempt++) {
+    try {
+      const response = await fetch(`${PAINEL_URL}/api/relay-council/result`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json", "X-Relay-Client": RELAY_CLIENT_ID },
+        body,
+        signal: AbortSignal.timeout(POLL_TIMEOUT_MS),
+      });
+      if (!response.ok) throw new Error(`painel respondeu HTTP ${response.status}`);
+      return;
+    } catch (e) {
+      lastError = e;
+      if (attempt < 2) await new Promise((resolve) => setTimeout(resolve, 500 * (attempt + 1)));
+    }
+  }
+  console.error("[relay] falha ao reportar resultado após 3 tentativas:", lastError?.message || lastError);
+}
+
+// popup pede status
+chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
+  if (!msg || !msg.cmd) return;
+  if (msg.cmd === "status") {
+    sendResponse({ ok: true, value: { connected, idleCount } });
+    return;
+  }
+  if (msg.cmd === "poll-now") {
+    pollOnce();
+    sendResponse({ ok: true });
+    return;
+  }
+});
+
+// Diagnóstico local do protótipo; não expõe credenciais nem dados do chat.
+globalThis.__relayPollOnce = pollOnce;
+globalThis.__relayClaudeCommand = (tabId, cmd, text = "") =>
+  sendSiteCmd(tabId, "claude", cmd, { text });
+
+// primeiro poll na instalação
+pollOnce();
diff --git a/redesign/painel_operacional/relay-extension-v2/content/_common.js b/redesign/painel_operacional/relay-extension-v2/content/_common.js
new file mode 100644
index 0000000000000000000000000000000000000000..f6cf4cdf2cf8558d555febb1edb2ba40560e8924
--- /dev/null
+++ b/redesign/painel_operacional/relay-extension-v2/content/_common.js
@@ -0,0 +1,183 @@
+// content/_common.js
+// Interface estável que todo site implementa. Os seletores ficam em cada site.
+// Não mexer aqui para adicionar site novo — só escrever content/<site>.js.
+
+(function () {
+  "use strict";
+
+  // Cada site registra-se em window.__relay com esta forma:
+  //
+  //   window.__relay = {
+  //     siteId: 'deepseek',
+  //     isReady:   () => true|false,
+  //     readLast:  () => Promise<string>,
+  //     write:     (text) => Promise<void>,
+  //     submit:    () => Promise<void>,
+  //     onRespond: (cb) => void,
+  //     debug:     () => Promise<DebugInfo>
+  //   };
+  //
+  // O background só fala com essa interface. Não sabe qual é o site.
+
+  const BRIDGE_TIMEOUT_MS = 8000;
+
+  // Helper: espera até que predicate() retorne true, com timeout.
+  window.__relayCommon = {
+    isVisible: function (el) {
+      if (!el) return false;
+      const style = window.getComputedStyle(el);
+      return el.getClientRects().length > 0 && style.visibility !== "hidden" && style.display !== "none";
+    },
+
+    // Alguns chats encapsulam o compositor em Shadow DOM aberto.
+    queryAllDeep: function (selector, root = document) {
+      const result = Array.from(root.querySelectorAll(selector));
+      for (const host of root.querySelectorAll("*")) {
+        if (host.shadowRoot) result.push(...this.queryAllDeep(selector, host.shadowRoot));
+      }
+      return result;
+    },
+
+    findEditable: function (preferredSelector = "") {
+      const generic = 'textarea, input:not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="file"]), [contenteditable="true"], [role="textbox"], [aria-multiline="true"]';
+      const selectors = preferredSelector ? `${preferredSelector}, ${generic}` : generic;
+      return this.queryAllDeep(selectors).find((el) =>
+        this.isVisible(el) && !el.disabled && !el.readOnly && el.getAttribute("aria-disabled") !== "true"
+      ) || null;
+    },
+
+    findSendButton: function (preferredSelector = "", editable = null) {
+      const selector = preferredSelector
+        ? `${preferredSelector}, button, [role="button"], input[type="submit"], input[type="button"]`
+        : 'button, [role="button"], input[type="submit"], input[type="button"]';
+      const candidates = this.queryAllDeep(selector).filter((el) =>
+        this.isVisible(el) && !el.disabled && el.getAttribute("aria-disabled") !== "true"
+      );
+      const editableParent = editable?.closest('form, [class*="composer"], [class*="input"], [class*="footer"]');
+      const scored = candidates.map((el) => {
+        const label = `${el.getAttribute("aria-label") || ""} ${el.getAttribute("title") || ""} ${el.getAttribute("data-testid") || ""} ${el.className || ""} ${el.innerText || ""}`.toLowerCase();
+        let score = 0;
+        if (/send|enviar|发送|submit|message/.test(label)) score += 10;
+        if (/send|submit/.test(label)) score += 5;
+        if (el.type === "submit") score += 4;
+        if (/cancel|stop|model|project|menu|more|attach|upload/.test(label)) score -= 12;
+        if (editableParent && (el.closest('form, [class*="composer"], [class*="input"], [class*="footer"]') === editableParent)) score += 6;
+        return { el, score };
+      }).sort((a, b) => b.score - a.score);
+      return scored[0]?.score > 0 ? scored[0].el : null;
+    },
+
+    submitEditable: function (el) {
+      if (!el) throw new Error("submit: editor não encontrado");
+      const form = el.closest("form");
+      if (form?.requestSubmit) {
+        form.requestSubmit();
+        return;
+      }
+      el.focus();
+      for (const type of ["keydown", "keypress", "keyup"]) {
+        el.dispatchEvent(new KeyboardEvent(type, { key: "Enter", code: "Enter", bubbles: true, cancelable: true }));
+      }
+    },
+
+    waitFor: async function (predicate, { timeout = 30000, interval = 200 } = {}) {
+      const start = Date.now();
+      while (Date.now() - start < timeout) {
+        try {
+          if (predicate()) return true;
+        } catch (_) {}
+        await new Promise((r) => setTimeout(r, interval));
+      }
+      return false;
+    },
+
+    // Helper: simular digitação num contenteditable (Gemini usa).
+    // Para <textarea> normal, basta setar .value e disparar input event.
+    typeIntoContentEditable: async function (el, text) {
+      el.click();
+      el.focus();
+      // Posicionar explicitamente a seleção evita que editores ProseMirror
+      // recebam o insertText no alvo anterior.
+      const selection = window.getSelection();
+      const range = document.createRange();
+      range.selectNodeContents(el);
+      range.collapse(false);
+      selection?.removeAllRanges();
+      selection?.addRange(range);
+      // execCommand ainda é o caminho mais compatível com os listeners dos
+      // editores React/Vue/ProseMirror que escutam input.
+      el.dispatchEvent(new InputEvent("beforeinput", {
+        inputType: "insertText", data: text, bubbles: true, cancelable: true,
+      }));
+      document.execCommand("insertText", false, text);
+      el.dispatchEvent(new InputEvent("input", { bubbles: true, data: text, inputType: "insertText" }));
+      // fallback se execCommand não funcionar ou deixar apenas o <br> vazio
+      if (!(el.innerText || el.textContent || "").trim()) {
+        el.textContent = text;
+        el.dispatchEvent(new InputEvent("input", { bubbles: true, data: text }));
+      }
+    },
+
+    typeIntoTextarea: function (el, text) {
+      const prototype = el instanceof HTMLInputElement
+        ? window.HTMLInputElement.prototype
+        : window.HTMLTextAreaElement.prototype;
+      const setter = Object.getOwnPropertyDescriptor(prototype, "value").set;
+      setter.call(el, text);
+      el.dispatchEvent(new Event("input", { bubbles: true }));
+    },
+
+    // Helper: achar último elemento que casa um seletor, em ordem de documento.
+    lastMatching: function (selector) {
+      const all = document.querySelectorAll(selector);
+      return all.length ? all[all.length - 1] : null;
+    },
+
+    // Helper: log estruturado no console da aba (para debug).
+    log: function (...args) {
+      console.log("[relay:" + (window.__relay?.siteId || "?") + "]", ...args);
+    },
+  };
+
+  // Escuta comandos do background. O background envia mensagens com
+  // { cmd: 'readLast' | 'write' | 'submit' | 'isReady' | 'debug', text?: string }.
+  // Responde com { ok: true, value?: ... } ou { ok: false, error: string }.
+  chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
+    if (!msg || !msg.cmd) return;
+    const relay = window.__relay;
+    if (!relay) {
+      sendResponse({ ok: false, error: "relay interface não registrada nesta aba" });
+      return;
+    }
+    (async () => {
+      try {
+        switch (msg.cmd) {
+          case "isReady":
+            sendResponse({ ok: true, value: !!relay.isReady() });
+            return;
+          case "readLast":
+            sendResponse({ ok: true, value: await relay.readLast() });
+            return;
+          case "write":
+            await relay.write(msg.text);
+            sendResponse({ ok: true });
+            return;
+          case "submit":
+            await relay.submit();
+            sendResponse({ ok: true });
+            return;
+          case "debug":
+            sendResponse({ ok: true, value: await relay.debug() });
+            return;
+          default:
+            sendResponse({ ok: false, error: "cmd desconhecido: " + msg.cmd });
+        }
+      } catch (e) {
+        sendResponse({ ok: false, error: String(e && e.message || e) });
+      }
+    })();
+    return true; // manter canal aberto pro async
+  });
+
+  window.__relayCommon.log("content script carregado");
+})();
diff --git a/redesign/painel_operacional/relay-extension-v2/content/_generic.js b/redesign/painel_operacional/relay-extension-v2/content/_generic.js
new file mode 100644
index 0000000000000000000000000000000000000000..b5654cb71f085d2b93a0a7592d268ee5a250d1e2
--- /dev/null
+++ b/redesign/painel_operacional/relay-extension-v2/content/_generic.js
@@ -0,0 +1,104 @@
+// Adaptador experimental para chats cujo DOM muda com frequência.
+// Cada wrapper fornece SITE_ID e alguns seletores específicos.
+(function () {
+  "use strict";
+  const C = window.__relayCommon;
+  window.__relayRegisterGeneric = function (cfg) {
+    const SITE_ID = cfg.siteId;
+    const selectors = {
+      input: cfg.input || 'textarea, [contenteditable="true"], [role="textbox"], [aria-multiline="true"]',
+      submit: cfg.submit || '',
+      assistant: cfg.assistant || '[data-message-author-role="assistant"], [data-author="assistant"], [class*="assistant"], [class*="response"], [class*="message"]',
+      generating: cfg.generating || '[aria-busy="true"], [class*="loading"], [class*="generat"], [class*="typing"]',
+    };
+    const blockedText = (cfg.blockedText || []).map((text) => String(text).toLowerCase());
+    let lastWrittenText = "";
+
+    function findInput() {
+      return C.findEditable(selectors.input);
+    }
+    function findSubmit() {
+      return C.findSendButton(selectors.submit, findInput());
+    }
+    function isReady() {
+      return !!findInput();
+    }
+    async function readLast() {
+      if (blockedText.length) {
+        const visibleText = (document.body.innerText || "").toLowerCase();
+        const blocked = blockedText.find((text) => visibleText.includes(text));
+        if (blocked) throw new Error(`provider_busy: aviso do provedor detectado (${blocked})`);
+      }
+      const candidates = C.queryAllDeep(selectors.assistant).filter((el) => {
+        if (!C.isVisible(el)) return false;
+        if (el.matches('textarea, input, [contenteditable="true"], [role="textbox"]')) return false;
+        if (el.querySelector('textarea, input, [contenteditable="true"], [role="textbox"]')) return false;
+        return true;
+      });
+      const withText = candidates.map((el) => ({ el, text: (el.innerText || el.textContent || "").trim() }))
+        .filter(({ text }) => text && text !== lastWrittenText);
+      const item = withText[withText.length - 1];
+      const el = item?.el;
+      if (!el) throw new Error("readLast: resposta não encontrada");
+      const text = item.text;
+      if (!text) throw new Error("readLast: resposta vazia");
+      return text;
+    }
+    async function write(text) {
+      const el = findInput();
+      if (!el) throw new Error("write: input não encontrado");
+      lastWrittenText = text.trim();
+      el.focus();
+      if (el.tagName === "TEXTAREA" || el.tagName === "INPUT") {
+        C.typeIntoTextarea(el, text);
+      } else {
+        document.execCommand("selectAll", false);
+        document.execCommand("delete", false);
+        await C.typeIntoContentEditable(el, text);
+      }
+      await C.waitFor(() => {
+        const current = findInput();
+        return current && ((current.value || "") === text || (current.textContent || "") === text);
+      }, { timeout: 3000, interval: 100 });
+    }
+    async function submit() {
+      const button = findSubmit();
+      if (button) {
+        const input = findInput();
+        button.click();
+        const cleared = await C.waitFor(() => {
+          const current = findInput();
+          return !current || !(current.value || current.textContent || "").trim();
+        }, { timeout: 1200, interval: 100 });
+        if (cleared) return;
+        // Alguns sites exibem o botão, mas não o conectam ao compositor atual.
+        if (input) C.submitEditable(input);
+        return;
+      }
+      const input = findInput();
+      if (input) { C.submitEditable(input); return; }
+      throw new Error("submit: botão e editor não encontrados");
+    }
+    function onRespond(cb) {
+      let timer;
+      const target = document.querySelector("main") || document.body;
+      const observer = new MutationObserver(() => {
+        clearTimeout(timer);
+        timer = setTimeout(cb, 8000);
+      });
+      observer.observe(target, { childList: true, subtree: true, characterData: true });
+    }
+    async function debug() {
+      return {
+        siteId: SITE_ID, url: location.href, isReady: isReady(), experimental: true,
+        found: {
+          assistantMessage: C.queryAllDeep(selectors.assistant).length,
+          inputTextarea: !!findInput(), submitButton: !!findSubmit(),
+          generatingIndicator: !!C.queryAllDeep(selectors.generating).find(C.isVisible),
+        },
+      };
+    }
+    window.__relay = { siteId: SITE_ID, isReady, readLast, write, submit, onRespond, debug };
+    C.log("adaptador experimental registrado");
+  };
+})();
diff --git a/redesign/painel_operacional/relay-extension-v2/content/chatgpt.js b/redesign/painel_operacional/relay-extension-v2/content/chatgpt.js
new file mode 100644
index 0000000000000000000000000000000000000000..5ed024670ab2469962759ee81fa873641d849a41
--- /dev/null
+++ b/redesign/painel_operacional/relay-extension-v2/content/chatgpt.js
@@ -0,0 +1,11 @@
+(function () {
+  window.__relayRegisterGeneric({
+    siteId: "chatgpt",
+    input: 'textarea, [contenteditable="true"]',
+    submit: 'button[data-testid*="send"], button[aria-label*="Send"], button[aria-label*="Enviar"]',
