diff --git a/redesign/systemd/dropin-ollama-bind.conf b/redesign/systemd/dropin-ollama-bind.conf
new file mode 100644
index 0000000..c2f3277
--- /dev/null
+++ b/redesign/systemd/dropin-ollama-bind.conf
@@ -0,0 +1,11 @@
+# Agata -- Ollama: bind de rede + flash attention. Invariante de segurança
+# do P-4 (OLLAMA_HOST nunca 0.0.0.0, config/portas-agata.txt:39) e padrão
+# seguro (FLASH_ATTENTION=1) -- os dois iguais em qualquer clone, não
+# dependem de hardware. Instala com sudo em
+# /etc/systemd/system/ollama.service.d/agata-bind.conf -- NUNCA sobrescrever
+# override.conf inteiro pra chegar aqui (lição MEMÓRIAS 127/130: um `tee`
+# destrutivo já apagou 3 variáveis assim). Ver dropin-ollama-gpu.exemplo.conf,
+# ao lado, para o perfil de hardware (instância, não este arquivo).
+[Service]
+Environment="OLLAMA_HOST=127.0.0.1:11434"
+Environment="OLLAMA_FLASH_ATTENTION=1"
diff --git a/redesign/systemd/dropin-ollama-gpu.exemplo.conf b/redesign/systemd/dropin-ollama-gpu.exemplo.conf
new file mode 100644
index 0000000..dc6c40a
--- /dev/null
+++ b/redesign/systemd/dropin-ollama-gpu.exemplo.conf
@@ -0,0 +1,14 @@
+# EXEMPLO -- não é o arquivo real desta Máquina (instância, fora do git,
+# mesmo tratamento de CHAVES.env.exemplo vs CHAVES.md). Perfil de hardware
+# do Ollama: calibrado pra 1 GPU NVIDIA com 8 GB de VRAM (q4_0 pra caber).
+# Instala com sudo em /etc/systemd/system/ollama.service.d/agata-gpu.conf --
+# NUNCA sobrescrever override.conf inteiro (lição MEMÓRIAS 127/130). Ajuste
+# os 3 valores pro hardware real antes de instalar: NUM_GPU pro tanto de
+# camadas que a VRAM aguenta (999 = "todas", seguro só com VRAM sobrando ou
+# quantização agressiva), CUDA_VISIBLE_DEVICES pro índice da GPU certa
+# (`nvidia-smi -L`), KV_CACHE_TYPE pro nível de quantização do cache
+# (q4_0/q8_0/f16 -- mais memória = f16, menos = q4_0).
+[Service]
+Environment="OLLAMA_NUM_GPU=999"
+Environment="CUDA_VISIBLE_DEVICES=0"
+Environment="OLLAMA_KV_CACHE_TYPE=q4_0"
