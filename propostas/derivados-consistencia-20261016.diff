--- a/.githooks/post-commit
+++ b/.githooks/post-commit
@@ -78,6 +78,14 @@ fi
 cd "$RAIZ_HOOK" || exit 0
 unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
 
+# Consistência dos derivados (achado do Codex, 16/10/2026): vault, índice e envio leem o checkout VIVO, e um `git pull`,
+# checkout ou edição feita enquanto eles rodam mistura duas versões sob o mesmo rótulo de SHA. Aqui só se DETECTA (o
+# lock não impede quem não passa por ele): mede o HEAD e o estado dos arquivos rastreados antes e depois da geração;
+# se mudou, avisa e deixa um marcador para o próximo `--atualizar`/commit refazer. Fail-soft: nunca bloqueia o commit.
+estado_checkout() { printf '%s\n' "$(git rev-parse HEAD 2>/dev/null)"; git status --porcelain --untracked-files=no 2>/dev/null; }
+ESTADO_INICIO="$(estado_checkout | sha256sum | cut -d' ' -f1)"
+SHA_INICIO="$(git rev-parse HEAD 2>/dev/null)"
+
 # 2. Vault Obsidian derivado — refaz memoria/obsidian/ a cada commit para
 # ficar sempre em dia com MEMÓRIAS.md e o canon. É gitignorado, não entra
 # no commit. Fail-soft: nunca atrapalha o commit (MEMÓRIAS (290)).
@@ -147,4 +155,13 @@ if [ -f scripts/gerar_indice_derivado.py ]; then
   fi
 fi
 
+# Fim da geração: o checkout mudou enquanto os derivados eram gerados?
+if [ "$(estado_checkout | sha256sum | cut -d' ' -f1)" != "$ESTADO_INICIO" ]; then
+  mkdir -p "$HOME/.cache/agata"
+  printf '%s %s\n' "$(date -Iseconds)" "$SHA_INICIO" > "$HOME/.cache/agata/derivados-possivelmente-misturados"
+  echo "post-commit: AVISO — o checkout mudou durante a geração dos derivados (pull, checkout ou edição); vault e índice rotulados $SHA_INICIO podem misturar duas versões. Refaça: python3 scripts/busca_semantica.py --atualizar e um novo commit/pull (marcador em ~/.cache/agata/derivados-possivelmente-misturados)." >&2
+else
+  rm -f "$HOME/.cache/agata/derivados-possivelmente-misturados"
+fi
+
 exit 0
