+            finally:
+                if antigo is None:
+                    os.environ.pop("AGATA_NV_CACHE", None)
+                else:
+                    os.environ["AGATA_NV_CACHE"] = antigo
+
+
+if __name__ == "__main__":
+    unittest.main()
