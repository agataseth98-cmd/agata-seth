+                                               documentos=[{"id": "d1", "texto": "x"}]))
+        self.assertEqual(ok["task_id"], "rec-teste")
+        conjunto.validar(self.base_tarefa(criterios=[{"tipo": "cita", "valor": ["115"]}]))   # conjunto antigo: sem documentos, ok
