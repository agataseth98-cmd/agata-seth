diff --git a/redesign/alexandria/aquisicao.py b/redesign/alexandria/aquisicao.py
new file mode 100644
index 00000000..2da9de71
--- /dev/null
+++ b/redesign/alexandria/aquisicao.py
@@ -0,0 +1,216 @@
+"""Aquisição de fontes externas da Alexandria, em quarentena (lote 5, pacote C4).
+
+Três entradas, um só caminho: upload pelo painel, pasta de entrada (`<dados>/alexandria/entrada/`) e URL colada
+(egresso por `scripts/politica_egress.buscar_seguro`). Todas passam por `guardar_arquivo`: tamanho (25 MiB),
+extensão (md, txt, html, pdf), assinatura do conteúdo, cota da pasta (500 MB), sha256 e nome `<sha>.<ext>`.
+Depois, `processar` faz o parse isolado (texto puro no stdlib; PDF só no sandbox bwrap, sem rede) e a análise
+de quarentena. Nada aqui chega ao índice pesquisável: isso exige `revisado`, decidido pelo Humano no painel.
+"""
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import html.parser
+import os
+import re
+import shutil
+import sys
+import time
+from pathlib import Path
+
+AQUI = Path(__file__).resolve().parent
+RAIZ = AQUI.parents[1]
+for _p in (AQUI, RAIZ / "redesign" / "nova_versao", RAIZ / "redesign" / "grafo", RAIZ / "redesign" / "metacognicao",
+           RAIZ / "redesign" / "router", RAIZ / "scripts"):
+    sys.path.insert(0, str(_p))
+import caminhos  # noqa: E402
+import cadastro  # noqa: E402
+import eventos  # noqa: E402
+
+MAX_BYTES = 25 * 1024 * 1024
+COTA_BYTES = 500 * 1024 * 1024
+MAX_TEXTO = 2_000_000
+EXTENSOES = ("md", "txt", "html", "pdf")
+ASSINATURAS_PROIBIDAS = (b"\x7fELF", b"MZ", b"PK\x03\x04", b"#!")
+
+
+def entrada() -> Path:
+    p = eventos.dados() / "alexandria" / "entrada"
+    p.mkdir(parents=True, exist_ok=True)
+    os.chmod(p, 0o700)
+    return p
+
+
+def _motivo_conteudo(ext: str, cabeca: bytes) -> str | None:
+    if any(cabeca.startswith(a) for a in ASSINATURAS_PROIBIDAS):
+        return "assinatura de executável ou script: recusado"
+    if ext == "pdf":
+        return None if cabeca.startswith(b"%PDF-") else "não é PDF (cabeçalho errado)"
+    if b"\x00" in cabeca:
+        return "binário onde se esperava texto"
+    try:
+        cabeca.decode("utf-8")
+    except UnicodeDecodeError as e:
+        if e.start < len(cabeca) - 4:   # corte no meio de caractere no fim da leitura é normal
+            return "texto não é UTF-8"
+    return None
+
+
+def _cota_usada() -> int:
+    return sum(f.stat().st_size for f in entrada().iterdir() if f.is_file() and not f.is_symlink())
+
+
+def guardar_arquivo(tmp: Path, extensao: str, rotulo: str, *, origem_tipo: str, origem_uri: str | None = None) -> dict:
+    """Recebe um arquivo já escrito num temporário da pasta de entrada e o põe sob o próprio sha256."""
+    if extensao not in EXTENSOES:
+        raise ValueError("extensão fora da lista")
+    tmp = Path(tmp)
+    if tmp.is_symlink() or not tmp.is_file():
+        raise ValueError("arquivo irregular")
+    tamanho = tmp.stat().st_size
+    if tamanho == 0 or tamanho > MAX_BYTES:
+        raise ValueError("tamanho fora do limite (até 25 MiB)")
+    with tmp.open("rb") as f:
+        cabeca = f.read(4096)
+    motivo = _motivo_conteudo(extensao, cabeca)
+    if motivo:
+        raise ValueError(motivo)
+    h = hashlib.sha256()
+    with tmp.open("rb") as f:
+        for bloco in iter(lambda: f.read(65536), b""):
+            h.update(bloco)
+    sha = h.hexdigest()
+    with open(entrada() / ".lock", "w") as trava:
+        fcntl.flock(trava, fcntl.LOCK_EX)
+        try:
+            if cadastro.ler(sha) is not None:
+                tmp.unlink(missing_ok=True)
+                return {"cadastro": cadastro.ler(sha), "duplicado": True}
+            if _cota_usada() + tamanho > COTA_BYTES:
+                tmp.unlink(missing_ok=True)
+                raise ValueError("cota da pasta de entrada cheia (500 MB)")
+            destino = caminhos.arquivo_do_acervo(entrada(), sha, extensao)
+            os.replace(tmp, destino)
+            os.chmod(destino, 0o600)
+        except Exception:
+            tmp.unlink(missing_ok=True)
+            raise
+    obj = cadastro.criar(sha, extensao, rotulo or tmp.name, origem_uri=origem_uri, tamanho=tamanho,
+                         origem_tipo=origem_tipo)
+    return {"cadastro": obj, "duplicado": False}
+
+
+def importar_pasta() -> list[dict]:
+    """Arquivos soltos na pasta de entrada (o Humano copia para lá): entram pelo mesmo caminho, sem symlink."""
+    out = []
+    for arq in sorted(entrada().iterdir()):
+        if arq.is_symlink() or not arq.is_file() or arq.name.startswith("."):
+            continue
+        ext = arq.suffix.lower().lstrip(".")
+        if ext not in EXTENSOES:
+            out.append({"arquivo": arq.name, "erro": "extensão fora da lista"})
+            continue
+        try:
+            r = guardar_arquivo(arq, ext, arq.name, origem_tipo="pasta")
+            out.append({"arquivo": arq.name, "sha256": r["cadastro"]["sha256"], "duplicado": r["duplicado"]})
+        except ValueError as e:
+            out.append({"arquivo": arq.name, "erro": str(e)})
+    return out
+
+
+def receber_url(url: str, buscar=None) -> dict:
+    """URL colada: egresso seguro (cada salto validado), teto de 25 MiB, só status 200."""
+    limpa = cadastro.sanear_uri(url)
+    if buscar is None:
+        import politica_egress  # noqa: E402
+        buscar = politica_egress.buscar_seguro
+    tmp = entrada() / f".url-{os.getpid()}-{time.monotonic_ns()}.tmp"
+    ok, status, final, motivo = buscar(limpa, str(tmp), max_bytes=MAX_BYTES)
+    if not ok or status != 200:
+        tmp.unlink(missing_ok=True)
+        raise ValueError(f"não baixado: {motivo or f'status {status}'}")
+    with tmp.open("rb") as f:
+        cabeca = f.read(4096)
+    if cabeca.startswith(b"%PDF-"):
+        ext = "pdf"
+    elif cabeca.lstrip()[:1] == b"<":
+        ext = "html"
+    else:
+        ext = "md" if limpa.lower().endswith(".md") else "txt"
+    return guardar_arquivo(tmp, ext, limpa.rsplit("/", 1)[-1] or "pagina", origem_tipo="url", origem_uri=limpa)
+
+
+class _TextoHTML(html.parser.HTMLParser):
+    def __init__(self):
+        super().__init__()
+        self.partes, self._pular = [], 0
+
+    def handle_starttag(self, tag, attrs):
+        if tag in ("script", "style", "noscript"):
+            self._pular += 1
+
+    def handle_endtag(self, tag):
+        if tag in ("script", "style", "noscript") and self._pular:
+            self._pular -= 1
+
+    def handle_data(self, data):
+        if not self._pular:
+            self.partes.append(data)
+
+
+def _texto_de(path: Path, ext: str) -> tuple[str | None, str | None]:
+    """(texto, motivo_de_rejeição). PDF só pelo sandbox, sem rede e com limite de saída."""
+    if ext in ("md", "txt"):
+        return path.read_text(encoding="utf-8", errors="replace"), None
+    if ext == "html":
+        p = _TextoHTML()
+        p.feed(path.read_text(encoding="utf-8", errors="replace"))
+        return " ".join(" ".join(p.partes).split()), None
+    if ext == "pdf":
+        import sandbox  # noqa: E402
+        if not sandbox.disponivel() or not shutil.which("pdftotext"):
+            return None, "sem parser de PDF (bwrap ou pdftotext ausente)"
+        r = sandbox.run_sandboxed(["pdftotext", "-layout", "-enc", "UTF-8", str(path), "-"], ro=[str(path)],
+                                  net=False, timeout=60)
+        if r["exit_code"] != 0:
+            return None, f"parser de PDF falhou (rc {r['exit_code']})"
+        return r["stdout"], None
+    return None, "extensão sem parser"
+
+
+def processar(sha: str) -> dict:
+    """Quarentena: recebido -> quarentena -> catalogado | restrito | rejeitado. Só a máquina, sem decidir direitos."""
+    obj = cadastro.ler(sha)
+    if obj is None:
+        raise ValueError("objeto não cadastrado")
+    if obj["editorial_status"] != "recebido":
+        return obj
+    cadastro.transicionar(sha, "quarentena", "maquina", "entrou em quarentena")
+    arq = caminhos.arquivo_do_acervo(entrada(), sha, obj["extensao"])
+    texto, motivo = _texto_de(arq, obj["extensao"])
+    if motivo:
+        cadastro.anotar(sha, parse="falhou", motivo=motivo)
+        return cadastro.transicionar(sha, "rejeitado", "maquina", motivo)
+    if len(texto) > MAX_TEXTO:
+        cadastro.anotar(sha, parse="grande demais")
+        return cadastro.transicionar(sha, "rejeitado", "maquina", "texto acima de 2 M caracteres")
+    import guarda  # noqa: E402
+    import sanitizar  # noqa: E402
+    g = guarda.marcar(texto)
+    pessoal = sanitizar.varrer_pessoal(texto, sanitizar._nomes_projeto())
+    segredos = sanitizar.varrer(texto)
+    texto_path = cadastro.texto_path(sha)
+    texto_path.parent.mkdir(parents=True, exist_ok=True)
+    texto_path.write_text(texto, encoding="utf-8")
+    os.chmod(texto_path, 0o600)
+    sinais = {"autoridade_alegada": g["autoridade"], "instrucao_embutida": g["instrucao"],
+              "dado_pessoal": len(pessoal), "segredos": len(segredos), "caracteres": len(texto)}
+    cadastro.anotar(sha, parse="ok", sinais=sinais)
+    if pessoal or segredos:
+        # dado pessoal ou segredo: fica restrito (nunca consultável sem decisão explícita do Humano)
+        return cadastro.transicionar(sha, "restrito", "maquina", "dado pessoal ou segredo detectado (contagem)")
+    return cadastro.transicionar(sha, "catalogado", "maquina", "análise de quarentena sem sinais de restrição")
+
+
+def processar_pendentes() -> list[dict]:
+    return [processar(c["sha256"]) for c in cadastro.listar() if c["editorial_status"] == "recebido"]
diff --git a/redesign/alexandria/cadastro.py b/redesign/alexandria/cadastro.py
new file mode 100644
index 00000000..f9cf0ceb
--- /dev/null
+++ b/redesign/alexandria/cadastro.py
@@ -0,0 +1,171 @@
+"""Cadastro de objetos externos da Alexandria (lote 5, pacote C1).
+
+Um arquivo JSON por objeto, em `<dados>/alexandria/cadastro/ext:<sha256>.json` (0600). É a fonte de verdade do
+que é externo: origem (sem query nem credenciais), direitos, acesso, estado editorial e verificação. O índice
+derivado (`acervo.indexar`) é projetado daqui. Cada mudança vira evento no ledger, com a chave idempotente
+`alex:<sha>:<estado>`, e o ledger não recebe o conteúdo nem a URI completa.
+
+Regras:
+- automático (pipeline, ator "maquina") só faz: recebido -> quarentena, e quarentena -> catalogado|restrito|rejeitado;
+- todo o resto exige ator "humano" (promoção a `revisado`, contestar, arquivar, rejeitar, decidir direitos);
+- `revisado` com direitos `desconhecido` guarda só a referência: o texto não é indexado.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import sys
+import tempfile
+import time
+import urllib.parse
+from pathlib import Path
+
+AQUI = Path(__file__).resolve().parent
+sys.path.insert(0, str(AQUI.parents[0] / "nova_versao"))
+import caminhos  # noqa: E402
+import eventos  # noqa: E402
+
+ESTADOS = ("recebido", "quarentena", "catalogado", "revisado", "contestado", "restrito", "arquivado", "rejeitado")
+TRANSICOES = {
+    "recebido": {"quarentena"},
+    "quarentena": {"catalogado", "restrito", "rejeitado"},
+    "catalogado": {"revisado", "contestado", "restrito", "arquivado", "rejeitado"},
+    "revisado": {"contestado", "restrito", "arquivado"},
+    "contestado": {"revisado", "arquivado", "rejeitado"},
+    "restrito": {"catalogado", "arquivado"},
+    "arquivado": set(),
+    "rejeitado": set(),
+}
+AUTOMATICAS = {("recebido", "quarentena"), ("quarentena", "catalogado"), ("quarentena", "restrito"), ("quarentena", "rejeitado")}
+DIREITOS = ("pendente", "livre", "permitido_pelo_humano", "desconhecido")
+RE_SHA = re.compile(r"[0-9a-f]{64}")
+
+
+def pasta() -> Path:
+    p = eventos.dados() / "alexandria" / "cadastro"
+    p.mkdir(parents=True, exist_ok=True)
+    os.chmod(p, 0o700)
+    return p
+
+
+def object_id(sha: str) -> str:
+    return "ext:" + caminhos.id_seguro(sha, RE_SHA)
+
+
+def _arquivo(sha: str) -> Path:
+    return caminhos.dentro(pasta(), object_id(sha) + ".json")
+
+
+def sanear_uri(url: str | None) -> str | None:
+    """Só esquema http(s), host e caminho: sem usuário, senha, query nem fragmento (não vazam token)."""
+    if not url:
+        return None
+    p = urllib.parse.urlsplit(url.strip())
+    if p.scheme not in ("http", "https") or not p.hostname:
+        raise ValueError("URI sem esquema http(s) ou sem host")
+    host = p.hostname + (f":{p.port}" if p.port else "")
+    return urllib.parse.urlunsplit((p.scheme, host, p.path or "/", "", ""))
+
+
+def _gravar(obj: dict) -> None:
+    dest = _arquivo(obj["sha256"])
+    fd, tmp = tempfile.mkstemp(dir=pasta(), prefix=".cad.", suffix=".json")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        json.dump(obj, f, ensure_ascii=False, indent=1)
+    os.chmod(tmp, 0o600)
+    os.replace(tmp, dest)
+
+
+def ler(sha: str) -> dict | None:
+    arq = _arquivo(sha)
+    return json.loads(arq.read_text(encoding="utf-8")) if arq.exists() else None
+
+
+def listar() -> list[dict]:
+    out = []
+    for arq in sorted(pasta().glob("ext:*.json")):
+        try:
+            out.append(json.loads(arq.read_text(encoding="utf-8")))
+        except (OSError, ValueError):
+            continue
+    return out
+
+
+def criar(sha256: str, extensao: str, rotulo: str, *, origem_uri: str | None = None, tamanho: int = 0,
+          origem_tipo: str = "arquivo") -> dict:
+    """Entrada nova em `recebido`. Idempotente: o mesmo sha devolve o cadastro já existente."""
+    existente = ler(sha256)
+    if existente:
+        return existente
+    if extensao not in ("md", "txt", "html", "pdf"):
+        raise ValueError("extensão fora da lista")
+    agora = time.strftime("%Y-%m-%dT%H:%M:%S%z")
+    obj = {"schema_version": 1, "object_id": object_id(sha256), "sha256": sha256, "extensao": extensao,
+           "rotulo": " ".join(re.sub(r"[\x00-\x1f\x7f]", " ", rotulo or "")[:120].split()), "tamanho": int(tamanho),
+           "origem_tipo": origem_tipo,
+           "origem_uri": sanear_uri(origem_uri), "editorial_status": "recebido",
+           "direitos": {"status": "pendente", "evidencia": None, "decidido_por": None},
+           "acesso": {"classification": "project"},
+           "verificacao": {"identidade": "not_checked", "integridade": "sha256", "suporte": "not_checked"},
+           "relacoes": [], "adquirido_em": agora, "historico": []}
+    _gravar(obj)
+    eventos.registrar("observation", "recebido", f"alex:{sha256}", componente="alexandria",
+                      classification="project", chave=f"alex:{sha256}:recebido", tamanho=int(tamanho), extensao=extensao)
+    return obj
+
+
+def transicionar(sha: str, para: str, ator: str, motivo: str) -> dict:
+    obj = ler(sha)
+    if obj is None:
+        raise ValueError("objeto não cadastrado")
+    atual = obj["editorial_status"]
+    if para not in ESTADOS or para not in TRANSICOES.get(atual, set()):
+        raise ValueError(f"transição {atual} -> {para} não permitida")
+    if ator not in ("maquina", "humano"):
+        raise ValueError("ator inválido")
+    if ator == "maquina" and (atual, para) not in AUTOMATICAS:
+        raise ValueError("só o Humano faz essa transição")
+    if para == "revisado" and obj["direitos"]["status"] == "pendente":
+        raise ValueError("defina os direitos antes de revisar")
+    obj["editorial_status"] = para
+    obj["historico"].append({"de": atual, "para": para, "ator": ator, "motivo": (motivo or "")[:200],
+                             "em": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
+    _gravar(obj)
+    eventos.registrar("decision" if ator == "humano" else "verification", para, f"alex:{sha}", actor=ator,
+                      componente="alexandria", classification="project", chave=f"alex:{sha}:{para}:{len(obj['historico'])}",
+                      de=atual)
+    return obj
+
+
+def definir_direitos(sha: str, status: str, evidencia: str, ator: str) -> dict:
+    """Decisão de direitos: só o Humano. Sem evidência escrita, não há decisão."""
+    if ator != "humano":
+        raise ValueError("direitos só o Humano decide")
+    if status not in DIREITOS or status == "pendente":
+        raise ValueError("status de direitos inválido")
+    obj = ler(sha)
+    if obj is None:
+        raise ValueError("objeto não cadastrado")
+    if not (evidencia or "").strip():
+        raise ValueError("a decisão de direitos precisa de evidência escrita")
+    obj["direitos"] = {"status": status, "evidencia": evidencia.strip()[:300], "decidido_por": "humano",
+                       "em": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
+    _gravar(obj)
+    eventos.registrar("decision", status, f"alex:{sha}", actor="humano", componente="alexandria",
+                      classification="project", chave=f"alex:{sha}:direitos:{status}:{obj['direitos']['em']}")
+    return obj
+
+
+def anotar(sha: str, **campos) -> dict:
+    """Anotações da máquina (parse, sinais de quarentena). Não muda o estado editorial."""
+    obj = ler(sha)
+    if obj is None:
+        raise ValueError("objeto não cadastrado")
+    obj.setdefault("analise", {}).update(campos)
+    _gravar(obj)
+    return obj
+
+
+def texto_path(sha: str) -> Path:
+    return caminhos.dentro(eventos.dados() / "alexandria" / "texto", f"{caminhos.id_seguro(sha, RE_SHA)}.txt")
diff --git a/redesign/alexandria/ciclo_skills.py b/redesign/alexandria/ciclo_skills.py
new file mode 100644
index 00000000..0c70c670
--- /dev/null
+++ b/redesign/alexandria/ciclo_skills.py
@@ -0,0 +1,181 @@
+"""Ciclo de vida de skills candidatas da Alexandria (lote 5, pacote C5).
+
+Estados (próprios, separados do editorial de fontes):
+  rascunho -> quarentena -> em-teste -> elegivel -> revogada
+Regras:
+- nada aqui instala skill: `elegivel` só gera um `.diff` rascunho para o fluxo P-8 (propostas/, assinatura do Humano);
+- máquina só faz rascunho -> quarentena; todo o resto é decisão do Humano;
+- `revogada` é terminal: uso futuro impedido; o histórico fica (ledger);
+- uso registra eventos: disponivel, selecionada, lida (com comparação de sha), aplicada, testada.
+"""
+from __future__ import annotations
+
+import difflib
+import hashlib
+import json
+import os
+import re
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+AQUI = Path(__file__).resolve().parent
+RAIZ = AQUI.parents[1]
+for _p in (AQUI, RAIZ / "redesign" / "nova_versao", RAIZ / "redesign" / "painel_operacional"):
+    sys.path.insert(0, str(_p))
+import caminhos  # noqa: E402
+import eventos  # noqa: E402
+
+ESTADOS = ("rascunho", "quarentena", "em-teste", "elegivel", "revogada")
+TRANSICOES = {"rascunho": {"quarentena", "revogada"}, "quarentena": {"em-teste", "revogada"},
+              "em-teste": {"elegivel", "revogada"}, "elegivel": {"revogada"}, "revogada": set()}
+USOS = ("disponivel", "selecionada", "lida", "aplicada", "testada")
+RE_NOME = re.compile(r"[a-z0-9]+(-[a-z0-9]+)*")
+LIMITE_NOME, LIMITE_DESC = 64, 1024
+
+
+def pasta() -> Path:
+    p = eventos.dados() / "alexandria" / "skills-ciclo"
+    p.mkdir(parents=True, exist_ok=True)
+    os.chmod(p, 0o700)
+    return p
+
+
+def _arquivo(nome: str) -> Path:
+    if not RE_NOME.fullmatch(nome or "") or len(nome) > LIMITE_NOME:
+        raise ValueError("nome de skill inválido")
+    return caminhos.dentro(pasta(), nome + ".json")
+
+
+def ler(nome: str) -> dict | None:
+    a = _arquivo(nome)
+    return json.loads(a.read_text(encoding="utf-8")) if a.exists() else None
+
+
+def _gravar(obj: dict) -> None:
+    dest = _arquivo(obj["nome"])
+    fd, tmp = tempfile.mkstemp(dir=pasta(), prefix=".sk.", suffix=".json")
+    with os.fdopen(fd, "w", encoding="utf-8") as f:
+        json.dump(obj, f, ensure_ascii=False, indent=1)
+    os.chmod(tmp, 0o600)
+    os.replace(tmp, dest)
+
+
+def listar() -> list[dict]:
+    out = []
+    for a in sorted(pasta().glob("*.json")):
+        try:
+            out.append(json.loads(a.read_text(encoding="utf-8")))
+        except (OSError, ValueError):
+            continue
+    return out
+
+
+def revogadas() -> set[str]:
+    """Usado por skills.selecionar: uma skill revogada não é sugerida nem usada."""
+    return {o["nome"] for o in listar() if o["estado"] == "revogada"}
+
+
+def _lint(texto: str, nome: str) -> list[str]:
+    import qualidade_llm  # noqa: E402
+    campos, _linhas = qualidade_llm.frontmatter(texto)
+    problemas = []
+    if campos.get("name") != nome:
+        problemas.append("name difere do nome")
+    if not RE_NOME.fullmatch(campos.get("name", "")) or len(campos.get("name", "")) > LIMITE_NOME:
+        problemas.append("name inválido")
+    desc = campos.get("description", "")
+    if not desc:
+        problemas.append("description vazia")
+    if len(desc) > LIMITE_DESC:
+        problemas.append("description acima do limite")
+    if re.search(r"</?[a-z]+>", desc):
+        problemas.append("description com tag XML")
+    return problemas
+
+
+def rascunhar(nome: str, titulo: str, descricao: str, gatilhos: list[str], fontes: list[str]) -> dict:
+    """Esqueleto de SKILL.md em `alexandria/skills/rascunho/<nome>/`. Sem fontes, não há rascunho."""
+    if not fontes:
+        raise ValueError("uma skill precisa de fontes declaradas")
+    if not RE_NOME.fullmatch(nome) or len(nome) > LIMITE_NOME:
+        raise ValueError("nome inválido")
+    corpo = (f"---\nname: {nome}\ndescription: {' '.join(descricao.split())[:LIMITE_DESC]}\n---\n\n"
+             f"# {titulo}\n\n## Quando usar\n" + "".join(f"- {g}\n" for g in gatilhos) +
+             "\n## Fontes\n" + "".join(f"- {f}\n" for f in fontes) +
+             "\n## Casos de teste\n- (a escrever antes de sair do rascunho)\n")
+    problemas = _lint(corpo, nome)
+    if problemas:
+        raise ValueError("rascunho reprovado: " + ", ".join(problemas))
+    d = eventos.dados() / "alexandria" / "skills" / "rascunho" / nome
+    d.mkdir(parents=True, exist_ok=True)
+    (d / "SKILL.md").write_text(corpo, encoding="utf-8")
+    sha = hashlib.sha256(corpo.encode()).hexdigest()
+    obj = {"schema_version": 1, "nome": nome, "estado": "rascunho", "sha256": sha, "fontes": list(fontes),
+           "historico": [{"de": None, "para": "rascunho", "ator": "maquina", "em": time.strftime("%Y-%m-%dT%H:%M:%S%z")}],
+           "testes": None}
+    _gravar(obj)
+    eventos.registrar("observation", "rascunho", f"skill:{nome}", componente="alexandria", classification="project",
+                      chave=f"skill:{nome}:rascunho:{sha[:12]}", sha256=sha)
+    return obj
+
+
+def transicionar(nome: str, para: str, ator: str, motivo: str, *, evidencia: str | None = None) -> dict:
+    obj = ler(nome)
+    if obj is None:
+        raise ValueError("skill desconhecida")
+    atual = obj["estado"]
+    if para not in TRANSICOES.get(atual, set()):
+        raise ValueError(f"transição {atual} -> {para} não permitida")
+    if ator not in ("maquina", "humano"):
+        raise ValueError("ator inválido")
+    if ator == "maquina" and (atual, para) != ("rascunho", "quarentena"):
+        raise ValueError("só o Humano faz essa transição")
+    if para == "elegivel":
+        if not (evidencia or "").strip():
+            raise ValueError("elegível exige evidência do teste (resumo escrito)")
+        obj["testes"] = {"evidencia": evidencia.strip()[:500], "em": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
+    obj["estado"] = para
+    obj["historico"].append({"de": atual, "para": para, "ator": ator, "motivo": (motivo or "")[:200],
+                             "em": time.strftime("%Y-%m-%dT%H:%M:%S%z")})
+    _gravar(obj)
+    eventos.registrar("decision" if ator == "humano" else "verification", para, f"skill:{nome}", actor=ator,
+                      componente="alexandria", classification="project",
+                      chave=f"skill:{nome}:{para}:{len(obj['historico'])}", de=atual)
+    return obj
+
+
+def registrar_uso(nome: str, uso: str, *, sha_lido: str | None = None) -> dict:
+    """Uso de uma skill. `lida` compara o hash lido com o atual: diferença = a skill mudou entre a seleção e a leitura."""
+    if uso not in USOS:
+        raise ValueError("uso fora da lista")
+    obj = ler(nome)
+    if obj is None:
+        raise ValueError("skill desconhecida")
+    if uso == "selecionada" and obj["estado"] == "revogada":
+        raise ValueError("skill revogada: uso impedido")
+    resultado = {"nome": nome, "uso": uso, "estado": obj["estado"]}
+    if uso == "lida" and sha_lido is not None:
+        resultado["mudou_desde_o_hash"] = sha_lido != obj["sha256"]
+    eventos.registrar("observation", uso, f"skill:{nome}", componente="alexandria", classification="project",
+                      chave=f"skill:{nome}:uso:{uso}:{time.monotonic_ns()}", sha256=obj["sha256"])
+    return resultado
+
+
+def gerar_diff_p8(nome: str) -> Path:
+    """Só para `elegivel`: um `.diff` que cria `.agents/skills/<nome>/SKILL.md`, para o fluxo P-8 (não instala)."""
+    obj = ler(nome)
+    if obj is None or obj["estado"] != "elegivel":
+        raise ValueError("só uma skill elegível gera o diff para o P-8")
+    fonte = eventos.dados() / "alexandria" / "skills" / "rascunho" / nome / "SKILL.md"
+    if not fonte.exists():
+        raise ValueError("rascunho não encontrado")
+    linhas = fonte.read_text(encoding="utf-8").splitlines(keepends=True)
+    diff = "".join(difflib.unified_diff([], linhas, fromfile="/dev/null", tofile=f"b/.agents/skills/{nome}/SKILL.md"))
