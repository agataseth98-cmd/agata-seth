+def _carrega_servidor():
+    spec = importlib.util.spec_from_file_location("painel_voz_teste", HERE / "server.py")
+    modulo = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(modulo)
+    return modulo
+
+
+panel = _carrega_servidor()
