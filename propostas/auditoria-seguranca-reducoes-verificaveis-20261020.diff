++function takeCapabilityForCall({ callId, alias, serverName, toolName, args, userId, conversationId }) {
++  const key = callKey({ callId, userId, conversationId });
++  if (!key) return null;
++  const entry = pending.get(key);
++  pending.delete(key);
++  if (!entry || entry.alias !== alias || entry.target.server !== serverName || entry.target.tool !== toolName) return null;
