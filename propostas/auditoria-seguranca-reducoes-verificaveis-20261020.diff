++function callKey({ callId, userId, conversationId }) {
++  if (typeof callId !== 'string' || !callId || typeof userId !== 'string' || !userId ||
++      typeof conversationId !== 'string' || !conversationId) return null;
++  return `${userId}:${conversationId}:${callId}`;
++}
++
++function issue({ callId, alias, userId, conversationId, args, now = Math.floor(Date.now() / 1000) }) {
++  const target = PROTECTED[alias];
++  const key = callKey({ callId, userId, conversationId });
++  if (!target || !key) {
++    throw new Error('invalid protected tool approval');
++  }
++  for (const [id, entry] of pending) {
++    if (entry.exp <= now) pending.delete(id);
++  }
++  if (pending.size >= MAX_PENDING_CAPABILITIES && !pending.has(callId)) {
++    throw new Error('too many pending protected tool approvals');
++  }
++  const claims = {
++    iss: 'librechat-agata',
++    aud: target.audience || target.server,
++    tool: target.tool,
++    sub: userId,
++    conversation_id: conversationId,
++    args_sha256: argsDigest(args),
++    iat: now,
++    exp: now + MAX_TTL_SECONDS,
++    jti: randomUUID(),
++  };
++  const encoded = Buffer.from(canonical(claims), 'utf8').toString('base64url');
++  const signature = sign(null, Buffer.from(encoded, 'ascii'), readPrivateKey()).toString('base64url');
