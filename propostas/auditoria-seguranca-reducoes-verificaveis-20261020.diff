++  const byId = new Map(resolutions.map((r) => [r.tool_call_id, r]));
++  for (const request of payload.action_requests) {
++    const alias = request.name;
++    if (!PROTECTED[alias]) continue;
++    const key = callKey({ callId: request.tool_call_id, userId, conversationId });
++    if (!key) continue;
++    pending.delete(key);
++    const resolution = byId.get(request.tool_call_id);
++    if (!resolution || !['approve', 'edit'].includes(resolution.decision)) continue;
++    const args = resolution.decision === 'edit' ? resolution.editedArguments : request.arguments;
++    if (typeof args === 'string') {
