++const {
++  createHash,
++  createPrivateKey,
++  sign,
++  randomUUID,
++} = require('crypto');
++const fs = require('fs');
++
++const MAX_TTL_SECONDS = 60;
++const MAX_PENDING_CAPABILITIES = 2048;
++const PRIVATE_KEY_FILE = process.env.AGATA_APPROVAL_PRIVATE_PEM_PATH || '/run/secrets/agata-approval-private.pem';
++const pending = new Map();
++
++// Exact aliases generated by LibreChat's MCP normalizer. Unknown aliases never
++// receive a capability. Read-only tools do not use this table.
++const PROTECTED = Object.freeze({
++  memoria_acrescentar_mcp_canon: { server: 'canon', audience: 'escriba', tool: 'memoria_acrescentar' },
++  diario_anotar_mcp_canon: { server: 'canon', audience: 'escriba', tool: 'diario_anotar' },
++  clicar_mcp_navegador: { server: 'navegador', tool: 'clicar' },
++  preencher_mcp_navegador: { server: 'navegador', tool: 'preencher' },
++  enviar_mensagem_mcp_discord: { server: 'discord', tool: 'enviar_mensagem' },
++});
++
++function canonical(value) {
++  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
++  if (value && typeof value === 'object') {
++    return `{${Object.keys(value).sort().map((k) => `${JSON.stringify(k)}:${canonical(value[k])}`).join(',')}}`;
++  }
++  return JSON.stringify(value);
++}
++
++function argsDigest(args) {
++  return createHash('sha256').update(canonical(args), 'utf8').digest('hex');
++}
++
++function privateKeyStatIsSecure(st, expectedGid) {
++  return st.isFile() && st.uid === 0 && st.nlink === 1 &&
++    st.gid === expectedGid && (st.mode & 0o777) === 0o440;
++}
++
++function readPrivateKey() {
++  const fd = fs.openSync(PRIVATE_KEY_FILE, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW || 0));
++  try {
++    const st = fs.fstatSync(fd);
++    if (!privateKeyStatIsSecure(st, process.getgid())) {
++      throw new Error('insecure capability private key file');
++    }
++    const key = fs.readFileSync(fd);
++    if (key.length < 64 || key.length > 4096) throw new Error('invalid capability private key length');
++    return createPrivateKey(key);
++  } finally {
++    fs.closeSync(fd);
++  }
++}
