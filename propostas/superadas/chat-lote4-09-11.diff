 /* Campos da conversa no mesmo tema escuro dos demais (tokens de :root: paper, line, ink, teal). Sem branco do navegador. */
 .seth-modelo select,.seth-form textarea{padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);font:13px/1.5 var(--sans)}
-.seth-modelo select{padding:4px 8px;color-scheme:dark}
+.seth-modelo select{padding:4px 8px}
 .seth-modelo select option{background:var(--sheet);color:var(--ink)}
 .seth-form textarea::placeholder{color:var(--muted);opacity:.75}
 .seth-modelo select:focus,.seth-form textarea:focus{outline:2px solid var(--teal);outline-offset:1px}
@@ -1801,3 +2379,32 @@ dialog .dialog-actions{padding-top:12px;justify-content:flex-end}
 .memoria-filtro select:focus{outline:2px solid var(--teal);outline-offset:1px}
 .oc-cabecalho{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;flex-wrap:wrap;margin:0 0 18px}
 .oc-cabecalho .oc-lede{margin:6px 0 0}
+
+/* Lote 4 da Conversa (09/11/2026): ramos, parar, continuar, feedback, contexto, atalhos e tema. Só tokens do :root. */
+.seth-ramo{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);margin-top:6px}
+.seth-ramo button{border:1px solid var(--line);background:transparent;color:var(--ink);border-radius:8px;padding:1px 9px;cursor:pointer;font:inherit}
+.seth-ramo button:disabled{opacity:.4;cursor:default}
+.seth-continuacao{margin:10px 0 6px;font:10px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-top:1px dashed var(--line);padding-top:6px}
+.seth-selo-interrompida{border-color:var(--rose);color:var(--rose)}
+.msg-interrompida,.msg-continuacao{border-style:dashed}
+.msg-rodape{display:flex;flex-direction:column;gap:6px}
+.seth-feedback{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px}
+.seth-feedback-botoes{display:flex;gap:6px}
+.seth-feedback-botoes button{border:1px solid var(--line);background:transparent;border-radius:8px;padding:1px 7px;cursor:pointer;font-size:13px}
+.seth-feedback-botoes button[aria-pressed="true"]{border-color:var(--teal);background:var(--teal-soft);color:var(--teal)}
+.seth-motivo{flex:1;min-width:160px;font:inherit;font-size:12px;padding:4px 8px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--ink)}
+.msg-editar{width:100%;min-height:72px;font:inherit;padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--sheet);color:var(--ink);resize:vertical}
+.seth-contexto-bloco{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
+.seth-contexto{margin:0;line-height:1.45}
+.seth-contexto-barra{width:100%;height:6px;accent-color:var(--teal)}
+.seth-origem{margin:0;font-size:12px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap;align-items:center}
+.seth-copiado{font-size:12px;color:var(--teal)}
+.ajustes{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);flex-wrap:wrap}
+.tema-seletor{font-size:12px}
+.ajustes select{font:inherit;font-size:12px;padding:4px 8px;border-radius:8px;border:1px solid var(--line);background:var(--sheet);color:var(--ink)}
+.atalhos{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:var(--veu)}
+.atalhos[hidden]{display:none}
+.atalhos-caixa{background:var(--sheet);border:1px solid var(--line);border-radius:12px;padding:18px 20px;max-width:520px;width:calc(100% - 32px);box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;color:var(--ink)}
+.atalhos-caixa h2{margin:0;font-size:18px}
+.atalhos-lista{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;font-size:13px;line-height:1.45}
+kbd{font:12px var(--mono);border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:0 5px;background:var(--blue-soft);color:var(--ink)}
