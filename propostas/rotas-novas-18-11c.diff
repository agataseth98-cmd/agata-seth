diff --git a/config/ollama-agata-proxy.service b/config/ollama-agata-proxy.service
new file mode 100644
index 00000000..f2295697
--- /dev/null
+++ b/config/ollama-agata-proxy.service
@@ -0,0 +1,14 @@
+[Unit]
+Description=Agata -- proxy do Ollama: encaminha :11434 para o ollama-agata em :11447; sai após 15 min ociosos
+# Ativado só pelo ollama-agata.socket (sem [Install]). Ver laya-roteador-proxy.service: o mesmo desenho.
+# Requires/After: o backend sobe antes deste proxy aceitar a conexão, porque o ExecStartPost do backend só
+# termina quando a porta interna responde HTTP.
+# Cold start: a 1ª chamada depois de ociosidade espera o backend subir (o socket segura a conexão); o seth_gateway
+# dá a essa rota o prazo de SETH_ROTA_LOCAL_MS (100,5 s) e, se passar, cai na fila de sempre.
+PartOf=agata.target
+Requires=ollama-agata.service
+After=ollama-agata.service
+
+[Service]
+Type=simple
+ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=15min 127.0.0.1:11447
diff --git a/config/ollama-agata.service b/config/ollama-agata.service
new file mode 100644
index 00000000..436db07b
--- /dev/null
+++ b/config/ollama-agata.service
@@ -0,0 +1,42 @@
+# Agata -- Ollama como unit de USUARIO, SOB DEMANDA (18/11/2026, decisão do Humano: "o Ollama não fica ligado
+# junto com o sistema, é sob demanda, como o Laya e o Ollaya"). Só loopback. Porta pública :11434
+# (ollama-agata.socket); esta unit escuta só em :11447 (interna, OLLAMA_HOST). Sobe com a 1ª conexão ao socket
+# (pelo proxy) e cai quando o proxy sai, após 15 min sem conexão (StopWhenUnneeded). Sem [Install]: quem fica
+# no agata.target é o socket. Substitui o ollama.service do sistema (User=ollama, exige sudo), que deve ficar
+# desabilitado: o socket precisa da porta 11434. Os modelos ficam em %h/.local/share/ollama/models.
+# Instala com links, como as outras: ln -sf ~/agata/config/ollama-agata.{socket,service} (e -proxy.service)
+# ~/.config/systemd/user/ (README de redesign/systemd). Variáveis de hardware = as do override atual da
+# Máquina (RTX 4060 8 GB); em outro clone, ajustar.
+[Unit]
+Description=Ollama (Agata, usuário, sob demanda, porta interna :11447)
+Documentation=file:///home/orusoua/agata/redesign/router/rotas_locais.py
+PartOf=agata.target
+StopWhenUnneeded=yes
+
+[Service]
+Type=simple
+# 90 s > 60 s do prazo do ExecStartPost: o systemd não corta o probe antes do próprio prazo.
+TimeoutStartSec=90
+ExecStart=/usr/local/bin/ollama serve
+Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/cuda/bin
+Environment=OLLAMA_HOST=127.0.0.1:11447
+Environment=OLLAMA_MODELS=%h/.local/share/ollama/models
+Environment=OLLAMA_NUM_GPU=999
+Environment=OLLAMA_KV_CACHE_TYPE=q4_0
+Environment=OLLAMA_FLASH_ATTENTION=1
+Environment=CUDA_VISIBLE_DEVICES=0
+ExecStartPre=+/usr/bin/mkdir -p %h/.local/share/ollama/models
+# Só aceita o proxy depois de a porta interna responder HTTP (o Ollama responde 200 em /): sem isto o
+# systemd-socket-proxyd conecta antes de o servidor escutar. Prazo global de 60 s; passou disso, falha.
+ExecStartPost=/usr/bin/timeout 60 /usr/bin/bash -c 'until /usr/bin/curl -s -m 2 --noproxy 127.0.0.1 -o /dev/null http://127.0.0.1:11447/; do sleep 0.5; done'
+Restart=on-failure
+RestartSec=15
+Nice=5
+NoNewPrivileges=yes
+PrivateTmp=yes
+ProtectSystem=strict
+ProtectKernelTunables=yes
+ProtectControlGroups=yes
+RestrictSUIDSGID=yes
+ReadWritePaths=-%h/.local/share/ollama
+ReadWritePaths=-%h/.ollama
diff --git a/config/ollama-agata.socket b/config/ollama-agata.socket
new file mode 100644
index 00000000..106fd90a
--- /dev/null
+++ b/config/ollama-agata.socket
@@ -0,0 +1,18 @@
+[Unit]
+Description=Agata -- porta pública do Ollama (:11434, só loopback); acorda o ollama-agata sob demanda
+# Sob demanda (decisão do Humano, 18/11/2026: o Ollama sobe quando é preciso e cai após um tempo seguro, como
+# o Laya e o Ollaya; padrão de laya-roteador.socket). Este socket fica de pé com o agata.target e recebe as
+# chamadas em 127.0.0.1:11434 (quem fala com o Ollama continua usando essa porta). A 1ª conexão sobe
+# ollama-agata-proxy.service, que sobe o ollama-agata.service (porta interna :11447). Sem conexão por 15 min,
+# o proxy sai e o backend cai junto (StopWhenUnneeded), liberando a VRAM. Quem fica no agata.target é este
+# arquivo, não o backend.
+# ANTES de instalar: o ollama.service do SISTEMA (User=ollama) escuta em :11434 e precisa estar parado e
+# desabilitado, senão o socket não consegue a porta (procedimento em redesign/systemd/README.md).
+PartOf=agata.target
+
+[Socket]
+ListenStream=127.0.0.1:11434
+Service=ollama-agata-proxy.service
+
+[Install]
+WantedBy=agata.target
