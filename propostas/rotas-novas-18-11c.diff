+
+
+@pytest.mark.parametrize("conteudo", [None, "isto nao e json\n{{{\n", b"\xff\xfe\x00lixo"])
+def test_painel_ausente_ou_ilegivel_nao_restringe(ficha, tmp_path, conteudo):
