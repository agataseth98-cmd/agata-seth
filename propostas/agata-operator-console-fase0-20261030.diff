+<!doctype html>
+<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Agata · Operator Console</title><link rel="stylesheet" href="style.css"></head>
+<body><main class="shell"><header><div><p class="eyebrow">AGATA / EVIDENCE SURFACE</p><h1>Operator Console</h1><p class="lede">Uma janela para o que foi medido — nunca uma nova fonte de verdade.</p></div><label class="load">Abrir pacote<input id="package" type="file" webkitdirectory directory multiple></label></header>
+<section class="hero"><div><span class="status-dot"></span><span id="state">SEM PACOTE CARREGADO</span><p id="summary">Selecione um diretório contendo bootstrap.md, capabilities.md, provenance.json e artefatos do Review Mesh.</p></div><div class="stamp"><span>FRESCOR</span><strong id="freshness">—</strong></div></section>
+<nav class="tabs"><button class="active" data-tab="overview">Visão</button><button data-tab="capabilities">Capacidades</button><button data-tab="reviews">Revisões</button><button data-tab="drift">Drift</button></nav>
+<section id="overview" class="panel active"><div class="cards"><article><small>ARQUIVOS</small><strong id="files">—</strong><span>proveniência lida</span></article><article><small>INTEGRIDADE</small><strong id="integrity">—</strong><span>verificação local</span></article><article><small>DECISÕES</small><strong id="decisions">não medido</strong><span>sem autoridade automática</span></article></div><div class="source"><span>FONTE ATUAL</span><code id="source">nenhuma</code></div></section>
+<section id="capabilities" class="panel"><h2>Capacidades</h2><div id="capability-list" class="list"><p class="empty">Ainda não medido.</p></div></section>
+<section id="reviews" class="panel"><h2>Revisões independentes</h2><div id="review-list" class="list"><p class="empty">Ainda não medido.</p></div></section>
+<section id="drift" class="panel"><h2>Drift</h2><pre id="drift-text">Ainda não medido.</pre></section>
+</main><script src="app.js"></script></body></html>
