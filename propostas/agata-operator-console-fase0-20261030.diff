+@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');
+:root{--ink:#e9f0ed;--muted:#91a29d;--bg:#0a1110;--card:#111c19;--line:#29403a;--lime:#d9f36a;--orange:#ff9b58}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 85% 0,#203b31 0,transparent 35%),var(--bg);color:var(--ink);font:15px Manrope, sans-serif;min-height:100vh}.shell{max-width:1180px;margin:auto;padding:48px 28px 80px}header{display:flex;justify-content:space-between;gap:30px;align-items:end}h1{font-size:clamp(42px,7vw,86px);letter-spacing:-.07em;line-height:.9;margin:10px 0 18px}.eyebrow,small,.stamp span,.source span{font:500 11px 'DM Mono',monospace;letter-spacing:.14em;color:var(--lime)}.lede{color:var(--muted);max-width:460px}.load{border:1px solid var(--lime);color:var(--lime);padding:13px 16px;cursor:pointer;font:500 12px 'DM Mono';white-space:nowrap}.load input{display:none}.hero{margin:60px 0 28px;padding:22px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:24px}.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--orange);margin-right:9px}.hero p{color:var(--muted);max-width:650px;line-height:1.6}.stamp{text-align:right}.stamp strong{display:block;font:500 22px 'DM Mono';margin-top:10px}.tabs{display:flex;gap:4px;border-bottom:1px solid var(--line);margin-bottom:26px}.tabs button{background:none;color:var(--muted);border:0;padding:13px 16px;cursor:pointer;font:500 12px 'DM Mono'}.tabs button.active{color:var(--ink);border-bottom:2px solid var(--lime)}.panel{display:none}.panel.active{display:block}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.cards article{background:var(--card);border:1px solid var(--line);padding:22px;min-height:120px}.cards strong{display:block;font-size:30px;margin:16px 0 7px}.cards span{color:var(--muted);font-size:12px}.source{margin-top:14px;padding:16px;border-left:2px solid var(--lime);background:#0e1815}.source code,pre{font:13px 'DM Mono';color:var(--muted);display:block;margin-top:9px;white-space:pre-wrap}.list{display:grid;gap:8px}.list p,.list article{padding:15px;background:var(--card);border:1px solid var(--line)}.empty{color:var(--muted)}h2{letter-spacing:-.04em;font-size:28px}pre{background:var(--card);border:1px solid var(--line);padding:20px;min-height:180px}@media(max-width:700px){header,.hero{display:block}.load{display:inline-block;margin-top:20px}.stamp{text-align:left;margin-top:25px}.cards{grid-template-columns:1fr}}
