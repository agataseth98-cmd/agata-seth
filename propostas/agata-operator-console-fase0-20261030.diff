+# Operator Console — protótipo read-only
+
+Abra `index.html` localmente e selecione o diretório de um pacote Project Kit. A tela não faz rede, não executa comandos, não escreve artefatos e não aprova ações.
diff --git a/redesign/operator_console/app.js b/redesign/operator_console/app.js
new file mode 100644
index 00000000..e638e752
--- /dev/null
+++ b/redesign/operator_console/app.js
@@ -0,0 +1,2 @@
+const $=s=>document.querySelector(s);const tabs=[...document.querySelectorAll('.tabs button')];tabs.forEach(b=>b.onclick=()=>{tabs.forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('#'+b.dataset.tab).classList.add('active')});
+const read=async f=>f?await f.text():'';$('#package').onchange=async e=>{const fs=[...e.target.files];const by=n=>fs.find(f=>f.webkitRelativePath.endsWith('/'+n)||f.name===n);const prov=by('provenance.json');if(!prov){$('#state').textContent='PACOTE INVÁLIDO';$('#summary').textContent='provenance.json não encontrado.';return}let data;try{data=JSON.parse(await read(prov))}catch{ $('#state').textContent='INTEGRIDADE NÃO MEDIDA';return}$('#state').textContent='PACOTE CARREGADO';$('#summary').textContent=`Objetivo: ${data.goal||'não informado'} · raiz: ${data.root||'não medida'}`;$('#files').textContent=(data.files||[]).length;$('#integrity').textContent='não medido';$('#source').textContent=prov.webkitRelativePath||prov.name;$('#freshness').textContent=data.generated_at||'não medido';const caps=by('capabilities.md');if(caps)$('#capability-list').innerHTML='<article>'+((await read(caps)).replaceAll('\n','<br>'))+'</article>';const drift=by('drift-report.md');if(drift)$('#drift-text').textContent=await read(drift);const reviews=fs.filter(f=>f.name==='packet.md');$('#review-list').innerHTML=reviews.length?reviews.map(f=>`<article>${f.webkitRelativePath}</article>`).join(''):'<p class="empty">Não medido.</p>'};
