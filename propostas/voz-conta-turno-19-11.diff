+    def test_uma_fala_entregue_avanca_uma_vez_e_leva_o_cabecalho(self):
+        n, vistos = self.rodar()
+        self.assertEqual(len(n), 1)
+        self.assertEqual(vistos, ["agata · t=1"])
+        self.assertTrue(any("t=1" in l for l in self.out))
