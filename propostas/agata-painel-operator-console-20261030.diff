+<section id="capabilities" class="panel"><h2>Capacidades</h2><div id="capability-list" class="list"><p class="empty">Ainda não medido.</p></div></section>
+<section id="reviews" class="panel"><h2>Revisões independentes</h2><div id="review-list" class="list"><p class="empty">Ainda não medido.</p></div></section>
+<section id="drift" class="panel"><h2>Drift</h2><pre id="drift-text">Ainda não medido.</pre></section>
+</main><script src="app.js"></script></body></html>
