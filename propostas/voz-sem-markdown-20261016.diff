+def limpar_markdown(texto):
+    """Tira a marcação de markdown antes de falar: a voz lê o texto, não os símbolos (asteriscos, #, crases, pipes)."""
+    import re
+    t = re.sub(r"```.*?```", " ", texto, flags=re.S)            # bloco de código não se lê
+    t = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", t)             # [texto](url) -> texto
+    t = re.sub(r"https?://\S+", " ", t)                           # URL solta não se lê
+    t = re.sub(r"(?m)^\s{0,3}#{1,6}\s*", "", t)                   # títulos
+    t = re.sub(r"(?m)^\s*>+\s?", "", t)                           # citação
+    t = re.sub(r"(?m)^\s*([-*+]|\d+[.)])\s+", "", t)             # marcador de lista
+    t = re.sub(r"(?m)^\s*[-=_*]{3,}\s*$", " ", t)                 # régua horizontal
+    t = re.sub(r"(?m)^\s*\|?[\s:|-]+\|[\s:|-]*$", " ", t)       # linha separadora de tabela
+    t = t.replace("|", ", ")                                       # célula de tabela vira pausa
+    t = re.sub(r"(\*{1,3}|_{2,3})(?=\S)(.+?)(?<=\S)\1", r"\2", t, flags=re.S)  # negrito e itálico
+    t = re.sub(r"(?<!\w)_(?=\S)(.+?)(?<=\S)_(?!\w)", r"\1", t)  # _itálico_ (não mexe em snake_case)
+    t = t.replace("*", "").replace("`", "").replace("~~", "")      # sobras
+    t = re.sub(r"[ \t]+", " ", t)
+    t = re.sub(r"\n{3,}", "\n\n", t)
+    return t.strip()
+
