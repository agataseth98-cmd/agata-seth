diff --git a/scripts/varredura_segredo.sh b/scripts/varredura_segredo.sh
index 0fa1910..8373b0f 100755
--- a/scripts/varredura_segredo.sh
+++ b/scripts/varredura_segredo.sh
@@ -137,6 +137,20 @@ checar_segredo() {
   local arquivo diff_arquivo p linhas
   while IFS= read -r arquivo; do
     [ -z "$arquivo" ] && continue
+    # propostas/*.diff (e propostas/aplicadas/*.diff) ficam fora do escopo
+    # por linha (achado 26/09/2026, laboratório "Ensaio" medindo pra Fase 3):
+    # um .diff é, por natureza, texto que reproduz linha removida/adicionada
+    # do arquivo real -- uma proposta que CORRIGE um falso positivo do P-1
+    # (ex: encurtar um placeholder tipo "KEY: <24 chars>") necessariamente
+    # mostra a linha antiga no hunk, e o .diff inteiro entra como "adicionado"
+    # por ser arquivo novo em propostas/ -- bloqueando pra sempre a própria
+    # proposta que conserta o achado. Não é buraco: o arquivo REAL (aqui,
+    # redesign/router/goose.md) continua escaneado normalmente quando staged
+    # -- antes de virar proposta, e de novo quando a proposta é aplicada --,
+    # que é a defesa de verdade. O .diff em si é só o formato do processo P-8.
+    case "$arquivo" in
+      propostas/*.diff|propostas/aplicadas/*.diff) continue ;;
+    esac
     diff_arquivo="$(git diff --cached -U0 -- "$arquivo")"
     for p in "${PADROES_SEGREDO[@]}"; do
       linhas="$(echo "$diff_arquivo" | grep -nE '^\+' | grep -vE '^\+\+\+' | grep -E -- "$p")"
