+"""Testes da unit de usuário do Ollama (18/11/2026): presa ao agata.target como as outras, bind só local, modelos
+no diretório do usuário, sem User= e sem sudo; seth e seth-parar sobem e descem a unit. Só lê arquivos.
+Rodar: pytest -q redesign/router/test_unit_ollama.py
+"""
+import configparser
+from pathlib import Path
+
+SYSTEMD = Path(__file__).resolve().parents[1] / "systemd"
+UNIT = SYSTEMD / "ollama-agata.service"
+
+
+def _ler():
+    cp = configparser.ConfigParser(strict=False, interpolation=None)
+    cp.optionxform = str
+    # Environment= repetido: configparser (strict=False) guarda a última; as linhas cruas são conferidas à parte
+    cp.read_string(UNIT.read_text(encoding="utf-8"))
+    return cp
+
+
+def test_presa_ao_target_como_as_outras():
+    cp = _ler()
+    assert cp["Unit"]["PartOf"] == "agata.target"
+    assert cp["Install"]["WantedBy"] == "agata.target"
+    outra = (SYSTEMD / "piper-tts.service").read_text(encoding="utf-8")
+    assert "PartOf=agata.target" in outra and "WantedBy=agata.target" in outra
+
+
+def test_exec_bind_e_modelos_do_usuario():
+    texto = UNIT.read_text(encoding="utf-8")
+    assert _ler()["Service"]["ExecStart"] == "/usr/local/bin/ollama serve"
+    assert "Environment=OLLAMA_HOST=127.0.0.1:11434" in texto
+    assert "0.0.0.0" not in texto
+    assert "Environment=OLLAMA_MODELS=%h/.local/share/ollama/models" in texto
+    assert "ReadWritePaths=-%h/.local/share/ollama" in texto  # "-": não falha se o diretório ainda não existe
+    ativas = [l.strip() for l in texto.splitlines() if l.strip() and not l.lstrip().startswith("#")]
+    path = [l for l in ativas if l.startswith("Environment=PATH=")]
+    assert len(path) == 1 and "/opt/cuda/bin" in path[0].split(":") and "/usr/local/bin" in path[0]
+    assert "ReadWritePaths=-%h/.ollama" in ativas  # ollama grava a chave em ~/.ollama
+
+
+def test_unit_de_usuario_sem_user_nem_sudo():
+    ativas = "\n".join(l for l in UNIT.read_text(encoding="utf-8").splitlines() if not l.lstrip().startswith("#"))
+    assert "User=" not in ativas and "sudo" not in ativas  # só as linhas ativas; os comentários explicam
+    assert "default.target" not in ativas  # sobe pelo agata.target, não solto no boot
+
+
+def test_seth_sobe_e_seth_parar_desce():
+    assert "systemctl --user start ollama-agata.service" in (SYSTEMD / "seth").read_text(encoding="utf-8")
+    parar = (SYSTEMD / "seth-parar").read_text(encoding="utf-8")
+    assert "systemctl --user stop ollama-agata.service" in parar
+    # os modelos são descarregados (ollama stop) ANTES de a unit descer
+    assert parar.index('ollama stop "$_m"') < parar.index("systemctl --user stop ollama-agata.service")
+
+
+def test_readme_documenta_a_migracao():
+    r = (SYSTEMD / "README.md").read_text(encoding="utf-8")
+    assert "ollama-agata.service" in r and "disable --now ollama.service" in r and "ollama rm" not in r
