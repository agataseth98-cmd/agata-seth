+/* (28/10/2026) Conversa com a Seth: falas separadas, quebras de linha preservadas, notas de verificação discretas. */
+.seth-log{min-height:220px;max-height:55vh;overflow:auto;display:flex;flex-direction:column;gap:12px;padding:6px 2px}
