+def _vereditos_servico(r: str) -> set:
+    """Afirmações de estado num texto já normalizado: "nex" (não existe), "ativa", "inativa".
+    Negação só vale colada ao termo ("não está ativa", "não existe"); "sem falha" não conta (AC-47)."""
+    ditos = set()
+    if re.search(r"(nao existe|inexistente|not-found|nao encontrad)", r):
+        ditos.add("nex")
+    for m in re.finditer(r"\b(in)?(?:ativ[oa]s?|active)\b|\brodando\b", r):
+        antes = r[max(0, m.start() - 16):m.start()]
+        neg = bool(m.group(1)) or re.search(r"\bnao( esta| estao| e| fica)?\s*$", antes) is not None
+        ditos.add("inativa" if neg else "ativa")
+    return ditos
+
