     return None
 
 
+_ESTADOS_IS_ACTIVE = ("active", "inactive", "failed", "activating", "deactivating", "reloading")
+_VEREDITOS = {"ativa": "ativa", "ativo": "ativa", "inativa": "inativa", "inativo": "inativa", "nao existe": "nao existe"}
+
