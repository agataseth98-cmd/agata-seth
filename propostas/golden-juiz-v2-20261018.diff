+def _resposta_fechada(corpo: str, permitidos):
+    """A última linha não vazia, normalizada, sem rótulo "X:" na frente, sem parênteses e sem pontuação final.
+    Com `permitidos` (dict sinônimo -> canônico): devolve o canônico ou "" se a linha não for exatamente um deles.
+    Sem `permitidos`: devolve a linha limpa (AC-47, 18/10/2026: formato fechado em vez de interpretar texto livre)."""
+    linhas = [l for l in (_n(x) for x in corpo.splitlines()) if l and l not in ("pronto.", "pronto")]
+    if not linhas:
+        return ""
+    s = re.sub(r"\([^)]*\)", "", linhas[-1])
+    s = re.sub(r"^[^:]{1,60}:\s*", "", s)  # rótulo: "revisor:", "codex.service:"
+    s = s.strip().strip(".!;,\"'“”").strip()
+    if permitidos is None:
+        return s
+    return permitidos.get(s, "")
+
+
