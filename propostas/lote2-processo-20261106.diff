+    if (pendente.trim()) tratarBloco(pendente);
+    if (!fim) throw sethErroStream("stream interrompido");
+    return parcial.texto;
+  } finally {
+    try { await leitor.cancel(); } catch (_) { /* stream já fechado */ }
+  }
