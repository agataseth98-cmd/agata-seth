+      metricsEvent({
+        sessionKey: activeSessionKey,
+        tool: batch.tool,
+        ...targetFacts(entry, batch.data),
+        decision: entry.decision,
+        reason: entry.reason,
+        questions: entry.questions,
+        profile: entry.profile,
