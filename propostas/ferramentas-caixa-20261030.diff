+}
+
+function isMissingOnDisk(resolved) {
+  try {
+    fs.lstatSync(resolved);
+    return false;
+  } catch (error) {
+    return Boolean(error) && error.code === 'ENOENT';
+  }
+}
+
+function isNewFileTarget(filePath, data) {
+  try {
+    const target = resolveTargetPath(filePath, data);
