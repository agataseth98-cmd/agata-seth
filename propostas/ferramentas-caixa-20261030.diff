+
+// --- Bash / PowerShell ---
+
+function gateShell(ctx) {
+  const { toolName, toolInput, rawInput } = ctx;
+  const command = toolInput.command || '';
+  if (isReadOnlyGitIntrospection(command)) {
+    recordDecision('pass', 'readonly-git');
+    return rawInput;
+  }
