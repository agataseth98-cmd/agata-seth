+  // Real hook stdin payloads carry hook_event_name as a JSON field.
+  const hookEvent = String(
+    input?.hook_event_name || env.CLAUDE_HOOK_EVENT_NAME || ''
+  ).trim();
+  if (hookEvent && hookEvent !== 'PostToolUse') {
