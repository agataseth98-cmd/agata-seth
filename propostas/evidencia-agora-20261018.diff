+def _chamadas_do_turno(msgs: list) -> set[str]:
+    """Nomes chamados no turno auditado: entre o penúltimo e o último pedido do usuário."""
+    usuarios = [i for i, m in enumerate(msgs) if isinstance(m, dict) and m.get("role") == "user"]
