-html{scroll-behavior:smooth}
-body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:var(--fs-4);line-height:1.5}
-button,input{font:inherit}
-button,a{-webkit-tap-highlight-color:transparent}
-a{color:inherit}
-.shell{min-height:100vh;display:grid;grid-template-columns:236px minmax(0,1fr)}
-.sidebar{background:var(--raised);color:var(--ink);padding:27px 18px 22px;display:flex;flex-direction:column;gap:24px;position:sticky;top:0;height:100vh;overflow:auto}
-.brand{display:flex;align-items:center;gap:12px;padding:2px 6px 20px;border-bottom:1px solid color-mix(in srgb, var(--ink) 15%, transparent)}
-.brand-mark{width:37px;height:37px;border:1px solid var(--muted);border-radius:50%;display:grid;place-items:center;color:var(--ink-2);font-family:var(--serif);font-size:var(--fs-7)}
-.brand-name{font:var(--fs-7) var(--serif);letter-spacing:.03em}
-.brand-sub{font:var(--fs-1) var(--mono);text-transform:none;letter-spacing:.01em;color:var(--muted);margin-top:2px}
-.nav-label{font:var(--fs-1) var(--mono);text-transform:none;letter-spacing:.01em;color:var(--faint);padding:0 10px;margin:0 0 8px}
-.nav{display:grid;gap:4px}
-.nav button{border:0;background:transparent;color:var(--ink-2);text-align:left;padding:10px 11px;border-radius:var(--r-2);display:flex;align-items:center;gap:12px;cursor:pointer;transition:.18s}
-.nav button:hover{background:color-mix(in srgb, var(--ink) 7%, transparent);color:var(--ink)}
-.nav button[aria-current="page"]{background:var(--line-green);color:var(--ink);box-shadow:inset 3px 0 var(--gold-deep)}
-.nav svg{width:17px;height:17px;opacity:.9;flex:none}
-.side-bottom{margin-top:auto}
-.human-note{padding:14px;border:1px solid color-mix(in srgb, var(--ink) 14%, transparent);border-radius:var(--r-2);color:var(--muted);font-size:var(--fs-2);line-height:1.55}
-.human-note strong{display:block;color:var(--ink);font:var(--fs-5) var(--serif);font-weight:400;margin:0 0 5px}
-.side-foot{padding:0 10px;color:var(--faint);font:var(--fs-1) var(--mono);letter-spacing:.08em}
-main{min-width:0;padding:25px clamp(18px,3vw,48px) 50px;max-width:1600px;width:100%;margin:0 auto;align-self:start}
-.topbar{height:48px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
-.crumb{font:var(--fs-1) var(--mono);color:var(--muted);letter-spacing:.01em;text-transform:none}
-.top-actions{display:flex;align-items:center;gap:10px}
-.snapshot{font:var(--fs-1) var(--mono);color:var(--muted);padding:8px 10px;border:1px solid var(--line);background:color-mix(in srgb, var(--ink) 66%, transparent);border-radius:var(--r-1)}
-.snapshot b{color:var(--teal);font-weight:600}
-.searchbox{display:flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--sheet);padding:7px 10px;border-radius:var(--r-2);width:min(235px,35vw)}
-.searchbox svg{width:15px;color:var(--muted)}
