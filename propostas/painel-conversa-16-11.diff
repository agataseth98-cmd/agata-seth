+/* ===== Títulos, sobrelinha e estados ===== */
+.eyebrow{margin:0 0 10px;font:600 var(--fs-1)/1.4 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--teal)}
+.section-heading{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;margin:60px 0 20px}
+.section-heading h1{font:700 var(--fs-7)/1.25 var(--sans);color:var(--teal)}
+.section-heading p{margin-top:8px;font-size:var(--fs-3);color:var(--muted)}
+.sub>.section-heading:first-child{margin-top:0}
+.estados{margin:0 0 12px}
+.estado{margin:0 0 12px;padding:10px 14px;border:1px solid var(--line);border-radius:var(--r-2);background:var(--sheet);color:var(--muted);font-size:var(--fs-3)}
+.estado[data-estado="erro"]{border-color:var(--rose);color:var(--rose)}
+.vazio,.seth-vazio,td.vazio{padding:22px 16px;text-align:center;color:var(--muted);font-size:var(--fs-3)}
+.footer-note{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;margin-top:20px;padding-top:12px;border-top:1px solid var(--line);font:var(--fs-1)/1.4 var(--sans);color:var(--muted)}
+.no-results{padding:24px;text-align:center;color:var(--muted)}
+.no-results:not(.show){display:none}
+.no-results.show{display:block}
+.secao{position:relative;min-width:0}
+.sub{min-width:0}
+.sub+.sub{margin-top:60px}
+.secao[aria-busy="true"]>.sub{opacity:.72}
+
+/* Pílula de estado: uma definição só (contorno, texto na cor do estado, fundo transparente). Cor sempre com palavra. */
+.chip,.nv-selo,.seth-selo,.marca,.seth-anexo-marca{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:2px 9px;border:1px solid var(--muted);border-radius:var(--r-pill);background:transparent;color:var(--muted);font:600 var(--fs-1)/1.4 var(--sans);letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.chip.active,.nv-selo.ok{color:var(--ok);border-color:var(--ok)}
+.chip.partial,.nv-selo.aviso,.seth-selo-interrompida,.seth-selo-fixada{color:var(--gold);border-color:var(--gold)}
+.chip.erro,.nv-selo.erro{color:var(--rose);border-color:var(--rose)}
+.chip.planned,.seth-selo-marcador{color:var(--violet);border-color:var(--violet)}
+.chip.horizon,.nv-selo.neutro,.seth-selo-arquivada{color:var(--muted);border-color:var(--line)}
+.chip.ausente{color:var(--muted);border-style:dashed;border-color:var(--muted)}
+.seth-selo-pasta{color:var(--blue);border-color:var(--blue)}
+.dot{display:inline-block;width:8px;height:8px;flex:none;border-radius:50%;background:var(--teal)}
+.dot.off{background:var(--muted)}
+
+/* ===== Herói do Panorama: cabeçalho de página, sem retrato. Resultado em uma frase; Git ao lado. ===== */
+.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,340px);gap:20px;align-items:end;margin:0 0 20px}
+.hero h1{font:700 var(--fs-9)/1.1 var(--sans);letter-spacing:-.02em;color:var(--ink);margin:0 0 10px}
+.hero h1 em{color:var(--teal);font-style:normal}
+.hero p{margin-top:10px;color:var(--muted)}
+.hero-line{display:block;font:600 var(--fs-4)/1.5 var(--sans);color:var(--ink)}
+.hero-stamp{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:16px 18px;border:1px solid var(--line);border-radius:var(--r-3);background:var(--sheet);font-size:var(--fs-3);color:var(--muted)}
+.hero-stamp strong{font:700 var(--fs-5)/1.3 var(--sans);color:var(--ink)}
+.stamp-row{display:flex;align-items:center;gap:8px;font:var(--fs-1)/1.4 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
+.hero-stamp p,.hero-stamp div{margin:0;max-width:none}
+
+/* Faixa de resultado (conclusão): uma frase com a fonte; borda com o acento à esquerda. */
+.callout{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin:0 0 16px;padding:12px 16px;border:1px solid var(--line);border-left:3px solid var(--teal);border-radius:var(--r-3);background:var(--sheet);font-size:var(--fs-3);color:var(--ink)}
+.callout svg{width:18px;height:18px;flex:none;color:var(--teal)}
+.callout .right{margin-left:auto;font:600 var(--fs-1)/1.4 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
+
+/* Mosaico de medida: rótulo em maiúsculas, número 30px tabular, uma frase. */
+.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 20px}
+.kpi{position:relative;min-width:0;padding:16px 18px;border:1px solid var(--line);border-radius:var(--r-3);background:var(--sheet)}
+.kpi .label{font:600 var(--fs-1)/1.4 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
+.kpi .value{margin:8px 0 6px;font:700 var(--fs-8)/1.1 var(--sans);font-variant-numeric:tabular-nums;color:var(--ink);overflow-wrap:anywhere}
+.kpi .note{font-size:var(--fs-3);line-height:1.5;color:var(--muted)}
+.nv-page .kpi .value{font-size:var(--fs-7)}
+
+/* ===== Cartões, grades e listas ===== */
+.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:12px;align-items:start;margin:0 0 20px}
+.grid>.panel{margin:0}
+.panel{min-width:0;padding:16px 18px;overflow-x:auto;border:1px solid var(--line);border-radius:var(--r-3);background:var(--sheet)}
+.panel+.panel{margin-top:12px}
+.grid>.panel+.panel{margin-top:0}
+.mt14{margin-top:12px}
+.panel-head{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:8px 12px;margin:0 0 12px}
+.panel-kicker{margin:0 0 4px;font:600 var(--fs-1)/1.4 var(--sans);letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
+.panel-title{font:700 var(--fs-4)/1.35 var(--sans);color:var(--ink)}
+.subnote{margin-top:12px;padding-top:10px;border-top:1px solid var(--line);font-size:var(--fs-2);color:var(--muted)}
+.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:12px}
+.cap-card{display:flex;flex-direction:column;gap:8px;min-width:0;min-height:150px;padding:16px 18px;border:1px solid var(--line);border-radius:var(--r-3);background:var(--sheet)}
+.cap-card[hidden]{display:none}
+.cap-card[data-state="planned"],.cap-card[data-state="horizon"]{border-style:dashed}
 .cap-card[data-probe]:not([data-probe='documento']){cursor:pointer}
-.cap-card[data-probe]:not([data-probe='documento']):focus-visible{outline:2px solid var(--teal);outline-offset:3px}
