-*::-webkit-scrollbar-thumb{background:color-mix(in srgb, var(--teal) 28%, transparent);border-radius:var(--r-2)}
-*::-webkit-scrollbar-thumb:hover{background:color-mix(in srgb, var(--teal) 50%, transparent)}
